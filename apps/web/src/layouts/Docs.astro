---
import "../styles/docs.css";
import Base from "./Base.astro";
import DocsNav from "../components/DocsNav.astro";
import FrameworkChips from "../components/FrameworkChips.astro";
import Prose from "../components/Prose.astro";
import { crumbsFor } from "../data/docs-catalog";

interface Props {
  title: string;
  description: string;
  lede?: string;
  href: string;
}

const { title, description, lede, href } = Astro.props;
const crumbs = crumbsFor(href);
---

<Base tone="light" title={title} description={description}>
  <script slot="head" is:inline>
    try {
      var stored = localStorage.getItem("ck-docs-rail-width");
      if (stored && /^\d{2,4}$/.test(stored) && matchMedia("(min-width: 1101px)").matches) {
        var n = Number(stored);
        var max = Math.max(260, Math.round(window.innerWidth - 248 - 56 - 320));
        if (n >= 220 && n <= 9999) {
          document.documentElement.style.setProperty("--docs-rail-width", Math.min(max, Math.max(260, n)) + "px");
        }
      }
    } catch (e) {}
  </script>
  <div class="docs-frame">
    <DocsNav />
    <article class="docs-main">
      <div class="docs-top">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          {
            crumbs.map((crumb, index) => (
              <>
                {index > 0 ? <span class="breadcrumb__sep" aria-hidden="true">/</span> : null}
                {index === crumbs.length - 1 || !crumb.href ? (
                  <span class={index === crumbs.length - 1 ? "breadcrumb__current" : undefined}>{crumb.label}</span>
                ) : (
                  <a href={crumb.href}>{crumb.label}</a>
                )}
              </>
            ))
          }
        </nav>
        <FrameworkChips />
      </div>
      <h1>{title}</h1>
      {lede ? <p class="lede"><Prose text={lede} /></p> : null}
      <slot />
    </article>
    <aside class="docs-rail" id="docs-rail" aria-label="Response">
      <div
        class="docs-splitter"
        id="docs-rail-split"
        role="separator"
        aria-orientation="vertical"
        aria-label="Resize response column"
        aria-controls="docs-rail"
        aria-valuemin="260"
        aria-valuemax="9999"
        aria-valuenow="380"
        tabindex="0"
      ></div>
      <slot name="rail" />
    </aside>
  </div>
</Base>

<script>
  import { mountDocsSplit } from "../scripts/docs-split";

  mountDocsSplit();
</script>
