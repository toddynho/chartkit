---
import StackSample from "./StackSample.astro";
import { chartPage } from "../data/docs-catalog";

interface Props {
  type: string;
  label: string;
  spec: string;
}

const { type, label, spec } = Astro.props;
const chart = chartPage(type);
const geo = type === "choropleth" || type === "map-points";
const facts = geo
  ? [
      { k: "Import", v: "@chartkitdev/geo" },
      { k: "Bundle", v: "@chartkitdev/geo" },
    ]
  : chart.facts;
const family = geo ? "Geo" : chart.family;
---

<figure class="code">
  <figcaption><span>spec.json</span></figcaption>
  <pre><code>{spec}</code></pre>
</figure>
{
  geo ? (
    <p>
      Install <code>@chartkitdev/geo</code>. Maps are not in <code>@chartkitdev/core</code>, and the framework adapters do not draw them. <code>render</code> from the geo package is async. <code>spec</code> is the JSON above.
    </p>
  ) : (
    <p>Install core and the adapter for your framework. The menu in the sidebar picks the snippet. <code>spec</code> is the JSON above.</p>
  )
}
<div class="facts facts--names" aria-label={label}>
  {
    facts.map((fact) => (
      <span class="fact">
        <span class="fact__k">{fact.k}</span>
        <span class="fact__v">{fact.v}</span>
      </span>
    ))
  }
  <span class="fact">
    <span class="fact__k">Family</span>
    <span class="fact__v">{family}</span>
  </span>
</div>
{geo ? null : <StackSample />}
