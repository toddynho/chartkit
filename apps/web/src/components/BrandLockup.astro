---
import markLight from "../../public/brand/mark-light.svg?raw";
import markDark from "../../public/brand/mark-dark.svg?raw";

/**
 * Live lockup: the 32px mark, drawn at 22px, plus Inter 600 “ChartKit”.
 * The wordmark SVGs are preview plates (280×56). They are not the header
 * or footer logo — cropping them clips the kit handle.
 */
function icon(file: string, svg: string): string {
  if (!svg.includes('viewBox="0 0 32 32"')) throw new Error(`Unexpected mark asset in ${file}`);
  return svg.replace("<svg ", '<svg aria-hidden="true" focusable="false" ');
}

const light = icon("mark-light.svg", markLight);
const dark = icon("mark-dark.svg", markDark);
---

<a class="brand" href="/" aria-label="ChartKit home">
  <span class="brand__mark brand__mark--light" set:html={light} />
  <span class="brand__mark brand__mark--dark" set:html={dark} />
  <span class="brand__word">ChartKit</span>
</a>
