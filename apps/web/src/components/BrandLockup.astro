---
import logo from "../../public/brand/logo.svg?raw";

interface Props {
  /** Header mark is 28px so the kit reads a little taller than the 17px word. Footer stays 22. */
  size?: 28 | 22;
  tag?: string;
}

const { size = 28, tag } = Astro.props;
const svg = logo.replace("<svg ", '<svg aria-hidden="true" focusable="false" ');
---

<a class:list={["brand", size === 22 && "brand--footer"]} href="/" aria-label="ChartKit home">
  <span class="brand__mark" style={`width:${size}px;height:${size}px`} set:html={svg} />
  <span class="brand__word">ChartKit</span>
  {tag ? <span class="brand__tag">{tag}</span> : null}
</a>
