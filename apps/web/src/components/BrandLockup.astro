---
import wordmarkLight from "../../public/brand/wordmark-light.svg?raw";
import wordmarkDark from "../../public/brand/wordmark-dark.svg?raw";

/**
 * S5b Mono · R5 lockup. The handoff SVG includes a preview plate
 * (page-colored rounded rect). That plate is not part of the mark,
 * so the header drops it and frames the 22px mark + Inter 600 word.
 */
const plate = /<rect width="280" height="56" rx="10" fill="#[0-9a-fA-F]{6}"\/>/;

function lockup(file: string, svg: string): string {
  if (!plate.test(svg)) throw new Error(`Missing preview plate in ${file}`);
  return svg.replace(plate, "").replace("<svg ", '<svg aria-hidden="true" focusable="false" ');
}

const light = lockup("wordmark-light.svg", wordmarkLight);
const dark = lockup("wordmark-dark.svg", wordmarkDark);
---

<a class="brand" href="/" aria-label="ChartKit home">
  <span class="brand__lockup brand__lockup--light" set:html={light} />
  <span class="brand__lockup brand__lockup--dark" set:html={dark} />
</a>
