---
import { scriptJson } from "../lib/spec-text";

interface Props {
  spec: unknown;
  svg: string;
  alt: string;
  preset?: boolean;
  geo?: boolean;
  /** False keeps the painted SVG. The speed plot's labels are not in the spec. */
  hydrate?: boolean;
  edit?: boolean;
}

const { spec, svg, alt, preset = false, geo = false, hydrate = true, edit = true } = Astro.props;
const live = hydrate && !geo;
const editHref = `/examples#${encodeURIComponent(JSON.stringify(spec))}`;
---

<div class="chart-mount">
  <div
    class:list={["ck-frame", preset && "chart-preset"]}
    data-ck-mount={live ? "" : undefined}
    data-geo={geo ? "" : undefined}
    role="img"
    aria-label={alt}
  >
    {live ? <script is:inline type="application/json" set:html={scriptJson(spec)} /> : null}
    <Fragment set:html={svg} />
  </div>
  {edit ? <a class="chart-edit" href={editHref}>Edit</a> : null}
</div>
