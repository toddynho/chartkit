---
import type { DocArticle } from "../data/docs-catalog";
import { articleHref, articleSpec } from "../data/docs-catalog";
import FieldGrid from "./FieldGrid.astro";
import PageNav from "./PageNav.astro";
import Prose from "./Prose.astro";
import SpecEditor from "./SpecEditor.astro";
import HostNotes from "./HostNotes.astro";
import StackSample from "./StackSample.astro";

interface Props {
  article: DocArticle;
  here: string;
}

const { article, here } = Astro.props;
const canonical = articleHref(article);
---

{
  here !== canonical ? (
    <p class="note">
      This path still works. The docs nav links to <a href={canonical}>{article.title}</a>.
    </p>
  ) : null
}
{
  article.slug === "" ? (
    <>
      <h2>Try it</h2>
      <p>Edit the spec. The panel on the right validates and renders on every keystroke.</p>
    </>
  ) : article.tryIntro ? (
    <p>
      <Prose text={article.tryIntro} />
    </p>
  ) : null
}
<SpecEditor spec={articleSpec} />
{article.slug === "" ? <StackSample heading pill oneLine /> : null}
{article.slug === "" ? <HostNotes /> : null}
{
  article.sections.filter((section) => !(article.slug === "" && section.title === "Install")).map((section) => (
    <section>
      <h2>{section.title}</h2>
      {section.paragraphs.map((paragraph) => (
        <p>
          <Prose text={paragraph} />
        </p>
      ))}
      {section.list.length ? (
        <ul>
          {section.list.map((item) => (
            <li>
              <Prose text={item.replace(/^\d+(?=\S)/, "").replace(/^\d+\s*/, "")} />
            </li>
          ))}
        </ul>
      ) : null}
      {section.title === "A valid spec" ? <FieldGrid /> : null}
      {section.code.map((code) => (
        <figure class="code">
          <pre><code>{code}</code></pre>
        </figure>
      ))}
    </section>
  ))
}
{
  article.slug === "markdown" ? (
    <p>
      <a href="/docs/mermaid">Mermaid or Markdown</a> is the converter: supported chart kinds, the global scripts, and the limits.
    </p>
  ) : null
}
{
  article.slug === "concepts/adapters" ? (
    <ul>
      <li><a href="/docs?framework=react">React</a></li>
      <li><a href="/docs?framework=vue">Vue</a></li>
      <li><a href="/docs?framework=svelte">Svelte</a></li>
      <li><a href="/docs?framework=astro">Astro</a></li>
      <li><a href="/docs?framework=solid">Solid</a></li>
      <li><a href="/docs?framework=qwik">Qwik</a></li>
      <li><a href="/docs?framework=angular">Angular</a></li>
      <li><a href="/docs?framework=vanilla">Vanilla</a></li>
    </ul>
  ) : null
}
<PageNav href={canonical} />
