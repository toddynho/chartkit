---
import DocsPage from "./DocsPage.astro";
import { loadConvert } from "../lib/batch3";

interface Props {
  source: "chartjs" | "recharts" | "echarts";
}

const { source } = Astro.props;
const table = loadConvert().coverage[source];
if (!table) throw new Error(`Missing coverage for ${source}`);

const copy = {
  chartjs: {
    title: "Migrate from Chart.js",
    description: "Turn a Chart.js config into a ChartKit spec. Unsupported options come back as warnings.",
    intro:
      "fromChartJs reads a config object, including new Chart(ctx, config) and a const config = { ... } assignment. v3 options.plugins and options.scales map fully. v2 options.title, options.legend, and scales.xAxes or yAxes map in part and warn.",
    call: `import { fromChartJs } from "@chartkitdev/convert";

const { spec, warnings } = fromChartJs(config);`,
    note: "Radar, polarArea, time-scale adapters, annotation plugins, scriptable options, canvas gradients, and a third y axis warn. A per-point colour array keeps the first colour and warns. A stack id is a stack group: series that share it stack. A stack id used once stays beside the others.",
  },
  recharts: {
    title: "Migrate from Recharts",
    description: "Turn Recharts JSX or props into a ChartKit spec. Unsupported options come back as warnings.",
    intro:
      "fromRecharts reads JSX, or an object with chart, data, and children. LineChart, AreaChart, BarChart, PieChart, ScatterChart, and ComposedChart map. A missing Legend or Tooltip becomes legend: false or tooltip: false, matching Recharts, which draws neither unless you add the component.",
    call: `import { fromRecharts } from "@chartkitdev/convert";

const { spec, warnings } = fromRecharts(jsx);`,
    note: "Pie innerRadius in pixels is divided by 100 and stored as a fraction. That is an approximation. RadialBarChart, Brush, ErrorBar, LabelList, custom shapes, JSX spreads, and unbound identifiers warn. ReferenceLine and ReferenceArea become rule and band annotations.",
  },
  echarts: {
    title: "Migrate from ECharts",
    description: "Turn an ECharts option into a ChartKit spec. Unsupported options come back as warnings.",
    intro:
      "fromECharts reads series, xAxis, yAxis, title, legend, and tooltip. areaStyle becomes an area. A radius array becomes a donut. markLine and markArea become rule and band annotations. smooth becomes curve: monotone.",
    call: `import { fromECharts } from "@chartkitdev/convert";

const { spec, warnings } = fromECharts(option);`,
    note: "A stack name is a stack group. Series that share it stack. A series without one stays unstacked, including a line beside a stacked area. Heatmap, gauge, candlestick, radar, graph, map, visualMap, dataZoom, toolbox, and symbolSize functions warn.",
  },
} as const;

const page = copy[source];
---

<DocsPage title={page.title} description={page.description} href={`/docs/migrate/${source}`}>
  <p>{page.intro}</p>
  <p>
    The spec then runs <code>validate()</code> and <code>repair()</code>. Unmapped keys come back as warnings. <code>@chartkitdev/convert</code> is unpublished and is not in the ChartKit bundles.
  </p>
  <figure class="code"><figcaption>ts</figcaption><pre><code>{page.call}</code></pre></figure>
  <h2>Mapped</h2>
  <ul>
    {table.mapped.map((item) => <li>{item}</li>)}
  </ul>
  <h2>Warned, not mapped</h2>
  <ul>
    {table.unsupported.map((item) => <li>{item}</li>)}
  </ul>
  <p>{page.note}</p>
  <p>
    <a href={`/convert?source=${source}`}>Try this source in the converter</a>. <a href="/docs">Getting started</a> renders one spec next to the charts you already have.
  </p>
</DocsPage>
