---
import {
  specForChart,
  type ChartDoc,
} from "../data/docs-catalog";
import { loadMaps } from "../lib/batch3";
import { loadExample, loadExamplesIndex } from "../lib/surfaces";
import { pretty } from "../lib/spec-text";
import { optionEffect } from "../data/option-effect";
import PageNav from "./PageNav.astro";
import Prose from "./Prose.astro";
import SpecEditor from "./SpecEditor.astro";
import StackSample from "./StackSample.astro";

interface Props {
  chart: ChartDoc;
}

interface ShownExample {
  slug: string;
  title: string;
  blurb: string;
  svg: string;
  alt: string;
  spec: Record<string, unknown>;
}

const { chart } = Astro.props;
const href = `/docs/charts/${chart.type}`;
const spec = specForChart(chart);
const playHref = `/playground#${encodeURIComponent(JSON.stringify(spec))}`;

const examples: ShownExample[] = loadExamplesIndex()
  .examples.filter((example) => example.type === chart.type)
  .map((example) => {
    const file = loadExample(example.slug);
    return { slug: file.slug, title: file.title, blurb: file.blurb, svg: file.svg, alt: file.alt, spec: file.spec };
  });

if (chart.type === "choropleth" || chart.type === "map-points") {
  const maps = loadMaps();
  const cards = chart.type === "choropleth" ? [maps.world, maps.us] : [maps.cities];
  const titles = chart.type === "choropleth" ? ["World choropleth", "United States"] : ["Cities"];
  const slugs = chart.type === "choropleth" ? ["world", "us"] : ["cities"];
  cards.forEach((card, index) => {
    examples.push({
      slug: slugs[index] ?? "map",
      title: titles[index] ?? "Map",
      blurb: card.alt,
      svg: card.svg,
      alt: card.alt,
      spec: card.spec as Record<string, unknown>,
    });
  });
}
---

<div class="facts" aria-label={`${chart.title} facts`}>
  {
    chart.facts.map((fact) => (
      <span class="fact">
        <span class="fact__k">{fact.k}</span>
        {fact.k === "Status" ? (
          <span class:list={["status-pill", fact.v === "drawn" || fact.v === "in the library" ? "is-drawn" : "is-planned"]}>{fact.v}</span>
        ) : (
          <span class="fact__v">{fact.v}</span>
        )}
      </span>
    ))
  }
  <span class="fact">
    <span class="fact__k">Family</span>
    <span class="fact__v">{chart.family}</span>
  </span>
</div>

<p>
  <a href="#examples">Examples</a>
  {" · "}
  <a href={playHref}>Open in playground</a>
</p>

<h2>Spec</h2>
{
  chart.type === "area" ? (
    <p>
      Filled line. The spec <code>type</code> is <code>line</code>, with <code>mark.area</code>.
    </p>
  ) : null
}
<SpecEditor spec={spec} />
<StackSample />

{
  chart.anatomy.length ? (
    <>
      <h2>Anatomy</h2>
      <ol class="anatomy">
        {chart.anatomy.map((item) => (
          <li>
            <Prose text={item.replace(/^\d+(?=\S)/, "").replace(/^\d+\s*/, "")} />
          </li>
        ))}
      </ol>
    </>
  ) : null
}

{
  chart.options.length ? (
    <>
      <h2>Options that apply</h2>
      <table class="opt-table">
        <thead>
          <tr>
            <th>Path</th>
            <th>Role</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          {chart.options.map((option) => (
            <tr>
              <td>
                <Prose text={option.path} />
                {optionEffect(chart.type, option.path.replace(/`/g, "").trim()).status === "not-yet" ? (
                  <span class="not-yet">Not yet on {chart.type}</span>
                ) : null}
              </td>
              <td class="muted">
                <Prose text={option.role} />
              </td>
              <td>
                <span class:list={["status-pill", option.status === "drawn" || option.status === "in the library" ? "is-drawn" : "is-planned"]}>
                  {option.status || "noted"}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ) : null
}

{
  chart.notes.map((section) => (
    <section>
      <h2>{section.title}</h2>
      {section.paragraphs.map((paragraph) => (
        <p>
          <Prose text={paragraph} />
        </p>
      ))}
      {section.list.length ? (
        <ul>
          {section.list.map((item) => (
            <li>
              <Prose text={item} />
            </li>
          ))}
        </ul>
      ) : null}
      {section.code.map((code) => (
        <figure class="code">
          <figcaption>sample</figcaption>
          <pre><code>{code}</code></pre>
        </figure>
      ))}
    </section>
  ))
}

<h2 id="examples">Examples</h2>
{
  chart.type === "area" && examples.length === 0 ? (
    <p>
      A filled line is <code>type: "line"</code> with <code>mark.area</code>. Worked examples are on{" "}
      <a href="/docs/charts/line#examples">Line</a> and <a href="/docs/charts/stacked-area#examples">Stacked area</a>.
    </p>
  ) : examples.length === 0 ? (
    <p>The spec above is the sample for this type.</p>
  ) : (
    examples.map((example) => (
      <section id={`example-${example.slug}`}>
        <h3>{example.title}</h3>
        <p>{example.blurb}</p>
        <div class="example-preview" role="img" aria-label={example.alt} set:html={example.svg} />
        <figure class="code">
          <figcaption>spec</figcaption>
          <pre><code>{pretty(example.spec)}</code></pre>
        </figure>
        <p>
          <a href={`/playground#${encodeURIComponent(JSON.stringify(example.spec))}`}>Open in playground</a>
        </p>
      </section>
    ))
  )
}

<p>
  <a href="/docs/encoding">Encoding</a>
  {" · "}
  <a href="/docs/theming">Theming</a>
  {" · "}
  <a href="/gallery">Gallery</a>
</p>
<PageNav href={href} />
