---
import "../styles/playground.css";
import {
  specForChart,
  type ChartDoc,
} from "../data/docs-catalog";
import { paintSpec } from "../lib/chartkit";
import { loadMaps } from "../lib/batch3";
import { loadExample, loadExamplesIndex } from "../lib/surfaces";
import { pretty, scriptJson } from "../lib/spec-text";
import ExamplePicker from "./ExamplePicker.astro";
import PageNav from "./PageNav.astro";
import Prose from "./Prose.astro";
import StackSample from "./StackSample.astro";

interface Props {
  chart: ChartDoc;
}

interface ShownExample {
  slug: string;
  title: string;
  blurb: string;
  svg: string;
  alt: string;
  spec: Record<string, unknown>;
}

const { chart } = Astro.props;
const href = `/docs/charts/${chart.type}`;
const fallback = specForChart(chart);

const examples: ShownExample[] = loadExamplesIndex()
  .examples.filter((example) => example.type === chart.type)
  .map((example) => {
    const file = loadExample(example.slug);
    return { slug: file.slug, title: file.title, blurb: file.blurb, svg: file.svg, alt: file.alt, spec: file.spec };
  });

if (chart.type === "choropleth" || chart.type === "map-points") {
  const maps = loadMaps();
  const cards = chart.type === "choropleth" ? [maps.world, maps.us] : [maps.cities];
  const titles = chart.type === "choropleth" ? ["World choropleth", "United States"] : ["Cities"];
  const slugs = chart.type === "choropleth" ? ["world", "us"] : ["cities"];
  cards.forEach((card, index) => {
    examples.push({
      slug: slugs[index] ?? "map",
      title: titles[index] ?? "Map",
      blurb: card.alt,
      svg: card.svg,
      alt: card.alt,
      spec: card.spec as Record<string, unknown>,
    });
  });
}

const initial = examples[0];
const initialSpec = initial?.spec ?? fallback;
const initialSvg = initial?.svg || paintSpec(initialSpec).svg;
const initialAlt = initial?.alt || (typeof initialSpec.a11y === "object" && initialSpec.a11y && "alt" in initialSpec.a11y ? String(initialSpec.a11y.alt) : chart.title);
const playHref = `/playground#${encodeURIComponent(JSON.stringify(initialSpec))}`;
---

<div class="facts" aria-label={`${chart.title} facts`}>
  {
    chart.facts.map((fact) => (
      <span class="fact">
        <span class="fact__k">{fact.k}</span>
        {fact.k === "Status" ? (
          <span class:list={["status-pill", fact.v === "drawn" || fact.v === "in the library" ? "is-drawn" : "is-planned"]}>{fact.v}</span>
        ) : (
          <span class="fact__v">{fact.v}</span>
        )}
      </span>
    ))
  }
  <span class="fact">
    <span class="fact__k">Family</span>
    <span class="fact__v">{chart.family}</span>
  </span>
</div>

<div class="chart-studio" id="chart-studio">
  <div class="chart-studio__copy">
    {
      chart.type === "area" ? (
        <p>
          Filled line. The spec <code>type</code> is <code>line</code>, with <code>mark.area</code>.
          {
            examples.length === 0 ? (
              <>
                {" "}
                Worked examples are on <a href="/docs/charts/line">Line</a> and{" "}
                <a href="/docs/charts/stacked-area">Stacked area</a>.
              </>
            ) : null
          }
        </p>
      ) : null
    }
    {
      chart.anatomy.length ? (
        <>
          <h2>Anatomy</h2>
          <ol class="anatomy">
            {chart.anatomy.map((item) => (
              <li>
                <Prose text={item.replace(/^\d+(?=\S)/, "").replace(/^\d+\s*/, "")} />
              </li>
            ))}
          </ol>
        </>
      ) : null
    }
    {
      chart.notes.map((section) => (
        <section>
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => (
            <p>
              <Prose text={paragraph} />
            </p>
          ))}
          {section.list.length ? (
            <ul>
              {section.list.map((item) => (
                <li>
                  <Prose text={item} />
                </li>
              ))}
            </ul>
          ) : null}
          {section.code.map((code) => (
            <figure class="code">
              <figcaption>sample</figcaption>
              <pre><code>{code}</code></pre>
            </figure>
          ))}
        </section>
      ))
    }
    <StackSample />
  </div>

  <div class="chart-studio__options">
    <h2>Options</h2>
    <div data-options></div>
  </div>

  <aside class="chart-studio__stage" aria-label="Preview">
    {
      examples.length ? (
        <ExamplePicker examples={examples.map((example) => ({ slug: example.slug, title: example.title, blurb: example.blurb }))} active={initial?.slug} />
      ) : (
        <p class="chart-studio__empty">The spec is the sample for this type.</p>
      )
    }
    <div class="chart-studio__preview">
      <div data-chart role="img" aria-label={initialAlt} set:html={initialSvg} />
    </div>
    <figure class="code chart-studio__code">
      <figcaption>spec</figcaption>
      <pre><code data-code>{pretty(initialSpec)}</code></pre>
    </figure>
    <p class="chart-studio__play">
      <a data-play href={playHref}>Open in playground</a>
    </p>
  </aside>
</div>

<p>
  <a href="/docs/encoding">Encoding</a>
  {" · "}
  <a href="/docs/theming">Theming</a>
  {" · "}
  <a href="/gallery">Gallery</a>
</p>
<PageNav href={href} />

<script id="chart-studio-data" type="application/json" is:inline set:html={scriptJson({
  examples: examples.map((example) => ({
    slug: example.slug,
    title: example.title,
    blurb: example.blurb,
    alt: example.alt,
    spec: example.spec,
  })),
  fallback,
})} />
<script>
  import { mountChartStudio } from "../scripts/chart-studio";

  const root = document.getElementById("chart-studio");
  if (root) mountChartStudio(root);
</script>
