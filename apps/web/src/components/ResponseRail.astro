---
import { chartPreview, paintSpec, statusPill } from "../lib/chartkit";
import type { ChipGroup } from "../data/docs-catalog";

interface Props {
  spec: Record<string, unknown>;
  chips?: ChipGroup[];
}

const { spec, chips = [] } = Astro.props;
const result = paintSpec(spec);
const drawn = paintSpec(chartPreview(spec));
const json = JSON.stringify(spec, null, 2);
const pill = statusPill(result);

function at(source: Record<string, unknown>, path: string): unknown {
  return path.split(".").reduce<unknown>((current, key) => {
    if (current && typeof current === "object") return (current as Record<string, unknown>)[key];
    return undefined;
  }, source);
}

function pressed(group: ChipGroup, value: string): boolean {
  return String(at(spec, group.key) ?? "") === value;
}
---

<div class="rail-stack">
  <h2 class="rail-title">Try it</h2>
  <div class="docs-try-slot">
    <div
      class="docs-handle"
      id="docs-handle"
      role="separator"
      aria-orientation="vertical"
      aria-label="Resize try-it panel"
      aria-describedby="docs-try-caption"
      aria-controls="docs-response"
      aria-valuemin="280"
      aria-valuemax="9999"
      aria-valuenow="380"
      tabindex="0"
    ></div>
    <div
      class:list={["docs-try", "response", !result.ok && "is-error"]}
      id="docs-response"
      data-theme={result.theme === "midnight" ? "midnight" : "soft"}
      aria-live="polite"
    >
    <div class="response__chrome">
      <div class="response__tabs" role="tablist" aria-label="Response view">
        <button type="button" class="response__tab is-on" data-tab="chart" role="tab" aria-selected="true">Chart</button>
        <button type="button" class="response__tab" data-tab="json" role="tab" aria-selected="false">JSON</button>
      </div>
      <span class:list={["response__status", "validity", result.ok ? "is-ok" : "is-bad"]} id="response-status">{pill}</span>
    </div>
    <div class="response__body">
      <div class="response__panel" data-panel="chart">
        <div class="response__meta">
          <span class="response__title" id="response-title">{result.title}</span>
          <span class="response__badge" id="response-badge">{result.badge}</span>
        </div>
        <div id="response-chart" set:html={drawn.svg || result.svg} />
        <ul id="response-errors" hidden={result.issues.length === 0}>
          {
            result.issues.map((issue) => (
              <li>
                <code>{issue.code}</code>
                {' '}
                <span>{issue.path}</span>
                {' '}
                {issue.message}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="response__panel" data-panel="json" hidden>
        <div class="response__json-bar">
          <span>response.json</span>
          <button type="button" class="response__copy" id="response-copy">Copy</button>
        </div>
        <pre class="response__json" id="response-json">{json}</pre>
      </div>
    </div>
    {
      chips.length ? (
        <div class="rail-options" role="group" aria-label="Spec options">
          {
            chips.map((group) => (
              <div class="chip-row">
                <span class="chip-row__label">{group.label}</span>
                <div class="chip-row__opts">
                  {group.options.map((option) => (
                    <button
                      type="button"
                      class:list={["spec-chip", pressed(group, option.value) && "is-on"]}
                      data-key={group.key}
                      data-value={option.value}
                      aria-pressed={pressed(group, option.value) ? "true" : "false"}
                    >
                      {option.swatch ? <span class="spec-chip__dot" style={`background:${option.swatch}`} aria-hidden="true" /> : null}
                      {option.label}
                    </button>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      ) : null
    }
  </div>
  </div>
  <p class="docs-try__caption" id="docs-try-caption">Drag the left edge to resize.</p>
</div>

<script>
  const root = document.getElementById("docs-response");
  const tabs = root?.querySelectorAll<HTMLButtonElement>(".response__tab") ?? [];
  const copy = document.getElementById("response-copy");
  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const name = tab.dataset.tab;
      tabs.forEach((peer) => {
        const on = peer === tab;
        peer.classList.toggle("is-on", on);
        peer.setAttribute("aria-selected", on ? "true" : "false");
      });
      root?.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
        panel.hidden = panel.dataset.panel !== name;
      });
    });
  });
  copy?.addEventListener("click", async () => {
    const text = document.getElementById("response-json")?.textContent ?? "";
    try {
      await navigator.clipboard.writeText(text);
      copy.textContent = "Copied";
      window.setTimeout(() => {
        copy.textContent = "Copy";
      }, 1200);
    } catch {
      copy.textContent = "Copy";
    }
  });
</script>
