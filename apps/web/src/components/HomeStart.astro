---
import FrameworkChips from "./FrameworkChips.astro";
import StackSample from "./StackSample.astro";
import { agentSwitchPrompt } from "../data/agent-prompt";
---

<section class="home-start" id="get-started" aria-label="Get started">
  <article class="home-start__card">
    <h2>Install yourself</h2>
    <p>
      Pick your framework below, then copy that install command. The same choice is used for snippets across the site. <a href="/docs/install">Install notes</a>.
    </p>
    <FrameworkChips />
    <StackSample copy />
  </article>
  <article class="home-start__card">
    <h2>Tell your agent</h2>
    <p>Paste this when you want the charts switched to ChartKit. The app stays JavaScript.</p>
    <pre class="home-prompt" data-agent-prompt>{agentSwitchPrompt}</pre>
    <p class="home-copy-row">
      <button type="button" class="home-copy" data-copy-prompt>Copy prompt</button>
      <span class="home-copy-status" data-copy-status role="status"></span>
    </p>
  </article>
</section>

<script>
  import "../scripts/home-start";
</script>
