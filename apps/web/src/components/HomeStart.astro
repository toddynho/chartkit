---
import FrameworkChips from "./FrameworkChips.astro";
import { agentSwitchPrompt } from "../data/agent-prompt";
import { stacks } from "../data/stacks";

const splitAt = agentSwitchPrompt.indexOf("\n\n");
const lead = splitAt === -1 ? agentSwitchPrompt : agentSwitchPrompt.slice(0, splitAt);
const body = splitAt === -1 ? "" : agentSwitchPrompt.slice(splitAt + 2);
---

<section class="gs" id="get-started" aria-labelledby="get-started-title">
  <div class="gs-wrap">
  <div class="section-head gs-head">
    <p class="eyebrow eyebrow--blue">Get started</p>
    <h2 id="get-started-title">Two ways in</h2>
    <p>Install it yourself in a minute, or hand your agent one prompt and let it do the switch.</p>
  </div>
  <div class="gs-grid">
    <article class="gs-card">
      <div>
        <h3>Install yourself</h3>
        <p>Pick a framework, copy the command.</p>
      </div>
      <FrameworkChips />
      <div class="gs-code stack-sample">
        {
          stacks.map((stack) => (
            <div data-stack-panel={stack.id}>
              <p class="gs-npm">
                <span>npm</span> install @chartkitdev/core @chartkitdev/{stack.id}
              </p>
              <pre>{stack.snippet}</pre>
            </div>
          ))
        }
      </div>
    </article>
    <article class="gs-card">
      <div>
        <h3>Tell your agent</h3>
        <p>Paste this. The app stays JavaScript.</p>
      </div>
      <div class="gs-prompt">
        <div data-agent-prompt>
          <p class="gs-prompt__lead">{lead}</p>
          <p class="gs-prompt__body">{body}</p>
        </div>
        <button type="button" class="gs-copy" data-copy-prompt data-copied-ms="1500" data-copy-text={agentSwitchPrompt}>
          Copy
        </button>
      </div>
    </article>
  </div>
  </div>
</section>

<script>
  import "../scripts/home-start";
</script>
