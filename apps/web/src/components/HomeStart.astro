---
import FrameworkChips from "./FrameworkChips.astro";
import StackSample from "./StackSample.astro";
import { agentSwitchPrompt } from "../data/agent-prompt";
---

<section class="home-cards" id="get-started" aria-label="Get started">
  <article class="home-card">
    <header class="home-card__head">
      <div class="home-card__copy">
        <h2>Install yourself</h2>
        <p>Pick a framework.</p>
      </div>
      <div class="home-card__chips">
        <FrameworkChips />
      </div>
    </header>
    <StackSample copy oneLine />
  </article>
  <article class="home-card">
    <header class="home-card__head">
      <div class="home-card__copy">
        <h2>Tell your agent</h2>
        <p>Paste this. The app stays JavaScript.</p>
      </div>
    </header>
    <div class="prompt-block">
      <div class="prompt-block__bar">
        <span>prompt</span>
        <button type="button" class="copy-pill" data-copy-prompt>Copy</button>
      </div>
      <pre data-agent-prompt>{agentSwitchPrompt}</pre>
      <span class="sr" data-copy-status role="status"></span>
    </div>
  </article>
</section>

<script>
  import "../scripts/home-start";
</script>
