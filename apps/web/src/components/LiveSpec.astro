---
import { pretty } from "../lib/spec-text";

interface Props {
  spec: Record<string, unknown>;
  svg: string;
  mode?: "compact" | "full";
  themes?: string[];
  docsHref?: string;
  docsLabel?: string;
}

const { spec, svg, mode = "compact", themes = [], docsHref, docsLabel } = Astro.props;
const text = pretty(spec);
const specId = mode === "full" ? "spec-json" : undefined;
---

<div class:list={["live-editor", mode === "full" && "live-editor--full"]} data-live-spec data-mode={mode}>
  <div class="live-editor__preview">
    <p class="live-pane__kicker" id={mode === "full" ? "live-preview-label" : undefined}>Preview</p>
    <div
      class="ck-frame preview"
      data-preview
      aria-labelledby={mode === "full" ? "live-preview-label" : undefined}
      set:html={svg}
    />
  </div>
  <div class="live-editor__side">
    <div class="live-pane__head">
      <label for={specId}>Spec</label>
      {docsHref && docsLabel ? <a class="live-docs" href={docsHref}>{docsLabel}</a> : null}
    </div>
    <div class="code-field">
      <pre class="code-field__paint" aria-hidden="true" data-spec-paint></pre>
      <textarea id={specId} class="code-field__input" data-spec-input spellcheck="false">{text}</textarea>
    </div>
    <div class="live-actions">
      {
        mode === "full" ? (
          <>
            <label class="theme-label">
              Theme
              <select data-theme>
                <option value="site">Match site</option>
                {themes.map((name) => (
                  <option value={name}>{name}</option>
                ))}
              </select>
            </label>
            <button type="button" data-validate>Validate</button>
            <button type="button" class="is-primary" data-repair>Repair</button>
            <button type="button" data-share>Share</button>
            <button type="button" data-svg>SVG</button>
            <button type="button" data-png>PNG</button>
          </>
        ) : (
          <a data-play href={`/playground#${encodeURIComponent(text)}`}>Open in playground</a>
        )
      }
    </div>
    <p class="live-status" data-status role="status">Showing the published spec.</p>
    <ul class="live-issues" data-issues />
  </div>
</div>

<script>
  import { mountLiveSpec } from "../scripts/live-spec";

  document.querySelectorAll<HTMLElement>("[data-live-spec]").forEach((node) => mountLiveSpec(node));
</script>
