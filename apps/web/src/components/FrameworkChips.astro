---
import { stacks } from "../data/stacks";

const marks: Record<string, string> = {
  react: "/frameworks/react.svg",
  vue: "/frameworks/vue.svg",
  svelte: "/frameworks/svelte.svg",
  vanilla: "/frameworks/javascript.svg",
  element: "/frameworks/element.svg",
};
---

<div class="stack-chips" role="group" aria-label="Framework">
  {
    stacks.map((stack) => (
      <button type="button" class="stack-chip" data-stack-chip={stack.id} aria-pressed="false" title={stack.label}>
        <span class="stack-chip__icon" aria-hidden="true">
          <img src={marks[stack.id]} alt="" width="16" height="16" />
        </span>
        <span class="stack-chip__label">{stack.chip}</span>
      </button>
    ))
  }
</div>
