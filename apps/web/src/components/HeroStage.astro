---
import { heroEditHref, heroSlides, peekSparkline } from "../data/hero-slides";

const slides = heroSlides();
const first = slides[0];
const peek = peekSparkline();
const clientSlides = slides.map((slide) => ({
  label: slide.label,
  title: slide.title,
  kpi: slide.kpi,
  delta: slide.delta,
  chrome: slide.chrome,
  json: slide.json,
  svg: slide.svg,
  edit: heroEditHref(slide.type),
}));
---

<section class="stage-band" aria-label="Product">
  <div class="stage" id="hero-stage">
    <div class="stage__ghost" id="stage-ghost">
      <pre id="ghost-pre" set:html={first.json} />
    </div>
    <div class="stage__chip">
      <span class="stage__chip-dot" aria-hidden="true"></span>
      No extra model call
    </div>
    <aside class="stage__peek">
      <span class="stage__peek-label">Sparkline · example <a class="stage-edit" href={heroEditHref("sparkline")}>Edit</a></span>
      <div set:html={peek} />
    </aside>
    <div class="stage__ground" aria-hidden="true"></div>
    <div class="stage__tilt" id="stage-tilt">
      <div class="stage__surface" id="stage-surface">
        <div class="stage__chrome">
          <div class="stage__dots" aria-hidden="true"><span></span><span></span><span></span></div>
          <div class="stage__chrome-end">
            <span class="stage__chrome-label" id="chrome-label">{first.chrome}</span>
            <a class="stage-edit" id="stage-edit" href={heroEditHref(first.type)}>Edit spec</a>
          </div>
        </div>
        <div class="stage__body">
          <div class="stage__meta">
            <span class="stage__title" id="chart-title">{first.title}</span>
          </div>
          <div class="stage__value">
            <span class="stage__value-num" id="chart-kpi">{first.kpi}</span>
            <span class="stage__value-delta" id="chart-delta">{first.delta}</span>
          </div>
          <div class="chart-stage">
            <div class="chart-wrap" id="chart-slot" set:html={first.svg} />
          </div>
        </div>
      </div>
    </div>
    <p class="sr" id="hero-live" aria-live="polite"></p>
  </div>
</section>

<div class="type-rail-wrap">
  <div class="type-rail" id="type-rail" role="tablist" aria-label="Chart types">
    {
      slides.map((chart, index) => (
        <button
          type="button"
          class:list={["type-btn", index === 0 && "is-active"]}
          role="tab"
          id={`hero-tab-${chart.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls="chart-slot"
          aria-label={`${chart.label} chart`}
          tabindex={index === 0 ? 0 : -1}
          data-index={index}
        >
          <svg class="type-btn__icon" viewBox="0 0 24 20" fill="none" aria-hidden="true" set:html={chart.icon} />
          <span class="type-btn__label">{chart.label}</span>
          <span class="type-btn__underline" aria-hidden="true" />
        </button>
      ))
    }
  </div>
  <div class="type-progress" aria-hidden="true"><div class="type-progress__bar" id="type-progress"></div></div>
</div>

<div class="stage-proof" id="stage-proof">
  <p class="stage-proof__lead">Built so an agent can ship a chart without another round trip.</p>
  <p>
    JSON spec in, chart out. <code>validate()</code> and <code>repair()</code> fix the safe mistakes on the spec, with no
    extra model call.
  </p>
  <p class="stage-proof__proof">
    In one measured run, 42 of 42 specs were valid on the first try with the docs in the prompt. <code>repair()</code>
    lifted a no-docs run from 21/42 to 42/42.
  </p>
</div>

<script id="hero-slides" type="application/json" is:inline set:html={JSON.stringify(clientSlides).replaceAll("<", "\\u003c")}
></script>
<script src="../scripts/hero-stage.ts"></script>
