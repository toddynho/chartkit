---
import { githubStars } from "../data/github-stars";
import { SITE, canonicalPath } from "../data/site";
import { primaryNav } from "../data/nav";
import BrandLockup from "./BrandLockup.astro";

const path = canonicalPath(Astro.url.pathname);
const docsHere = path === "/docs" || path.startsWith("/docs/");
const dashHere = path === "/dashboard" || path === "/dashboards" || path.startsWith("/dashboards/");
const stars = await githubStars();

function mark(href: string): "page" | undefined {
  if (href === "/docs") return docsHere ? "page" : undefined;
  if (href === "/dashboards") return dashHere ? "page" : undefined;
  if (href === "/examples") return path === "/examples" || path.startsWith("/examples/") ? "page" : undefined;
  return path === href ? "page" : undefined;
}
---

<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <BrandLockup />
    <nav class="primary" aria-label="Primary">
      {
        primaryNav.map((item) => (
          <a href={item.href} aria-current={mark(item.href)}>
            {item.label}
          </a>
        ))
      }
      <a class="nav-cta" href="/cloud">Try Cloud</a>
    </nav>
    <div class="header-end">
      <a class="gh-star" href={SITE.github} aria-label={`Star toddynho/chartkit on GitHub${stars == null ? "" : `, ${stars} stars`}`}>
        <span class="gh-star__main">
          <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
            <path
              fill="currentColor"
              d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Zm0 2.445L6.615 5.5a.75.75 0 0 1-.564.41l-3.097.45 2.24 2.184a.75.75 0 0 1 .216.664l-.528 3.084 2.769-1.456a.75.75 0 0 1 .698 0l2.77 1.456-.53-3.084a.75.75 0 0 1 .216-.664l2.24-2.183-3.096-.45a.75.75 0 0 1-.564-.41L8 2.694Z"
            ></path>
          </svg>
          Star
        </span>
        {stars == null ? null : <span class="gh-star__count">{stars}</span>}
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 6);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
