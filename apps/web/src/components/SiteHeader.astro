---
import { SITE, canonicalPath } from "../data/site";
import { primaryNav } from "../data/nav";
import BrandLockup from "./BrandLockup.astro";

const path = canonicalPath(Astro.url.pathname);
const docsHere = path === "/docs" || path.startsWith("/docs/");
const dashHere = path === "/dashboard" || path === "/dashboards" || path.startsWith("/dashboards/");

function mark(href: string): "page" | undefined {
  if (href === "/docs") return docsHere ? "page" : undefined;
  if (href === "/dashboards") return dashHere ? "page" : undefined;
  if (href === "/examples") return path === "/examples" || path.startsWith("/examples/") ? "page" : undefined;
  return path === href ? "page" : undefined;
}
---

<header class="site-header" id="site-header">
  <div class="site-header__inner">
    <BrandLockup />
    <nav class="primary" aria-label="Primary">
      {
        primaryNav.map((item) => (
          <a href={item.href} aria-current={mark(item.href)}>
            {item.label}
          </a>
        ))
      }
      <a class="nav-cta" href="/cloud">Try Cloud</a>
    </nav>
    <div class="header-end">
      <a
        class="github-button"
        href={SITE.github}
        data-icon="octicon-star"
        data-show-count="true"
        data-color-scheme="no-preference: light; light: light; dark: light;"
        aria-label="Star toddynho/chartkit on GitHub"
        >Star</a
      >
    </div>
  </div>
</header>

<script is:inline async defer src="https://buttons.github.io/buttons.js"></script>
<script>
  const header = document.getElementById("site-header");
  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 6);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>
