---
import { SITE, canonicalPath } from "../data/site";
import { docsNavLinks, primaryNav } from "../data/nav";
import BrandLockup from "./BrandLockup.astro";

interface Props {
  variant?: "site" | "docs";
}

const { variant = "site" } = Astro.props;
const path = canonicalPath(Astro.url.pathname);
const docsHere = path === "/docs" || path.startsWith("/docs/");
const dashHere = path === "/dashboard" || path === "/dashboards" || path.startsWith("/dashboards/");
const onCloud = path === "/cloud";
const links = variant === "docs" ? docsNavLinks : primaryNav;

function mark(href: string): "page" | undefined {
  if (href === "/docs") return docsHere ? "page" : undefined;
  if (href === "/dashboards") return dashHere ? "page" : undefined;
  return path === href ? "page" : undefined;
}
---

<header class:list={["site-header", variant === "docs" && "site-header--docs"]} id="site-header">
  <div class="site-header__inner">
    <BrandLockup tag={variant === "docs" ? "Docs" : undefined} />
    {
      variant === "docs" ? (
        <form class="docs-search" role="search" action="/docs" method="get">
          <label class="sr" for="docs-search">Search docs</label>
          <input id="docs-search" type="search" placeholder="Search docs" data-docs-search autocomplete="off" />
          <kbd>⌘K</kbd>
        </form>
      ) : null
    }
    <div class="header-cluster">
      <nav class="primary" id="site-nav" aria-label="Primary">
        {
          links.map((item) => (
            <a href={item.href} aria-current={mark(item.href)}>
              {item.label}
            </a>
          ))
        }
        <a class="nav-menu-star" href={SITE.github}>
          <span aria-hidden="true">★</span> Star <strong>7</strong>
        </a>
      </nav>
      <div class="header-end">
        <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
          <span class="sr" data-nav-label>Open menu</span>
          <svg class="nav-toggle__bars" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M3 6h16M3 11h16M3 16h16"></path>
          </svg>
          <svg class="nav-toggle__x" width="22" height="22" viewBox="0 0 22 22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <path d="M5 5l12 12M17 5L5 17"></path>
          </svg>
        </button>
        <a class="star-chip" href={SITE.github} aria-label="Star toddynho/chartkit on GitHub">
          <span aria-hidden="true">★</span> Star <strong>7</strong>
        </a>
        {
          variant === "docs" ? null : (
            <a class="btn-ink header-cta" href={onCloud ? "/cloud#pricing" : "/docs"}>
              {onCloud ? "Get a key" : "Get started"}
            </a>
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const navLabel = toggle?.querySelector("[data-nav-label]");
  const setMenu = (open: boolean) => {
    header?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");
    if (navLabel) navLabel.textContent = open ? "Close menu" : "Open menu";
  };
  toggle?.addEventListener("click", () => setMenu(!header?.classList.contains("is-open")));
  document.getElementById("site-nav")?.addEventListener("click", (event) => {
    const target = event.target;
    if (target instanceof Element && target.closest("a")) setMenu(false);
  });
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });
  window.addEventListener("resize", () => {
    if (window.innerWidth > 980) setMenu(false);
  });

  const input = document.querySelector<HTMLInputElement>("[data-docs-search]");
  if (input) {
    const filter = () => {
      const query = input.value.trim().toLowerCase();
      document.querySelectorAll<HTMLElement>("#docs-sidebar a").forEach((link) => {
        const row = link.closest("li");
        if (!row) return;
        row.hidden = query.length > 0 && !(link.textContent ?? "").toLowerCase().includes(query);
      });
      document.querySelectorAll<HTMLElement>("#docs-sidebar details").forEach((fold) => {
        if (query.length > 0) fold.setAttribute("open", "");
      });
    };
    input.addEventListener("input", filter);
    window.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        input.focus();
      }
    });
  }
</script>
