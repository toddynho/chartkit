---
import { frameworkLanguage, highlight } from "../lib/highlight";

interface Props {
  snippets: { id: string; label: string; code: string }[];
}

const { snippets } = Astro.props;

function panel(html: string, id: string): string {
  return html.replace(
    /<pre class="shiki[^"]*"/,
    `<pre class="shiki fw-code" data-fw-panel="${id}"`,
  );
}

const blocks = await Promise.all(
  snippets.map(async (item) => ({
    ...item,
    html: panel(await highlight(item.code, frameworkLanguage(item.id)), item.id),
  })),
);
---

<div class="fw-tabs" data-frameworks>
  <div class="theme-switch" role="tablist" aria-label="Framework">
    {
      snippets.map((item, index) => (
        <button type="button" role="tab" data-fw={item.id} aria-selected={index === 0 ? "true" : "false"}>
          {item.label}
        </button>
      ))
    }
  </div>
  <div class="fw-bar">
    <span data-fw-label>React</span>
    <button type="button" data-fw-copy>Copy code</button>
  </div>
  {blocks.map((item) => <Fragment set:html={item.html} />)}
</div>

<script>
  import { mountFrameworks } from "../scripts/framework-tabs";

  document.querySelectorAll<HTMLElement>("[data-frameworks]").forEach((node) => mountFrameworks(node));
</script>
