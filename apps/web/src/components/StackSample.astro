---
import { stacks, type Stack } from "../data/stacks";

interface Props {
  heading?: boolean;
  /** Copy icon on the code block. Used by the homepage install card. */
  copy?: boolean;
}

const { heading = false, copy = false } = Astro.props;

function escapeHtml(value: string): string {
  return value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
}

/** One line of HTML so a newline inside <pre> cannot indent `npm install`. */
function sampleBlock(stack: Stack): string {
  const code = escapeHtml(`${stack.install}\n\n${stack.snippet}`);
  return `<figure class="code" data-stack-panel="${stack.id}"><figcaption>${escapeHtml(stack.label)}</figcaption><pre><code>${code}</code></pre></figure>`;
}
---

<section
  class:list={["stack-sample", !heading && "stack-sample--quiet", copy && "stack-sample--copy"]}
  aria-label="Install for the selected framework"
>
  {
    heading ? (
      <>
        <h2>Install</h2>
        <p>
          Install core, then the adapter for the framework chip in the docs nav. That choice is remembered for snippets
          on this site.
        </p>
      </>
    ) : null
  }
  <div class="stack-sample__block">
    <Fragment set:html={stacks.map(sampleBlock).join("")} />
    {
      copy ? (
        <>
          <button type="button" class="code-copy" data-copy-install aria-label="Copy install command">
            <svg class="code-copy__glyph code-copy__glyph--copy" viewBox="0 0 16 16" aria-hidden="true">
              <rect x="5.25" y="5.25" width="8" height="8" rx="1.4" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
              <path d="M10.5 5.25V4.1A1.6 1.6 0 0 0 8.9 2.5H4.1A1.6 1.6 0 0 0 2.5 4.1v4.8A1.6 1.6 0 0 0 4.1 10.5h1.15" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
            </svg>
            <svg class="code-copy__glyph code-copy__glyph--check" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3.4 8.3 6.3 11.1 12.6 4.8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </button>
          <span class="sr" data-copy-status role="status"></span>
        </>
      ) : null
    }
  </div>
  {
    heading ? (
      <p class="note">
        Also: <a href="/docs/markdown">MD fences</a> take the same spec. Markdown is not a fifth app stack.
      </p>
    ) : null
  }
</section>
