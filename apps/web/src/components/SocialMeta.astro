---
import { SITE, SOCIAL } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Site path or absolute URL. Defaults to the ChartKit card. */
  image?: string;
  imageAlt?: string;
}

const { title, description, image = SOCIAL.image, imageAlt = SOCIAL.alt } = Astro.props;
const imageUrl = new URL(image, Astro.site ?? SITE.url).href;
---

<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content={SOCIAL.width} />
<meta property="og:image:height" content={SOCIAL.height} />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SOCIAL.twitter} />
<meta name="twitter:creator" content={SOCIAL.twitter} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
