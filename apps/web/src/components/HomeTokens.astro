---
import { rivalSwatch } from "../data/rival-colors";
import { tokenSpread } from "../data/token-eval";

const spread = tokenSpread();
const others = spread.rows.filter((row) => !row.us).map((row) => ({ name: row.name, ...rivalSwatch(row.name) }));
const ticks = [
  { label: "0", left: "0%", edge: "start" },
  { label: "500", left: "25%", minor: true },
  { label: "1,000", left: "50%" },
  { label: "1,500", left: "75%", minor: true },
  { label: "2,000 tok", left: "100%", edge: "end" },
];
---

<section class="band" data-ckx="tokens" aria-labelledby="tokens-title">
  <div class="band-head">
    <div class="band-head__copy">
      <p class="eyebrow eyebrow--blue">For the agent</p>
      <h2 id="tokens-title"><span>Fewer tokens per chart.</span><span>On every model.</span></h2>
      <p>
        Same {spread.tasks} tasks, {spread.modelWord} models, {spread.libraryWord} libraries. The agent writes a short spec instead of a component, so the median is {spread.calls} model {spread.calls === "1.0" ? "call" : "calls"} with a fraction of the output.
      </p>
    </div>
    <div class="band-stat">
      <p class="band-stat__num">{spread.headline}<span class="tight">×</span></p>
      <p class="band-stat__cap"><strong>{spread.ratioLead}</strong> fewer tokens per chart, depending on model.</p>
    </div>
  </div>
  <div class="proof-card ckx-card">
    <div class="ckx-head">
      <div>
        <h3>Output tokens per working chart, by model</h3>
        <p>Each dot is one model's median. The bar is the spread across {spread.modelWord}.</p>
      </div>
      <div class="ckx-key">
        <span class="ckx-key__us"><i></i>ChartKit</span>
        <span class="ckx-key__vs">vs</span>
        <span class="ckx-key__others" tabindex="0" aria-label={`${others.length} other libraries: ${others.map((lib) => lib.name).join(", ")}`}>
          <span class="ckx-cluster" aria-hidden="true">{others.map((lib) => <i style={`--c:${lib.fill}`}></i>)}</span>
          {others.length} others
          <span class="ckx-pop" role="tooltip">
            {others.map((lib) => <span style={`--c:${lib.fill};--ink:${lib.ink}`}><i></i>{lib.name}</span>)}
          </span>
        </span>
        <span class="ckx-key__glyph"><i class="g-dot"></i>model</span>
        <span class="ckx-key__glyph"><i class="g-tick"></i>median</span>
      </div>
    </div>
    <div class="ckx-rows">
      {
        spread.rows.map((row) => {
          const swatch = rivalSwatch(row.name);
          return (
            <div
              class:list={["ckx-row", "ckx-row--tok", row.us && "is-us"]}
              data-ckx-row={row.us ? undefined : ""}
              tabindex={row.us ? undefined : 0}
              role={row.us ? undefined : "button"}
              aria-pressed={row.us ? undefined : "false"}
              style={`--c:${swatch.fill};--ink:${swatch.ink};--band:${swatch.band}`}
            >
              <div class="ckx-label">
                <span class="ckx-name">{row.name}</span>
                <span class="ckx-note"><span class="ckx-note__pre">range </span>{row.range}</span>
              </div>
              <div class="ckx-track" aria-hidden="true">
                <div class="ckx-rail"></div>
                <div class="ckx-band" style={`left:${row.minPct};width:${row.spanPct}`}></div>
                {row.dots.map((dot) => (
                  <span class="ckx-dot ckx-dot--sm" title={dot.title} style={`left:${dot.left}`}></span>
                ))}
                <div class="ckx-med" style={`left:${row.medPct}`}></div>
              </div>
              <span class="ckx-val">{row.medianText}<small> tok</small></span>
              {row.us && spread.annotation ? (
                <div class="ckx-anno">
                  <div class="ckx-bracket" style={`left:${spread.annotation.left};width:${spread.annotation.width}`}></div>
                  <span style={`left:${spread.annotation.labelLeft}`}>{spread.annotation.text}</span>
                </div>
              ) : null}
            </div>
          );
        })
      }
    </div>
    <div class="ckx-axis" aria-hidden="true">
      {ticks.map((tick) => <span class:list={[tick.minor && "is-minor", tick.edge && `is-${tick.edge}`]} style={`left:${tick.left}`}>{tick.label}</span>)}
    </div>
    <div class="stat-strip">
      <div>
        <strong>{spread.rangeStat}</strong>
        <p>{spread.rangeBody}</p>
      </div>
      <div>
        <strong>{spread.calls}<span> call</span></strong>
        <p>per working chart. <code>repair()</code> fixes specs without the model.</p>
      </div>
      <div>
        <strong>{spread.cheapest}<span> / {spread.cheapestTotal}</span></strong>
        <p>models where ChartKit was the cheapest library. <a href="/agents#wrote">See what the agent wrote →</a></p>
      </div>
    </div>
    <p class="proof-note">
      <a class="quiet-link" href="/methodology/agent-eval">Review test details and methodology →</a>
    </p>
  </div>
</section>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-ckx='tokens']")) {
    for (const row of root.querySelectorAll<HTMLElement>("[data-ckx-row]")) {
      if (row.dataset.ckxBound === "1") continue;
      row.dataset.ckxBound = "1";
      const setOn = (on: boolean) => {
        row.setAttribute("aria-pressed", on ? "true" : "false");
        row.classList.toggle("is-open", on);
      };
      row.addEventListener("click", () => {
        setOn(row.getAttribute("aria-pressed") !== "true");
      });
      row.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;
        event.preventDefault();
        setOn(row.getAttribute("aria-pressed") !== "true");
      });
    }
  }
</script>
