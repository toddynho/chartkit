---
import { rivalSwatch } from "../data/rival-colors";
import { tokenSpread } from "../data/token-eval";

const spread = tokenSpread();
---

<section class="band" aria-labelledby="tokens-title">
  <div class="band-head">
    <div class="band-head__copy">
      <p class="eyebrow eyebrow--blue">For the agent</p>
      <h2 id="tokens-title"><span>Fewer tokens per chart.</span><span>On every model.</span></h2>
      <p>
        Same {spread.tasks} tasks, {spread.modelWord} models, {spread.libraryWord} libraries. The agent writes a short spec instead of a component, so the median is {spread.calls} model {spread.calls === "1.0" ? "call" : "calls"} with a fraction of the output.
      </p>
    </div>
    <div class="band-stat">
      <p class="band-stat__num">{spread.headline}<span class="tight">×</span></p>
      <p class="band-stat__cap"><strong>{spread.ratioLead}</strong> fewer tokens per chart, depending on model.</p>
    </div>
  </div>
  <div class="proof-card">
    <div class="proof-card__head">
      <div>
        <h3>Output tokens per working chart, by model</h3>
        <p>Each dot is one model's median. The bar is the spread across {spread.modelWord}.</p>
      </div>
      <div class="proof-legend" aria-hidden="true">
        <span><i class="swatch-dot"></i>model</span>
        <span><i class="swatch-tick"></i>median</span>
      </div>
    </div>
    <div>
      {
        spread.rows.map((row, index) => {
          const swatch = rivalSwatch(row.name);
          return (
          <div class:list={["tok-row", index === 0 && "is-first", row.us && "is-us"]}>
            <div class="tok-name" style={`color:${swatch.ink};font-weight:${row.us ? 600 : 500}`}>{row.name}</div>
            <div class="tok-track">
              <div class="tok-rail"></div>
              <div class="tok-band" style={`left:${row.minPct};width:${row.spanPct};background:${swatch.band}`}></div>
              {row.dots.map((dot) => (
                <span class="tok-dot" title={dot.title} style={`left:${dot.left};background:${swatch.fill}`}></span>
              ))}
              <div class="tok-med" style={`left:${row.medPct};background:${swatch.ink}`}></div>
              {row.us && spread.annotation ? (
                <>
                  <div class="tok-bracket" style={`left:${spread.annotation.left};width:${spread.annotation.width}`}><span></span></div>
                  <div class="tok-anno" style={`left:${spread.annotation.labelLeft}`}>{spread.annotation.text}</div>
                </>
              ) : null}
            </div>
            <div class="tok-val" style={`color:${swatch.ink}`}>
              <strong>{row.medianText}</strong>
              <em>{row.range}</em>
            </div>
          </div>
          );
        })
      }
    </div>
    <div class="tok-axis" aria-hidden="true">
      <div></div>
      <div class="tok-axis__ticks">
        <span>0</span><span>500</span><span>1,000</span><span>1,500</span><span>2,000 tok</span>
      </div>
      <div></div>
    </div>
    <div class="stat-strip">
      <div>
        <strong>{spread.rangeStat}</strong>
        <p>{spread.rangeBody}</p>
      </div>
      <div>
        <strong>{spread.calls}<span> call</span></strong>
        <p>per working chart. <code>repair()</code> fixes specs without the model.</p>
      </div>
      <div>
        <strong>{spread.cheapest}<span> / {spread.cheapestTotal}</span></strong>
        <p>models where ChartKit was the cheapest library. <a href="/agents#wrote">See what the agent wrote →</a></p>
      </div>
    </div>
    <p class="proof-note">
      {spread.note} <a href="/agents#eval">Eval design →</a>
    </p>
  </div>
</section>
