---
import { paintSpec, type RailResult } from "../lib/chartkit";
import { isGeoSpec, paintGeo } from "../lib/paint-geo";
import { withPreviewSize } from "../data/preview-size";
import { teachModule } from "../data/teach/registry";
import { formatNumber, playgroundHref, specText } from "../data/teach/spec";

interface Props {
  type: string;
}

const { type } = Astro.props;
const module = teachModule(type);
if (!module) throw new Error(`No teach module for ${type}`);

const initial = module.examples[0];
if (!initial) throw new Error(`${type} demo has no example`);
const several = module.examples.length > 1;
const paintType = module.type;

async function paintExample(spec: Record<string, unknown>): Promise<RailResult> {
  if (isGeoSpec(spec)) return paintGeo(spec);
  return paintSpec(spec);
}

for (const example of module.examples) {
  const painted = await paintExample(withPreviewSize(example.spec));
  if (!painted.ok || !painted.svg.includes(`data-ck-type="${paintType}"`) || painted.svg.includes("ck-chart-error")) {
    const detail = painted.issues.map((issue) => `${issue.code} ${issue.message}`).join("; ");
    throw new Error(`${type} example ${example.id} did not render. ${detail}`);
  }
}
const rawSmallest = await paintExample(module.smallestSpec);
if (!rawSmallest.ok || !rawSmallest.svg.includes(`data-ck-type="${paintType}"`) || rawSmallest.svg.includes("ck-chart-error")) {
  const detail = rawSmallest.issues.map((issue) => `${issue.code} ${issue.message}`).join("; ");
  throw new Error(`Smallest ${type} spec did not render. ${detail}`);
}

const state = module.controlState(initial.spec);
const preview = await paintExample(withPreviewSize(initial.spec));
const snippet = specText(initial.spec);
const play = playgroundHref(initial.spec);

function pressed(current: string | number | undefined, value: string): boolean {
  return current != null && String(current) === value;
}
---

<div class="rail-stack">
  <div class="docs-try-slot">
    <div
      class="docs-handle"
      id="docs-handle"
      role="separator"
      aria-orientation="vertical"
      aria-label="Resize try-it panel"
      aria-controls="docs-response"
      aria-valuemin="280"
      aria-valuemax="9999"
      aria-valuenow="380"
      tabindex="0"
      title="Drag to resize"
    ></div>
    <div class="docs-try chart-demo" id="docs-response" data-chart-demo data-teach-type={module.type} data-example={initial.id}>
  <div class="ex-switch" data-ex-switch>
    <div class="ex-switch__lead">
      {
        several ? (
          <button
            type="button"
            class="ex-switch__title"
            data-ex-title
            aria-haspopup="listbox"
            aria-expanded="false"
            aria-controls="ex-switch-list"
          >
            <span class="ex-switch__name" data-ex-name>{initial.title}</span>
            <span class="ex-switch__chevron" aria-hidden="true">▾</span>
          </button>
        ) : (
          <div class="ex-switch__title ex-switch__title--plain">
            <span class="ex-switch__name" data-ex-name>{initial.title}</span>
          </div>
        )
      }
      <p class="ex-switch__desc" data-demo-blurb>{initial.blurb}</p>
      {
        several ? (
          <div class="ex-switch__menu" id="ex-switch-list" role="listbox" aria-label="Examples" hidden>
            {
              module.examples.map((example) => (
                <button
                  type="button"
                  class="ex-switch__option"
                  role="option"
                  id={`ex-opt-${example.id}`}
                  data-example-id={example.id}
                  aria-selected={example.id === initial.id ? "true" : "false"}
                >
                  <span class="ex-switch__option-name">{example.title}</span>
                  <code>{example.meta}</code>
                </button>
              ))
            }
          </div>
        ) : null
      }
    </div>
    {
      several ? (
        <div class="ex-switch__steps">
          <span class="ex-switch__count" data-ex-count>1 / {module.examples.length}</span>
          <button type="button" class="ex-switch__step" data-ex-prev aria-label="Previous example" aria-disabled="true">‹</button>
          <button type="button" class="ex-switch__step" data-ex-next aria-label="Next example">›</button>
        </div>
      ) : null
    }
  </div>
  <div class="chart-demo__chart" id="response-chart" data-demo-chart set:html={preview.svg}></div>
  <p class="chart-demo__error" data-demo-error hidden></p>
  <figure class="code">
    <figcaption>
      <span>spec.json</span>
      <button type="button" class="copy-pill" data-demo-copy>Copy</button>
    </figcaption>
    <pre><code data-demo-snippet>{snippet}</code></pre>
  </figure>
  <div class="chart-demo__controls">
    {
      module.controls.map((control) =>
        control.kind === "range" ? (
          <div class="chart-demo__control">
            <div class="chart-demo__label"><span>{control.label}</span><code>{control.code}</code></div>
            <label class="chart-demo__range">
              <input
                type="range"
                data-range={control.id}
                min={control.min}
                max={control.max}
                step={control.step}
                value={state[control.id]}
                aria-label={control.aria}
              />
              <output data-range-out={control.id}>{formatNumber(Number(state[control.id]))}</output>
            </label>
          </div>
        ) : (
          <div class="chart-demo__control">
            <div class="chart-demo__label"><span>{control.label}</span><code>{control.code}</code></div>
            <div class="chart-demo__choices" role="group" aria-label={control.aria}>
              {
                control.options.map((option) => (
                  <button
                    type="button"
                    class:list={["chart-demo__choice", pressed(state[control.id], option.value) && "is-on"]}
                    data-choice={control.id}
                    data-value={option.value}
                    aria-pressed={pressed(state[control.id], option.value) ? "true" : "false"}
                  >
                    {option.label}
                  </button>
                ))
              }
            </div>
          </div>
        ),
      )
    }
  </div>
  <p class="chart-demo__play"><a data-demo-play href={play}>Open in playground</a></p>
    </div>
  </div>
</div>

<script>
  import { mountChartDemo } from "../scripts/chart-demo";

  mountChartDemo();
</script>
