---
import BrandLockup from "./BrandLockup.astro";

const columns = [
  {
    label: "Product",
    links: [
      { href: "/cloud", label: "Cloud" },
      { href: "/pricing", label: "Pricing" },
      { href: "/dashboard", label: "Dashboard" },
      { href: "/examples", label: "Examples" },
      { href: "/gallery", label: "Gallery" },
      { href: "/showcase", label: "Showcase" },
    ],
  },
  {
    label: "Docs",
    links: [
      { href: "/docs", label: "Overview" },
      { href: "/docs/charts", label: "Chart types" },
      { href: "/docs/spec", label: "Spec" },
      { href: "/docs/theming", label: "Theming" },
      { href: "/docs/migrate", label: "Migrate" },
    ],
  },
  {
    label: "Agents",
    links: [
      { href: "/agents", label: "Overview" },
      { href: "/docs/validate", label: "Validate and repair" },
      { href: "/llms.txt", label: "llms.txt" },
      { href: "/docs/mcp", label: "MCP" },
      { href: "/benchmarks", label: "Benchmarks" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <BrandLockup />
      <p class="footer-pitch">Ship the chart, not the chart code.</p>
    </div>
    <div class="footer-cols">
      {
        columns.map((column) => (
          <nav aria-label={column.label}>
            <h2>{column.label}</h2>
            {column.links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </nav>
        ))
      }
    </div>
  </div>
  <p class="legal">© ChartKit. MIT license. chartkit.dev still serves the Next.js app while this site is in review.</p>
</footer>

<script>
  import { colorizePage } from "../scripts/color-code";

  colorizePage();
</script>
