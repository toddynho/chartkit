---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import BrandLockup from "./BrandLockup.astro";
import { SITE, canonicalPath } from "../data/site";
import { repoRoot } from "../lib/repo-root";

const docs = canonicalPath(Astro.url.pathname) === "/docs" || canonicalPath(Astro.url.pathname).startsWith("/docs/");
const license = `${SITE.github}/blob/main/LICENSE`;

const featureFile = JSON.parse(readFileSync(join(repoRoot(), "catalog/public/features.json"), "utf8")) as {
  libraries: { name: string }[];
};
const otherLibraries = featureFile.libraries.filter((library) => library.name !== "ChartKit").length;
if (otherLibraries < 1) throw new Error("feature matrix has no libraries besides ChartKit");

const columns = [
  {
    label: "Product",
    links: [
      { href: "/cloud", label: "Cloud" },
      { href: "/dashboards", label: "Dashboards" },
      { href: "/gallery", label: "Gallery" },
      { href: "/cloud#pricing", label: "Pricing" },
    ],
  },
  {
    label: "Docs",
    links: [
      { href: "/docs", label: "Overview" },
      { href: "/docs/spec", label: "Spec" },
      { href: "/docs/charts", label: "Chart types" },
      { href: "/docs/theming", label: "Theming" },
    ],
  },
  {
    label: "Agents",
    links: [
      { href: "/docs/validate", label: "Validate and repair" },
      { href: "/docs/mcp", label: "MCP" },
      { href: "/llms.txt", label: "llms.txt" },
      { href: "/benchmarks", label: "Benchmarks" },
    ],
  },
];
---

<footer class:list={["site-footer", docs && "site-footer--docs"]}>
  {
    docs ? (
      <p class="legal legal--docs">
        <span class="legal__meta">
          © ChartKit · <a href={license}>MIT</a> · {SITE.version}
          <span aria-hidden="true"> · </span>
          <a class="legal__credit" href="https://x.com/toddo">built by @toddo</a>
        </span>
        <span class="legal__end">
          <a href={SITE.github}>GitHub</a>
          <a href="/llms.txt">llms.txt</a>
          <a href={`${SITE.github}/releases`}>Changelog</a>
          <a href="/compare">Compare</a>
        </span>
      </p>
    ) : (
      <>
        <div class="footer-grid">
          <div class="footer-brand">
            <BrandLockup size={40} layout="stack" />
            <p class="footer-pitch">
              <span>One spec.</span>
              <span>Every framework.</span>
              <span>Built for agents.</span>
            </p>
          </div>
          {
            columns.map((column) => (
              <nav aria-label={column.label}>
                <h2>{column.label}</h2>
                {column.links.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </nav>
            ))
          }
        </div>
        <p class="legal">
          <span class="legal__meta">
            © ChartKit · <a href={license}>MIT</a> · {SITE.version}
            <span aria-hidden="true"> · </span>
            <a class="legal__credit" href="https://x.com/toddo">built by @toddo</a>
          </span>
        </p>
        <p class="legal-compare">
          <a href="/compare">Compare ChartKit with {otherLibraries} other libraries →</a>
        </p>
      </>
    )
  }
</footer>

<script>
  import { colorizePage } from "../scripts/color-code";

  colorizePage();
</script>
