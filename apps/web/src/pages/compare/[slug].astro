---
import "../../styles/ck.css";
import "../../styles/compare.css";
import { validate } from "@chartkitdev/core/validate";
import { samples } from "@chartkitdev/convert";
import Base from "../../layouts/Base.astro";
import { loadCompare, loadCompareIndex } from "../../lib/batch3";

export function getStaticPaths() {
  return loadCompareIndex().rivals.map(({ library }) => ({ params: { slug: library.id } }));
}

const page = loadCompare(Astro.params.slug ?? "");
const library = page.library;
const count = loadCompareIndex().rivals.length;
const converters = new Set(["chartjs", "recharts", "echarts"]);
const hasConverter = converters.has(library.id);
const sample = samples.find((item) => item.id === library.id);

const groups = [
  { id: "win", label: "ChartKit ahead", rows: page.win, note: "ChartKit scores higher." },
  { id: "tie", label: "Same", rows: page.tie, note: "Both score the same." },
  { id: "loss", label: `${library.name} ahead`, rows: page.loss, note: "The other library scores higher. Shown in grey, not featured." },
  { id: "unk", label: "Unknown", rows: page.unknown, note: "Unknown is not a win." },
];
const total = page.counts.win + page.counts.tie + page.counts.loss + page.counts.unknown;

function rank(value: string): string {
  const known = ["native", "partial", "plugin", "manual", "none", "unknown", "warns"];
  return known.includes(value) ? value : "unknown";
}

const lineBytes = 32110;
const theirBytes = library.bundleGzip?.minimalLine ?? null;
const hoverPainted: Record<string, number> = {
  uplot: 16.2,
  chartjs: 20.3,
  plot: 28.3,
  recharts: 28.9,
  echarts: 2881.4,
};
const theirHover = hoverPainted[library.id];
const ssrNote =
  library.id === "recharts"
    ? "Recharts 3 SSR returns no SVG except sunburst."
    : library.id === "chartjs" || library.id === "uplot"
      ? `${library.name} has no Node SVG path in that run.`
      : null;

const nine = {
  version: "1",
  type: "bar",
  data: [
    { region: "North", sales: 40 },
    { region: "South", sales: 55 },
    { region: "East", sales: 32 },
    { region: "West", sales: 48 },
  ],
  encoding: { x: "region", y: "sales" },
  a11y: { alt: "South has the highest sales across all regions." },
};
const nineChecked = validate(nine);
if (nineChecked.errors.length) throw new Error(`nine-line spec failed validate: ${nineChecked.errors.map((error) => error.code).join(", ")}`);
const nineText = `{
  "version": "1", "type": "bar",
  "data": [
    { "region": "North", "sales": 40 }, { "region": "South", "sales": 55 },
    { "region": "East", "sales": 32 }, { "region": "West", "sales": 48 }
  ],
  "encoding": { "x": "region", "y": "sales" },
  "a11y": { "alt": "South has the highest sales across all regions." }
}`;
if (nineText.split("\n").length !== 9) throw new Error("playground spec is not 9 lines");

const description = `ChartKit vs ${library.name}. ${page.counts.win} ahead, ${page.counts.tie} the same, ${page.counts.loss} behind, ${page.counts.unknown} unknown.`;
---

<Base title={`ChartKit vs ${library.name}`} description={description} tone="light">
  <div class="ck ck-wrap" data-pair data-source={library.id} data-sample={sample?.source ?? ""}>
    <section class="cmp-hero">
      <div class="cmp-copy">
        <p class="cmp-crumb"><a href="/compare">Compare</a> / {library.name}</p>
        <h1 class="ck-h1">ChartKit vs {library.name}</h1>
        <p class="ck-lede">
          Feature-by-feature against {library.name} {library.version}, checked {library.dateChecked}. Rank order is native › partial › plugin › manual › none. Unknown is not a win.
        </p>
        <div class="cmp-cta">
          {
            hasConverter ? (
              <a class="ck-btn" href="#convert">Convert from {library.name}</a>
            ) : (
              <a class="ck-btn" href={`/playground#${encodeURIComponent(JSON.stringify(nine))}`}>Open in Playground</a>
            )
          }
          <a class="ck-link" href="/benchmarks">Full timings →</a>
        </div>
        <p class="cmp-fine">
          ChartKit rechecked {page.chartkitRechecked} on {page.chartkitCommit.slice(0, 8)}. Losses stay in the table. They are not the default tab.
        </p>
      </div>
      <div class="ck-panel cmp-card cmp-hero__card">
        <div class="ck-bar ck-bar--light">
          <span>chartkit vs {library.id} · {total} rows</span>
          <span>{library.name} {library.version} · {library.license}</span>
        </div>
        <div class="cmp-cells">
          <button type="button" class="cmp-cell is-on" data-jump="win"><span class="cmp-cell__k">Ahead</span><span class="cmp-cell__v is-ahead">{page.counts.win}</span></button>
          <button type="button" class="cmp-cell" data-jump="tie"><span class="cmp-cell__k">Same</span><span class="cmp-cell__v">{page.counts.tie}</span></button>
          <button type="button" class="cmp-cell" data-jump="loss"><span class="cmp-cell__k">Behind</span><span class="cmp-cell__v is-behind">{page.counts.loss}</span></button>
          <button type="button" class="cmp-cell" data-jump="unk"><span class="cmp-cell__k">Unknown</span><span class="cmp-cell__v is-unknown">{page.counts.unknown}</span></button>
        </div>
        <div class="cmp-mix">
          <div class="ck-mix" aria-hidden="true">
            <i class="is-ahead" style={`width:${(page.counts.win / total) * 100}%`}></i>
            <i class="is-same" style={`width:${(page.counts.tie / total) * 100}%`}></i>
            <i class="is-behind" style={`width:${(page.counts.loss / total) * 100}%`}></i>
            <i class="is-unknown" style={`width:${(page.counts.unknown / total) * 100}%`}></i>
          </div>
        </div>
        <div class="ck-foot">
          <span>Line chart · gzip <strong>{(lineBytes / 1000).toFixed(1)} KB</strong>{theirBytes == null ? "" : ` vs ${(theirBytes / 1000).toFixed(1)} KB`}</span>
          <span>Escape hatch {library.escapeHatch}</span>
        </div>
      </div>
    </section>

    <section class="ck-section" id="rows">
      <div class="ck-head">
        <p class="ck-eye">Rows</p>
        <h2 class="ck-h2">Every scored feature, both answers.</h2>
        <p class="ck-sub">ChartKit ahead is the default. Behind is one click away, in grey.</p>
      </div>
      <div class="ck-panel">
        <div class="ck-tabs cmp-tabs">
          {
            groups.map((group) => (
              <button type="button" class:list={["ck-tab", group.id === "win" && "is-on"]} data-bucket={group.id} role="tab">
                {group.label} <span class="ck-badge">{group.rows.length}</span>
              </button>
            ))
          }
          <input class="cmp-filter" type="search" placeholder="Filter features…" aria-label="Filter features" data-filter />
        </div>
        <div class="cmp-table">
          <div class="cmp-grid is-head">
            <span>Feature</span><span>ChartKit</span><span>{library.name}</span><span>Their option</span><span>Check</span><span>Source</span>
          </div>
          {
            groups.flatMap((group) =>
              group.rows.map((row) => (
                <div class="cmp-grid" data-row data-bucket={group.id} data-label={row.label.toLowerCase()} hidden={group.id !== "win"}>
                  <a class="cmp-feat" href={`/features/${row.id}`}>{row.label}</a>
                  <span><span class={`ck-rank ck-rank--${rank(row.ours)}`}>{row.ours}</span></span>
                  <span><span class={`ck-rank ck-rank--${rank(row.theirs)}`}>{row.theirs}</span></span>
                  <span class="cmp-opt" title={row.option}>{row.option}</span>
                  <span class:list={["cmp-check", row.strength === "strong" && "is-strong", row.strength === "weak" && "is-weak"]}>{row.verified} · {row.strength}</span>
                  <span class="cmp-src" title={row.source}>{row.source}</span>
                </div>
              )),
            )
          }
          <p class="cmp-empty" data-empty hidden>No features match.</p>
        </div>
        <div class="ck-foot">
          <span data-showing>Showing {page.counts.win} of {total} · {groups[0]?.note}</span>
          <span>native › partial › plugin › manual › none</span>
        </div>
      </div>
    </section>

    <section class="ck-section">
      <div class="ck-head">
        <p class="ck-eye">Measured</p>
        <h2 class="ck-h2">Beyond the feature count.</h2>
        <p class="ck-sub">Only figures this site already publishes. A missing panel means we do not have that number for {library.name}.</p>
      </div>
      <div class="cmp-metrics">
        {
          theirBytes != null ? (
            <article class="ck-panel">
              <div class="ck-bar ck-bar--light"><span>line gzip</span><span>bench bundle</span></div>
              <div class="cmp-metric__pair">
                <div class="is-us"><b>{(lineBytes / 1000).toFixed(1)}</b><span>KB · ChartKit</span></div>
                <div><b>{(theirBytes / 1000).toFixed(1)}</b><span>KB · {library.name}</span></div>
              </div>
              <p>ChartKit is {lineBytes.toLocaleString("en-US")} bytes, measured 2026-10-29. {library.name} minimal line is {theirBytes.toLocaleString("en-US")} bytes{library.bundleGzip?.measured ? `, ${library.bundleGzip.measured}` : ""}.</p>
            </article>
          ) : null
        }
        {
          theirHover != null ? (
            <article class="ck-panel">
              <div class="ck-bar ck-bar--light"><span>steady hover · 100k</span><span>round 13</span></div>
              <div class="cmp-metric__pair">
                <div class="is-us"><b>16.5</b><span>ms · ChartKit</span></div>
                <div><b>{theirHover}</b><span>ms · {library.name}</span></div>
              </div>
              <p>Painted median. Round 13, 2026-10-18, phase 2 d8dcc5a.</p>
            </article>
          ) : null
        }
        {
          ssrNote ? (
            <article class="ck-panel">
              <div class="ck-bar ck-bar--light"><span>SSR · 100k line</span><span>phase 4</span></div>
              <div class="cmp-metric__pair">
                <div class="is-us"><b>2.63</b><span>ms · ChartKit</span></div>
                <div><b>—</b><span>{library.name}</span></div>
              </div>
              <p>{ssrNote} ChartKit median is 2.63 ms. The mean on the same run is 2.7 ms.</p>
            </article>
          ) : null
        }
      </div>
      <p class="cmp-note">{page.perf} {page.size}</p>
    </section>

    {
      hasConverter && sample ? (
        <section class="ck-section cmp-end" id="convert">
          <div class="ck-head">
            <p class="ck-eye">Convert</p>
            <h2 class="ck-h2">Bring the {library.name} chart you already have.</h2>
            <p class="ck-sub">The paste stays in the browser. Copy the spec, or open the full result on /convert.</p>
          </div>
          <div class="ck-split ck-split--start" data-mini>
            <div class="ck-panel ck-panel--dark cmp-paste">
              <div class="ck-bar"><span>paste · {library.id}</span><span data-lines>{sample.source.split("\n").length} lines</span></div>
              <textarea spellcheck="false" aria-label={`${library.name} sample`} data-paste>{sample.source}</textarea>
              <div class="ck-foot"><span>Nothing is uploaded.</span><button type="button" class="cmp-load" data-load>Load sample</button></div>
            </div>
            <div class="ck-panel">
              <div class="ck-bar ck-bar--light">
                <span data-state style="color:#1a7f4b">● valid</span>
                <span data-warns>0 warnings</span>
              </div>
              <pre class="cmp-spec" data-spec></pre>
              <ul class="cmp-warns" data-warn-list></ul>
              <div class="ck-foot">
                <button type="button" class="ck-btn" data-copy>Copy spec</button>
                <a class="ck-link" data-open href={`/convert?source=${library.id}`}>Open full result →</a>
              </div>
            </div>
          </div>
        </section>
      ) : (
        <section class="ck-section cmp-end">
          <div class="cmp-close">
            <div>
              <p class="ck-eye">Switch</p>
              <h2 class="ck-h2">No {library.name} converter yet. The spec is nine lines.</h2>
              <p class="ck-sub">There is no paste converter for {library.name}. This bar spec passes validate(). Open it in the playground, or pick a library that does convert.</p>
              <div class="cmp-cta">
                <a class="ck-btn" href={`/playground#${encodeURIComponent(JSON.stringify(nine))}`}>Open in Playground</a>
                <a class="ck-link" href="/compare">All {count} libraries →</a>
              </div>
            </div>
            <div class="ck-panel">
              <div class="ck-bar ck-bar--light"><span style="color:#1a7f4b">● spec.json · 9 lines</span><span>validate() ok</span></div>
              <pre class="cmp-spec">{nineText}</pre>
            </div>
          </div>
        </section>
      )
    }
  </div>
  <script>
    import { mountComparePair } from "../../scripts/compare-pair";
    mountComparePair();
  </script>
</Base>
