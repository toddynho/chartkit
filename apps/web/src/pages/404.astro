---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="That URL is not on chartkit.dev.">
  <div class="wrap missing">
    <p class="kicker">404</p>
    <h1>That page is not here.</h1>
    <p class="lede">Docs, the spec, and llms.txt are on this site. Older component URLs redirect when a chart page exists.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-secondary" href="/docs">Docs</a>
      <a class="btn btn-secondary" href="/docs/migrate">Upgrading from v0</a>
    </div>
  </div>
</Base>
