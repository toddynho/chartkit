---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page is not on the ChartKit Astro scaffold.">
  <div class="wrap missing">
    <p class="kicker">404</p>
    <h1>That page is not in the scaffold.</h1>
    <p class="lede">The Next.js docs still have pages this app has not moved yet.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-secondary" href="/docs">Docs</a>
      <a class="btn btn-secondary" href="https://chartkit.dev">Live site</a>
    </div>
  </div>
</Base>
