---
import "@fontsource/roboto/latin-400.css";
import "@fontsource/roboto/latin-500.css";
import "@fontsource/roboto/latin-700.css";
import "../../styles/surfaces.css";
import Base from "../../layouts/Base.astro";
import { loadIndex } from "../../lib/dashboards";
import { loadShowcaseIndex } from "../../lib/surfaces";

const dashboards = loadIndex().boards;
const boards = loadShowcaseIndex().boards;
const description =
  "Thirty ChartKit boards, from one spec on every stack through a cellar treemap, a sunburst, a kiln firing, and a radio desk.";
---

<Base title="Showcase" description={description} tone="light">
  <div class="wrap surface">
    <header class="hero">
      <p class="kicker">Showcase</p>
      <h1>Showcase</h1>
      <p class="lede">
        Thirty boards. A cellar treemap beside its sunburst, a yard of hours, a market fortnight, and a community-radio
        desk sit with range bands, floating bars, whiskers, a zoned hour axis, and a custom element. Specs are checked
        before the page builds. The sample data is fictional.
      </p>
    </header>
    <h2>Dashboards</h2>
    <p class="lede">
      Ten boards, styled after familiar dashboards. Colour comes from theme.tokens. Fonts are Inter or Roboto. ChartKit
      is not affiliated with or endorsed by those products.
    </p>
    <div class="gallery-index">
      {
        dashboards.map((board) => (
          <a class:list={["card", board.defaultTheme === "midnight" && "cover-night"]} href={`/dashboards/${board.slug}`}>
            <p class="kicker">{board.defaultTheme === "midnight" ? "Dark first" : "Soft first"}</p>
            <h2>{board.title}</h2>
            <p>{board.lede}</p>
            <div class="cover-frame" role="img" aria-label={board.coverAlt} set:html={board.coverSvg} />
          </a>
        ))
      }
    </div>
    <h2>Boards</h2>
    <div class="gallery-index">
      {
        boards.map((board) => (
          <a class="card" href={`/showcase/${board.slug}`}>
            <p class="kicker">{String(board.number).padStart(2, "0")}</p>
            <h2>{board.title}</h2>
            <p>{board.lede}</p>
            {board.coverSvg ? <div class="cover-frame" role="img" aria-label={board.coverAlt} set:html={board.coverSvg} /> : null}
            {board.repairSvg ? <div class="cover-frame" role="img" aria-label={board.repairAlt} set:html={board.repairSvg} /> : null}
          </a>
        ))
      }
    </div>
  </div>
</Base>
