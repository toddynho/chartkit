---
import "../styles/v2.css";
import "../styles/ck.css";
import "../styles/agents.css";
import { validate, repair } from "@chartkitdev/core/validate";
import Base from "../layouts/Base.astro";
import { agentWrote } from "../data/agent-wrote";
import { agentsPrompt } from "../data/agent-prompt";
import { chartkitCloudUrl } from "../data/cloud-url";
import { proofFigures } from "../data/home-bench";
import {
  TOKEN_EVAL,
  TOKEN_LIBRARIES,
  formatEvalDate,
  formatTokens,
  tokenScoreboard,
  tokenSpread,
} from "../data/token-eval";
import { paintSpec } from "../lib/chartkit";
import { kb } from "../lib/line-gzip";
import { countO200k } from "../lib/o200k";

const wrote = agentWrote();
const proof = proofFigures();
const spread = tokenSpread();
const board = tokenScoreboard();
const promptTokens = countO200k(agentsPrompt);
const runDate = formatEvalDate(wrote.measured);
const chartkitRow = spread.rows.find((row) => row.us);
const nextRow = spread.rows.find((row) => !row.us);
if (!chartkitRow || !nextRow || !spread.annotation) throw new Error("agents spread is missing a row");

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === "object" && value !== null && !Array.isArray(value);
}

/** Same JSON as the recorded answer, with data rows paired so the card stays short. */
function displaySpec(code: string): { text: string; alt: string; title: string; spec: unknown } {
  const spec = JSON.parse(code) as unknown;
  if (!isRecord(spec) || !Array.isArray(spec.data)) {
    return { text: code, alt: "", title: "", spec };
  }
  const rows = spec.data.map((row) => JSON.stringify(row).replaceAll('":', '": ').replaceAll(',"', ', "'));
  const paired: string[] = [];
  for (let i = 0; i < rows.length; i += 2) {
    const next = rows[i + 1];
    paired.push(next ? `    ${rows[i]}, ${next}` : `    ${rows[i]}`);
  }
  const alt = isRecord(spec.a11y) && typeof spec.a11y.alt === "string" ? spec.a11y.alt : "";
  const encoding = isRecord(spec.encoding) ? spec.encoding : {};
  const y = typeof encoding.y === "string" ? encoding.y : "";
  const x = typeof encoding.x === "string" ? encoding.x : "";
  const title =
    typeof spec.title === "string" && spec.title
      ? spec.title
      : y && x
        ? `${y.charAt(0).toUpperCase()}${y.slice(1)} by ${x}`
        : "Rendered chart";
  const text = `{
  "version": ${JSON.stringify(spec.version)}, "type": ${JSON.stringify(spec.type)},
  "data": [
${paired.join(",\n")}
  ],
  "encoding": ${JSON.stringify(spec.encoding)},
  "a11y": { "alt": ${JSON.stringify(alt)} }
}`;
  return { text, alt, title, spec };
}

const shown = displaySpec(wrote.chartkit.code);
const painted = paintSpec(shown.spec);
if (!painted.ok || !painted.svg.includes("<svg")) {
  throw new Error(`Recorded agent spec did not render: ${painted.footer}`);
}
const svgBytes = new TextEncoder().encode(painted.svg).length;
const svgLabel = `svg · ${kb(svgBytes)}`;
const callsLabel = `${wrote.chartkit.tokens.toLocaleString("en-US")} tok · ${wrote.chartkit.calls} ${wrote.chartkit.calls === 1 ? "call" : "calls"}`;
const bothFirst = wrote.chartkit.firstTry && wrote.recharts.firstTry;
const barMax = Math.max(wrote.chartkit.tokens, wrote.recharts.tokens);

const example = {
  version: "1",
  type: "bar",
  data: [
    { month: "Jan", signups: 72 },
    { month: "Feb", signups: 98 },
  ],
  encoding: { x: "month", y: "signup" },
};
const exampleErrors = validate(example).errors.slice(0, 2);
const exampleFixed = repair(example);
const examplePaint = paintSpec(exampleFixed.spec);
if (!examplePaint.ok || !examplePaint.svg.includes("<svg")) {
  throw new Error("Example repair did not render");
}
const exampleSvg = kb(new TextEncoder().encode(examplePaint.svg).length);
type Patch = { op: string; path: string; value?: unknown };
const patches = (exampleFixed.applied as Patch[]).slice(0, 4);

const origin = chartkitCloudUrl();
const schemaUrl = "https://chartkit.dev/schema/v1.json";
const kit = [
  {
    name: "llms.txt",
    where: "one line in the system prompt",
    body: "The model fetches it once. Rules, the repair loop, one example spec per chart type.",
    snippet: "Read https://chartkit.dev/llms.txt before writing any chart.",
  },
  {
    name: "schema/v1.json",
    where: "OpenAI structured output",
    body: `The schema is served at ${schemaUrl}. OpenAI structured output inlines that document as json_schema.schema. It does not take a schema URL.`,
    snippet: `// OpenAI response_format. schema is the document at ${schemaUrl}
response_format: {
  type: "json_schema",
  json_schema: {
    name: "chartspec",
    strict: true,
    schema,
  },
}`,
  },
  {
    name: "validate() / repair()",
    where: "your tool handler",
    body: "Every error in one pass. repair() applies the safe fixes and does not call a model.",
    snippet: `import { validate, repair } from "@chartkitdev/core/validate";

const result = validate(spec);
if (!result.ok) spec = repair(spec).spec;`,
  },
  {
    name: "MCP",
    where: "claude_desktop_config.json, .cursor/mcp.json",
    body: "stdio server. validate, repair and render stay local. render_chart calls Cloud.",
    snippet: `{
  "mcpServers": {
    "chartkit": {
      "command": "npx",
      "args": ["-y", "@chartkitdev/mcp"]
    }
  }
}`,
  },
  {
    name: "Cloud",
    where: "when the host cannot draw",
    body: "POST /render returns JSON, not the file: svg or base64 png, plus url. GET /render returns the file.",
    snippet: `const res = await fetch("${origin}/render", {
  method: "POST",
  headers: { "content-type": "application/json" },
  body: JSON.stringify({ spec, format: "svg" }),
});
const body = await res.json(); // body.svg, or base64 body.png; body.url`,
    span: true,
  },
];

const steps = [
  {
    n: "01",
    tag: "1 call",
    title: "The agent writes a spec",
    body: 'version is "1". data is an array of rows. a11y.alt is one factual sentence. Gauge, kpi and progress-ring put the number in metric.',
    code: "spec.json · model",
    on: true,
  },
  {
    n: "02",
    tag: "0 calls",
    title: "validate()",
    body: "Checks the schema and the data. Every CK code comes back in one pass: CK1001 is invalid JSON, CK1004 a missing required field.",
    code: "validate(spec) · local",
    on: false,
  },
  {
    n: "03",
    tag: "0 calls",
    title: "repair()",
    body: "Returns a spec and the JSON Patch it applied. Never invents a data value. A missing or unknown type is reported first.",
    code: "repair(spec) · local",
    on: false,
  },
  {
    n: "04",
    tag: "0 calls",
    title: "render()",
    body: "Core charts come from @chartkitdev/core/all. Histogram through the planning charts come from @chartkitdev/core/extra. render() does not validate and does not throw. No host? POST the spec to Cloud.",
    code: "render(spec) · local or cloud",
    on: false,
  },
];

const tableRows = TOKEN_EVAL.models.flatMap((model) => {
  if (!model.tokens) return [];
  const tokens = model.tokens;
  const nums = TOKEN_LIBRARIES.map((library) => tokens[library]);
  const rowMax = Math.max(...nums);
  return [
    {
      name: model.group === "Claude" ? `Claude ${model.name}` : model.name,
      cells: TOKEN_LIBRARIES.map((library) => ({
        text: formatTokens(tokens[library]),
        us: library === "ChartKit",
        width: `${((tokens[library] / rowMax) * 100).toFixed(1)}%`,
      })),
      notes: model.coverage ?? [],
    },
  ];
});
const versusFor = new Map(board.rows.map((row) => [row.name, row.versus]));

const description = `Point an agent at ChartKit. On the published with-docs run, median output tokens are ${chartkitRow.range} by model, ${spread.headline}× fewer than ${nextRow.name}, in ${spread.calls} model calls.`;
const taskLine = bothFirst
  ? `The recorded ${wrote.task} answer from ${wrote.model} on ${runDate}. Both libraries rendered on the first call.`
  : `The recorded ${wrote.task} answer from ${wrote.model} on ${runDate}.`;
---

<Base tone="light" title="Agents" description={description}>
  <div class="ck ck-wrap agents-page">
    <p class="sr" data-agent-prompt>{agentsPrompt}</p>

    <section class="agents-hero" id="wrote">
      <div class="agents-copy">
        <p class="ck-eye">Agents</p>
        <h1 class="ck-h1">If your agent draws charts, point it here.</h1>
        <p class="ck-lede">
          Set ChartKit as the default in your harness. The model writes a short spec. Validate, repair and render need no model at all.
        </p>
        <div class="ck-panel agents-prompt">
          <div class="ck-bar ck-bar--light"><span>the prompt</span><span>{promptTokens} tok</span></div>
          <div class="agents-prompt__body">{agentsPrompt}</div>
        </div>
        <div class="agents-cta">
          <button type="button" class="ck-btn" data-copy-prompt data-idle="Copy the prompt" data-done="Copied the prompt ✓">
            Copy the prompt
          </button>
          <a class="ck-link" href="#default">llms.txt, schema, MCP ↓</a>
        </div>
        <p class="agents-fine">Works in a system prompt, CLAUDE.md, .cursorrules or an MCP config.</p>
      </div>

      <div class="ck-panel agents-result agents-hero__card">
        <div class="agents-result__wrote">
          <div class="ck-bar">
            <span>request · what the agent wrote</span>
            <span class="agents-pill">{callsLabel}</span>
          </div>
          <pre>{shown.text}</pre>
        </div>
        <div class="ck-bar ck-bar--light">
          <span class="agents-ok">● response · {wrote.chartkit.firstTry ? "rendered first try" : "rendered"}</span>
          <span>{svgLabel}</span>
        </div>
        <div class="agents-drew">
          <div>
            <div class="agents-chart__title">{shown.title}</div>
            <div class="agents-chart__svg" set:html={painted.svg} />
          </div>
          <div class="agents-alt">
            <div class="agents-alt__k">a11y.alt</div>
            {shown.alt}
          </div>
        </div>
      </div>
    </section>

    <section class="ck-section" id="proof">
      <div class="ck-head">
        <p class="ck-eye">Proof</p>
        <h2 class="ck-h2">Fewest tokens per working chart.</h2>
        <p class="ck-sub">
          Median across {spread.tasks} tasks and {spread.modelWord} models, docs in context. Each dot is one model; the tick is the median.
        </p>
      </div>

      <div class="ck-panel" style="margin-bottom:20px">
        <div class="ck-bar ck-bar--light">
          <span>benchmark · round 6 · {runDate}</span>
          <span>{TOKEN_EVAL.tasks} tasks · {spread.modelCount} models</span>
        </div>
        <div class="agents-stats">
          <article class="agents-stat">
            <div class="agents-stat__k">Output tokens, this task</div>
            <div class="agents-stat__v" style="color:#0a63e6">
              <strong>{wrote.chartkit.tokens.toLocaleString("en-US")}</strong>
              <span>vs {wrote.recharts.tokens.toLocaleString("en-US")}</span>
            </div>
            <div class="agents-stat__viz">
              <div class="agents-pair">
                <div>
                  <i style={`width:${((wrote.chartkit.tokens / barMax) * 70).toFixed(1)}%;background:#0a63e6`}></i>
                  <span>ChartKit</span>
                </div>
                <div>
                  <i style={`width:${((wrote.recharts.tokens / barMax) * 70).toFixed(1)}%;background:#c9c9c5`}></i>
                  <span>Recharts</span>
                </div>
              </div>
            </div>
            <p>{taskLine}</p>
          </article>
          <article class="agents-stat">
            <div class="agents-stat__k">First-try validity</div>
            <div class="agents-stat__v">
              <strong>{proof.officialFirst}</strong><span>/ {proof.tasks}</span>
            </div>
            <div class="agents-stat__viz" aria-hidden="true">
              <div class="agents-cells">
                {Array.from({ length: proof.tasks }, (_, index) => (
                  <i class:list={[index < proof.officialFirst && "is-on"]} />
                ))}
              </div>
            </div>
            <p>First call with the library docs in the prompt. {wrote.model}, {runDate}.</p>
          </article>
          <article class="agents-stat">
            <div class="agents-stat__k">Model calls per chart</div>
            <div class="agents-stat__v">
              <strong>{spread.calls}</strong><span>median</span>
            </div>
            <div class="agents-stat__viz" aria-hidden="true">
              <div class="agents-calls">
                <b class="is-on">model</b><span>›</span><b>validate</b><span>›</span><b>repair</b><span>›</span><b>render</b>
              </div>
            </div>
            <p>ChartKit's median on a working chart, across {spread.modelCount} models. validate, repair and render do not add a call.</p>
          </article>
        </div>
      </div>

      <div class="ck-panel">
        <div class="ck-bar ck-bar--light">
          <span>output tokens per working chart</span>
          <span>median · range</span>
        </div>
        <div class="agents-plot-pad">
          <div class="agents-strip">
            {
              spread.rows.map((row) => (
                <div class:list={["agents-strip__row", row.us && "is-us", row.us && "is-first"]}>
                  <div class="agents-strip__name">{row.name}</div>
                  <div class="agents-plot">
                    <div class="agents-rail"></div>
                    <div class="agents-band" style={`left:${row.minPct};width:${row.spanPct}`}></div>
                    {row.dots.map((dot) => <span class="agents-dotplot" title={dot.title} style={`left:${dot.left}`}></span>)}
                    <div class="agents-med" style={`left:${row.medPct}`}></div>
                    {row.us && spread.annotation ? (
                      <>
                        <div class="agents-bracket" style={`left:${spread.annotation.left};width:${spread.annotation.width}`}><span></span></div>
                        <div class="agents-anno" style={`left:${spread.annotation.labelLeft}`}>{spread.annotation.text}</div>
                      </>
                    ) : null}
                  </div>
                  <div class="agents-strip__val">
                    <strong>{row.medianText}</strong><em>{row.range}</em>
                  </div>
                </div>
              ))
            }
          </div>
          <div class="agents-axis" aria-hidden="true">
            <div></div>
            <div><span>0</span><span>500</span><span>1,000</span><span>1,500</span><span>2,000 tok</span></div>
            <div></div>
          </div>
          <div class="agents-table-wrap" id="token-table" data-token-table hidden>
            <table class="agents-table">
              <caption class="sr">Median output tokens per working chart by model. Every cell is a published figure.</caption>
              <thead>
                <tr>
                  <th scope="col">Model</th>
                  {TOKEN_LIBRARIES.map((library) => <th class:list={[library === "ChartKit" && "is-us"]} scope="col">{library}</th>)}
                  <th scope="col">vs next best</th>
                </tr>
              </thead>
              <tbody>
                {tableRows.map((row) => (
                  <tr>
                    <th scope="row">{row.name}</th>
                    {row.cells.map((cell) => (
                      <td class:list={[cell.us && "is-us"]}>
                        {cell.text}
                        <span class="track"></span>
                        <span class="bar" style={`width:calc((100% - 20px) * ${parseFloat(cell.width) / 100})`}></span>
                      </td>
                    ))}
                    <td>{versusFor.get(row.name)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <div class="agents-notes">
              {tableRows.flatMap((row) => row.notes.map((note) => <p><strong>{row.name}.</strong> {note.text}</p>))}
            </div>
          </div>
        </div>
        <div class="ck-foot">
          <span>
            ChartKit is cheapest on {spread.cheapest} of {spread.cheapestTotal} models. Its median is {chartkitRow.medianText} tokens, {spread.headline}× below {nextRow.name} at {nextRow.medianText}. Docs capped to the length of llms.txt; did-not-finish runs excluded.
            <a href="/methodology/agent-eval"> Methodology →</a>
          </span>
          <button type="button" class="agents-toggle" data-table-toggle data-idle="Show all numbers" data-open="Hide numbers" aria-expanded="false" aria-controls="token-table">
            Show all numbers
          </button>
        </div>
      </div>
    </section>

    <section class="ck-section" id="loop">
      <div class="ck-head">
        <p class="ck-eye">Loop</p>
        <h2 class="ck-h2">Four calls. The model is in one.</h2>
        <p class="ck-sub">The agent writes the spec once. Everything after that is a local function with a deterministic answer.</p>
      </div>
      <div class="ck-split agents-loop">
        <div class="ck-panel">
          <div class="ck-bar ck-bar--light"><span>the loop</span><span>model calls</span></div>
          {steps.map((step) => (
            <div class="agents-step">
              <span class:list={["agents-step__n", step.on && "is-on"]}>{step.n}</span>
              <div>
                <div>
                  <span class="agents-step__title">{step.title}</span>
                  {" "}
                  <code>{step.code}</code>
                </div>
                <p>{step.body}</p>
              </div>
              <span class:list={["agents-tag", step.on && "is-on"]}>{step.tag}</span>
            </div>
          ))}
        </div>
        <div class="ck-panel ck-panel--dark agents-session">
          <div class="ck-bar">
            <span>agent session · task bar-region</span>
            <span>example · not a recorded answer</span>
          </div>
          <div class="agents-term">
            <div class="dim">&gt; model → spec.json</div>
            <div class="dim">&gt; validate(spec)</div>
            {exampleErrors.map((error) => <div class="bad">✕ {error.code} {error.message}</div>)}
            <div class="dim">&gt; repair(spec)</div>
            {patches.map((patch) => (
              <div class="ok">✓ {patch.op} {patch.path}{patch.value !== undefined ? ` ${JSON.stringify(patch.value)}` : ""}</div>
            ))}
            <div class="dim">&gt; render(spec)</div>
            <div>&lt;svg&gt; · {exampleSvg}</div>
          </div>
          <div class="ck-foot">
            0 model calls after the first. Without docs in the prompt, repair() took first-try validity from {proof.repairFrom}/{proof.tasks} to {proof.repairTo}/{proof.tasks}.
          </div>
        </div>
      </div>
    </section>

    <section class="ck-section" id="default">
      <div class="ck-head">
        <p class="ck-eye">Default</p>
        <h2 class="ck-h2">Make ChartKit the default.</h2>
        <p class="ck-sub">Five things the harness can hold. Each is the whole block, in the place it goes.</p>
      </div>
      <div class="ck-split">
        {kit.map((row) => (
          <article class:list={["ck-panel", row.span && "agents-span"]}>
            <div class="ck-bar ck-bar--light"><span>{row.name}</span><span>{row.where}</span></div>
            <div class="agents-kit__body">{row.body}</div>
            <div class="agents-kit__code">
              <pre>{row.snippet}</pre>
              <button type="button" class="agents-kit__copy" data-copy-kit={row.snippet} data-idle="copy" data-done="copied ✓">copy</button>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ck-section agents-end">
      <div class="agents-close">
        <div>
          <h2 class="ck-h2">One paragraph switches your agent to ChartKit.</h2>
          <p class="ck-sub">
            Drop it in the system prompt, CLAUDE.md, .cursorrules or your MCP config. The app stays JavaScript; the agent writes specs, not chart code.
          </p>
          <button type="button" class="ck-btn" data-copy-prompt data-idle="Copy prompt" data-done="Copied ✓">Copy prompt</button>
        </div>
        <div class="ck-panel ck-panel--dark agents-close__panel">
          <div class="ck-bar"><span>system prompt · addition</span><span>{promptTokens} tok</span></div>
          <div class="agents-close__body">{agentsPrompt}</div>
        </div>
      </div>
    </section>
  </div>
  <script>
    import { mountAgentsPage } from "../scripts/agents-copy";
    mountAgentsPage();
  </script>
</Base>
