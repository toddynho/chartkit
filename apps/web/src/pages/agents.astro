---
import "../styles/v2.css";
import Base from "../layouts/Base.astro";
import { agentSwitchPrompt } from "../data/agent-prompt";
import { chartkitCloudUrl } from "../data/cloud-url";
import { proofFigures } from "../data/home-bench";
import { SITE } from "../data/site";
import { tokenScoreboard, tokenSection } from "../data/token-eval";

const proof = proofFigures();
const board = tokenScoreboard();
const tokens = tokenSection();
const cloudUrl = chartkitCloudUrl();
const tokenRange = tokens.stats[0]?.value ?? "";
const tokenTimes = `${tokens.stats[1]?.value ?? ""}${tokens.stats[1]?.suffix ?? ""}`;
const tokenCalls = tokens.stats[2]?.value ?? "";
const description = `If you're building an agent that draws charts, point it at ChartKit. Median output tokens are ${tokenRange} by model, ${tokenTimes} fewer than the next library, in ${tokenCalls} model calls.`;

const steps = [
  {
    n: "01",
    tag: "model",
    title: "Write",
    body: 'version is "1". data is an array of rows. a11y.alt is one factual sentence. Gauge, kpi and progress-ring put the number in metric.',
    code: "spec.json",
  },
  {
    n: "02",
    tag: "no model",
    title: "Validate",
    body: "Checks the schema and the data. Every CK code comes back in one pass: CK1001 is invalid JSON, CK1004 a missing required field.",
    code: "validate(spec)",
  },
  {
    n: "03",
    tag: "no model",
    title: "Repair",
    body: "Returns a spec and the JSON Patch it applied. Never invents data. A missing or unknown type is reported first.",
    code: "repair(spec)",
  },
  {
    n: "04",
    tag: "no model",
    title: "Render",
    body: "Core charts from @chartkitdev/core/all. Histogram through rose, and the planning charts, come from core/extra. render() does not validate and does not throw.",
    code: "render(spec)",
  },
];

const defaults = [
  { href: "/llms.txt", file: "llms.txt", what: "Load this in the harness. Rules, the repair loop, and one spec per chart type." },
  { href: "/schema/v1.json", file: "schema/v1.json", what: "JSON Schema for the spec the agent writes." },
  {
    href: "/docs/validate",
    file: "validate() / repair()",
    what: "Every error in one pass. repair() applies the safe fixes and does not call a model.",
  },
  {
    href: "/docs/mcp",
    file: "MCP",
    what: "stdio server. validate, repair, and render stay local. render_chart calls Cloud. Not on npm yet.",
  },
  {
    href: "/docs/cloud",
    file: "Cloud URL",
    what: `${cloudUrl} — POST /render returns SVG or PNG when the host cannot draw the chart.`,
  },
];
---

<Base tone="light" title="Agents" description={description}>
  <div class="v2">
    <section class="split">
      <div>
        <p class="eyebrow">Agents</p>
        <h1 class="v2-h1 v2-h1--50">If you're building an agent that draws charts, point it here.</h1>
        <p class="v2-lead v2-lead--left">
          For developers and product teams who ship agents. Set ChartKit as the default in the harness. The model writes a spec, once.
        </p>
        <div class="v2-actions">
          <a class="btn-lg" href="/llms.txt">Get llms.txt</a>
          <a class="btn-text" href="#eval">Token scoreboard →</a>
        </div>
      </div>
      <div class="agent-term">
        <header>agent session</header>
        <div class="dim">&gt; validate(spec)</div>
        <div class="bad">✕ CK1004 a11y.alt is required</div>
        <div class="bad">✕ CK1021 encoding.y "signup" not in data</div>
        <div class="dim">&gt; repair(spec)</div>
        <div class="ok">✓ /a11y/alt ← "Signups by month, Jan–Aug"</div>
        <div class="ok">✓ /encoding/y "signup" → "signups"</div>
        <div class="dim">&gt; render(spec)</div>
        <div>&lt;svg viewBox="0 0 640 360"&gt;… 4.1 KB · 0 model calls</div>
      </div>
    </section>

    <section class="agent-block" id="eval" aria-labelledby="eval-title">
      <div class="section-intro">
        <h2 id="eval-title">Output tokens per working chart</h2>
        <p>Median by model, with docs. ChartKit median calls are {board.calls}. Grok 4.7 has not finished.</p>
      </div>
      <div class="compare-table-wrap">
        <table class="compare-table scoreboard">
          <caption class="sr">Median output tokens per working chart. Pending models are marked pending.</caption>
          <thead>
            <tr>
              <th scope="col">Model</th>
              {
                board.libraries.map((library) => (
                  <th class:list={["num", library === "ChartKit" && "us"]} scope="col">
                    {library}
                  </th>
                ))
              }
              <th class="num" scope="col">CK vs next</th>
            </tr>
          </thead>
          <tbody>
            {
              board.rows.map((row) => (
                <tr class:list={[row.pending && "is-pending"]}>
                  <th scope="row">{row.name}</th>
                  {row.cells.map((cell) => (
                    <td class:list={["num", cell.us && "us"]}>{cell.text}</td>
                  ))}
                  <td class="num">{row.versus}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="token-note">
        {board.tasks} tasks. Each library's docs are capped to the length of ChartKit <a href="/llms.txt">llms.txt</a>. Output tokens are summed until a chart is drawn. Did-not-finish runs are excluded from the median. ChartKit median model calls are {board.calls}; <code>repair()</code> does not add a model call. Harness tip <a href={`${SITE.github}/pull/${board.pr}`}>PR #{board.pr}</a>, commit <a href={`${SITE.github}/commit/${board.sha}`}>{board.sha}</a>.
        The homepage bars are the median of these finished rows. Grok 4.7 stays pending until that run lands.
      </p>
    </section>

    <section class="agent-block" aria-labelledby="default-title">
      <div class="section-intro">
        <h2 id="default-title">Make ChartKit the default</h2>
        <p>Put these in the harness that already ships your agent. The model writes a spec, not chart code.</p>
      </div>
      <article class="plain-card defaults">
        {
          defaults.map((item) => (
            <a class="give-row" href={item.href}>
              <strong>{item.file}</strong>
              <span>{item.what}</span>
            </a>
          ))
        }
      </article>
    </section>

    <section class="agent-block" aria-labelledby="loop-title">
      <div class="section-intro">
        <h2 id="loop-title">The loop</h2>
        <p>Four calls. The model is only in the first one.</p>
      </div>
      <div class="loop-grid">
        {
          steps.map((step) => (
            <article class="loop-card">
              <header>
                <span class="step-n">{step.n}</span>
                <span class:list={["tag", step.tag === "model" ? "tag--model" : "tag--none"]}>{step.tag}</span>
              </header>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              <code class="chip-code">{step.code}</code>
            </article>
          ))
        }
      </div>
    </section>

    <p class="token-note lab-note">
      Lab note, separate from this matrix. Round 6 on 2026-10-16 measured first-try validity with one model and has not been re-run. ChartKit with the docs in the prompt was {proof.first}/{proof.tasks}. <code>repair()</code> took a no-docs run from {proof.repairFrom} to {proof.repairTo} with no model call. <a href="/benchmarks#agents">Benchmarks, losses included →</a>
    </p>

    <section class="cta-band">
      <div>
        <h2>Paste this into your agent.</h2>
        <p>One prompt switches a project to ChartKit. The app stays JavaScript; the agent writes specs, not chart code.</p>
        <pre class="sr" data-agent-prompt>{agentSwitchPrompt}</pre>
      </div>
      <button type="button" class="btn-ink" data-copy-prompt>Copy prompt</button>
    </section>
  </div>
</Base>

<script>
  import "../scripts/home-start";
</script>
