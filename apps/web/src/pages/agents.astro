---
import "../styles/v2.css";
import Base from "../layouts/Base.astro";
import { agentSwitchPrompt } from "../data/agent-prompt";
import { proofFigures } from "../data/home-bench";

const proof = proofFigures();
const description =
  "An agent writes JSON. validate() returns every error in one pass, repair() fixes the safe ones without a model call, render() returns SVG.";

const steps = [
  {
    n: "01",
    tag: "model",
    title: "Write",
    body: 'version is "1". data is an array of rows. a11y.alt is one factual sentence. Gauge, kpi and progress-ring put the number in metric.',
    code: "spec.json",
  },
  {
    n: "02",
    tag: "no model",
    title: "Validate",
    body: "Checks the schema and the data. Every CK code comes back in one pass: CK1001 is invalid JSON, CK1004 a missing required field.",
    code: "validate(spec)",
  },
  {
    n: "03",
    tag: "no model",
    title: "Repair",
    body: "Returns a spec and the JSON Patch it applied. Never invents data. A missing or unknown type is reported first.",
    code: "repair(spec)",
  },
  {
    n: "04",
    tag: "no model",
    title: "Render",
    body: "Core charts from @chartkitdev/core/all. Histogram through rose, and the planning charts, come from core/extra. render() does not validate and does not throw.",
    code: "render(spec)",
  },
];

const give = [
  { href: "/llms.txt", file: "llms.txt", what: "Short index: rules, repair loop, one spec per chart type" },
  { href: "/llms-full.txt", file: "llms-full.txt", what: "The long file, every option documented" },
  { href: "/schema/v1.json", file: "schema/v1.json", what: "JSON Schema for the spec" },
  { href: "/docs/mcp", file: "@chartkitdev/mcp", what: "stdio server; render_chart calls Cloud. Not on npm yet" },
];
---

<Base tone="light" title="Agents" description={description}>
  <div class="v2">
    <section class="split">
      <div>
        <p class="eyebrow">Agents</p>
        <h1 class="v2-h1 v2-h1--54">The spec is the interface.</h1>
        <p class="v2-lead v2-lead--left">
          An agent writes JSON. <code>validate()</code> returns every error in one pass, <code>repair()</code> fixes the safe ones without a model call, <code>render()</code> returns SVG.
        </p>
        <div class="v2-actions">
          <a class="btn-lg" href="/llms.txt">Get llms.txt</a>
          <a class="btn-text" href="/docs/mcp">MCP server →</a>
        </div>
      </div>
      <div class="agent-term">
        <header>agent session</header>
        <div class="dim">&gt; validate(spec)</div>
        <div class="bad">✕ CK1004 a11y.alt is required</div>
        <div class="bad">✕ CK1021 encoding.y "signup" not in data</div>
        <div class="dim">&gt; repair(spec)</div>
        <div class="ok">✓ /a11y/alt ← "Signups by month, Jan–Aug"</div>
        <div class="ok">✓ /encoding/y "signup" → "signups"</div>
        <div class="dim">&gt; render(spec)</div>
        <div>&lt;svg viewBox="0 0 640 360"&gt;… 4.1 KB · 0 model calls</div>
      </div>
    </section>

    <section aria-labelledby="loop-title">
      <div class="section-intro">
        <h2 id="loop-title">The loop</h2>
        <p>Four calls. The model is only in the first one.</p>
      </div>
      <div class="loop-grid">
        {
          steps.map((step) => (
            <article class="loop-card">
              <header>
                <span class="step-n">{step.n}</span>
                <span class:list={["tag", step.tag === "model" ? "tag--model" : "tag--none"]}>{step.tag}</span>
              </header>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
              <code class="chip-code">{step.code}</code>
            </article>
          ))
        }
      </div>
      <div class="two-up">
        <article class="ink-card">
          <h2>What the eval measured</h2>
          <p class="ink-stat">{proof.first}<span>/{proof.tasks}</span></p>
          <p>valid first try, docs in prompt</p>
          <p class="ink-stat">{proof.repairFrom}<span>→{proof.repairTo}</span></p>
          <p>no-docs run after repair()</p>
          <p>Round 6, 2026-10-16. Not re-run since. <a href="/benchmarks">Benchmarks, losses included →</a></p>
        </article>
        <article class="plain-card">
          <h2>What to give the model</h2>
          {
            give.map((item) => (
              <a class="give-row" href={item.href}>
                <strong>{item.file}</strong>
                <span>{item.what}</span>
              </a>
            ))
          }
        </article>
      </div>
    </section>

    <section class="cta-band">
      <div>
        <h2>Paste this into your agent.</h2>
        <p>One prompt switches a project to ChartKit. The app stays JavaScript; the agent writes specs, not chart code.</p>
        <pre class="sr" data-agent-prompt>{agentSwitchPrompt}</pre>
      </div>
      <button type="button" class="btn-ink" data-copy-prompt>Copy prompt</button>
    </section>
  </div>
</Base>

<script>
  import "../scripts/home-start";
</script>
