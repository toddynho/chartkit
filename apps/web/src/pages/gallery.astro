---
import "../styles/v2.css";
import Base from "../layouts/Base.astro";
import { chartByType, chartTypes } from "../data/chart-types";
import { chartDocs, chartPage } from "../data/docs-catalog";
import { docsSpecForType } from "../data/live-specs";
import { galleryThumb } from "../data/marketing-charts";
import { loadMaps } from "../lib/batch3";

const families = ["Core", "Statistical", "Planning"] as const;
const inCatalog = new Set(chartDocs.map((chart) => chart.type));
const maps = loadMaps();

function editHref(spec: unknown): string {
  return `/examples#${encodeURIComponent(JSON.stringify(spec))}`;
}

function tile(type: string, title: string) {
  const summary = chartByType(type)?.summary ?? chartPage(type).lede;
  return {
    id: type,
    title,
    summary,
    svg: galleryThumb(type),
    href: editHref(docsSpecForType(type)),
  };
}

const groups = [
  ...families.map((family) => ({
    id: family.toLowerCase(),
    family,
    note: "",
    charts: chartDocs.filter((chart) => chart.family === family).map((chart) => tile(chart.type, chart.label)),
  })),
  {
    id: "library",
    family: "Library",
    note: "",
    charts: chartTypes.filter((chart) => !inCatalog.has(chart.type)).map((chart) => tile(chart.type, chart.title)),
  },
  {
    id: "maps",
    family: "Maps",
    note: "Choropleth and point maps. No tile layer, no pan or zoom. Not part of core.",
    charts: [
      {
        id: "map-world",
        title: "World choropleth",
        summary: "Renewable share of electricity. Sequential scale, hatched where a country has no row.",
        svg: maps.world.svg,
        href: editHref(maps.world.spec),
      },
      {
        id: "map-us",
        title: "United States",
        summary: "Population change, 2020–2023. Red is a loss, blue is a gain.",
        svg: maps.us.svg,
        href: editHref(maps.us.spec),
      },
      {
        id: "map-cities",
        title: "Cities",
        summary: "Largest urban areas. Bubble area is population, in millions.",
        svg: maps.cities.svg,
        href: editHref(maps.cities.spec),
      },
    ],
  },
];

const count = groups.reduce((total, group) => total + group.charts.length, 0);
const description = `${count} ChartKit charts. Open a card to edit its spec.`;
const filters = [{ id: "all", label: "All", n: count }, ...groups.map((group) => ({ id: group.id, label: group.family, n: group.charts.length }))];
---

<Base tone="light" title="Gallery" description={description}>
  <div class="v2" data-gallery>
    <section class="gallery-hero">
      <p class="eyebrow">Gallery · {count} charts</p>
      <h1 class="v2-h1 v2-h1--50">Every chart. One spec shape.</h1>
      <p class="v2-lead">
        Core, statistical, planning, the rest of the library, and maps from <code>@chartkitdev/geo</code>. Open a card to edit its spec.
      </p>
      <div class="filter-track" role="tablist" aria-label="Chart groups">
        {
          filters.map((filter, index) => (
            <button type="button" data-filter={filter.id} class:list={[index === 0 && "is-on"]} aria-pressed={index === 0 ? "true" : "false"}>
              {filter.label} <small>{filter.n}</small>
            </button>
          ))
        }
      </div>
    </section>
    {
      groups.map((group) => (
        <section class="gallery-block" id={group.id} data-group={group.id} aria-labelledby={`gallery-${group.id}`}>
          <div class="gallery-block__head">
            <h2 id={`gallery-${group.id}`}>{group.family}</h2>
            <span>{group.charts.length}</span>
          </div>
          {group.note ? <p class="gallery-note">{group.note}</p> : null}
          <div class="g-grid">
            {group.charts.map((chart) => (
              <a class="g-card" href={chart.href}>
                <div class="g-thumb" set:html={chart.svg} />
                <div class="g-body">
                  <header>
                    <h3>{chart.title}</h3>
                    <span>{chart.id}</span>
                  </header>
                  <p>{chart.summary}</p>
                </div>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>("[data-gallery]");
  const buttons = [...(root?.querySelectorAll<HTMLButtonElement>("[data-filter]") ?? [])];
  const blocks = [...(root?.querySelectorAll<HTMLElement>("[data-group]") ?? [])];
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.filter ?? "all";
      buttons.forEach((item) => {
        const on = item === button;
        item.classList.toggle("is-on", on);
        item.setAttribute("aria-pressed", on ? "true" : "false");
      });
      blocks.forEach((block) => {
        block.hidden = id !== "all" && block.dataset.group !== id;
      });
    });
  });
</script>
