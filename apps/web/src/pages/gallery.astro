---
import "../styles/v2.css";
import "../styles/ck.css";
import Base from "../layouts/Base.astro";
import { chartByType } from "../data/chart-types";
import { chartPage, coreRegistryCount, galleryChartCount, geoRegistryTypes, sidebarChartGroups } from "../data/docs-catalog";
import { HERO_TYPE_COUNT, heroTypes } from "../data/hero-catalog";
import { docsSpecForType } from "../data/live-specs";
import { galleryThumb } from "../data/marketing-charts";
import { loadMaps } from "../lib/batch3";

const maps = loadMaps();
const heroByType = new Map(heroTypes.map((chart) => [chart.type, chart]));
const geoSvg: Record<string, string> = {
  choropleth: maps.world.svg,
  "map-points": maps.cities.svg,
};
const geoSpec: Record<string, Record<string, unknown>> = {
  choropleth: maps.world.spec as Record<string, unknown>,
  "map-points": maps.cities.spec as Record<string, unknown>,
};

function playHref(spec: unknown): string {
  return `/playground#${encodeURIComponent(JSON.stringify(spec))}`;
}

function tile(type: string, title: string) {
  const summary = chartByType(type)?.summary ?? heroByType.get(type)?.subtitle ?? chartPage(type).lede;
  const spec = geoSpec[type] ?? docsSpecForType(type);
  return {
    id: type,
    title,
    summary,
    svg: geoSvg[type] ?? galleryThumb(type),
    href: `/docs/charts/${type}`,
    play: playHref(spec),
  };
}

const groups = sidebarChartGroups.map((group) => ({
  id: group.label === "Geo" ? "maps" : group.label.toLowerCase(),
  family: group.label,
  note: group.label === "Geo" ? "Choropleth and point maps. No tile layer, no pan or zoom." : "",
  charts: group.items.map((item) => tile(item.type, item.label)),
}));

const count = groups.reduce((total, group) => total + group.charts.length, 0);
if (count !== galleryChartCount || count !== HERO_TYPE_COUNT) {
  throw new Error(
    `Gallery shows ${count} cards; the chart registry has ${galleryChartCount}; the hero catalog has ${HERO_TYPE_COUNT}.`,
  );
}
const description = `${count} ChartKit charts. Open a card for the docs.`;
const filters = [{ id: "all", label: "All", n: count }, ...groups.map((group) => ({ id: group.id, label: group.family, n: group.charts.length }))];
---

<Base tone="light" title="Gallery" description={description}>
  <div class="ck ck-wrap" data-gallery>
    <section class="gallery-hero">
      <p class="ck-eye">Gallery · {count} charts</p>
      <h1 class="ck-h1">Every chart. One spec shape.</h1>
      <p class="ck-lede">
        One card per chart type in the registry: {coreRegistryCount} in core, {geoRegistryTypes.length} in geo. Open a card for the docs, or open the same spec in the playground.
      </p>
      <div class="filter-track" role="tablist" aria-label="Chart groups">
        {
          filters.map((filter, index) => (
            <button type="button" data-filter={filter.id} class:list={[index === 0 && "is-on"]} aria-pressed={index === 0 ? "true" : "false"}>
              {filter.label} <small>{filter.n}</small>
            </button>
          ))
        }
      </div>
    </section>
    {
      groups.map((group) => (
        <section class="ck-section gallery-block" id={group.id} data-group={group.id} aria-labelledby={`gallery-${group.id}`}>
          <div class="gallery-block__head">
            <h2 class="ck-h2" id={`gallery-${group.id}`}>{group.family}</h2>
            <span>{group.charts.length}</span>
          </div>
          {group.note ? <p class="gallery-note ck-sub">{group.note}</p> : null}
          <div class="g-grid">
            {group.charts.map((chart) => (
              <article class="ck-panel g-card">
                <a class="g-card__open" href={chart.href}>
                  <div class="g-thumb" set:html={chart.svg} />
                  <div class="g-body">
                    <header>
                      <h3>{chart.title}</h3>
                      <span>{chart.id}</span>
                    </header>
                    <p>{chart.summary}</p>
                  </div>
                </a>
                <a class="g-play" href={chart.play}>Open in playground</a>
              </article>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>

<script>
  const root = document.querySelector<HTMLElement>("[data-gallery]");
  const buttons = [...(root?.querySelectorAll<HTMLButtonElement>("[data-filter]") ?? [])];
  const blocks = [...(root?.querySelectorAll<HTMLElement>("[data-group]") ?? [])];
  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const id = button.dataset.filter ?? "all";
      buttons.forEach((item) => {
        const on = item === button;
        item.classList.toggle("is-on", on);
        item.setAttribute("aria-pressed", on ? "true" : "false");
      });
      blocks.forEach((block) => {
        block.hidden = id !== "all" && block.dataset.group !== id;
      });
    });
  });
</script>
