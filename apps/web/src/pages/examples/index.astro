---
import Base from "../../layouts/Base.astro";

const description = "The examples editor moved to the playground.";
---

<Base title="Playground" description={description} tone="light">
  <meta slot="head" name="robots" content="noindex" />
  <script slot="head" is:inline>
    location.replace("/playground" + location.hash);
  </script>
  <div class="wrap surface">
    <header class="hero">
      <p class="kicker">Playground</p>
      <h1>Playground</h1>
      <p class="lede">
        The editor is the playground. A shared spec in the link hash opens there.
        <a id="examples-next" href="/playground">Open the playground</a>.
      </p>
    </header>
  </div>
</Base>
<script is:inline>
  const link = document.getElementById("examples-next");
  if (link) link.setAttribute("href", "/playground" + location.hash);
</script>
