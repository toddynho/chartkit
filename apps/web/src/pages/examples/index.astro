---
import "../../styles/surfaces.css";
import Base from "../../layouts/Base.astro";
import LiveSpec from "../../components/LiveSpec.astro";
import { loadExamplesIndex, loadPlayground } from "../../lib/surfaces";

const data = loadExamplesIndex();
const playground = loadPlayground();
const description = "Edit a ChartKit spec, then browse the example catalog.";
---

<Base title="Examples" description={description} tone="light">
  <div class="wrap surface">
    <header class="hero">
      <p class="kicker">Examples</p>
      <h1>Examples</h1>
      <p class="lede">
        Edit the spec. The preview renders with <code>@chartkitdev/core</code>, and maps with <code>@chartkitdev/geo</code>.
        Validate and Repair call the same functions an agent would. Share puts the spec in the URL hash.
      </p>
    </header>
    <LiveSpec spec={playground.spec} svg={playground.svg} mode="full" themes={playground.themes} />
    <nav class="filters" aria-label="Example groups">
      {data.groups.map((group) => <a href={`#${group.id}`}>{group.label}</a>)}
    </nav>
    {
      data.groups.map((group) => (
        <section id={group.id} class="section">
          <h2>{group.label}</h2>
          <div class="example-grid">
            {data.examples
              .filter((example) => example.groupId === group.id)
              .map((example) => (
                <article class="card">
                  <a class="cover-frame" href={`/examples/${example.slug}`} aria-label={example.alt} set:html={example.svg} />
                  <h3>{example.title}</h3>
                  <p>{example.blurb}</p>
                  <a href={`/examples/${example.slug}`}>Edit spec</a>
                </article>
              ))}
          </div>
        </section>
      ))
    }
  </div>
</Base>
