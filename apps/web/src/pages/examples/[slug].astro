---
import { chartPageTypes } from "../../data/docs-catalog";
import { loadExamplesIndex } from "../../lib/surfaces";

export function getStaticPaths() {
  const pages = new Set(chartPageTypes);
  return loadExamplesIndex().examples.map((example) => {
    if (!pages.has(example.type)) throw new Error(`Example ${example.slug} type ${example.type} has no docs page.`);
    return { params: { slug: example.slug }, props: { type: example.type } };
  });
}

interface Props {
  type: string;
}

const { type } = Astro.props;
return Astro.redirect(`/docs/charts/${type}#example-${Astro.params.slug}`, 301);
---
