---
import "../styles/ck.css";
import "../styles/convert.css";
import Base from "../layouts/Base.astro";
import { loadConvert } from "../lib/batch3";
import { scriptJson } from "../lib/spec-text";

const page = loadConvert();
const starter = page.samples.find((item) => item.id === "recharts") ?? page.samples[0];
if (!starter) throw new Error("convert samples missing");
const guides = [
  { id: "chartjs", href: "/docs/migrate/chartjs", label: "Chart.js" },
  { id: "recharts", href: "/docs/migrate/recharts", label: "Recharts" },
  { id: "echarts", href: "/docs/migrate/echarts", label: "ECharts" },
] as const;
const description = "Paste a Chart.js config, Recharts JSX, or an ECharts option. The spec, warnings, and both charts stay in the browser.";
---

<Base title="Convert a chart" description={description} tone="light">
  <div class="ck ck-wrap" data-convert-demo>
    <div class="cvt-copy">
      <p class="cvt-crumb"><a href="/compare">Compare</a> / Convert</p>
      <h1 class="ck-h1">Paste a chart. Get the spec.</h1>
      <p class="ck-lede">
        Chart.js, Recharts, or ECharts. The result is a ChartKit spec after validate() and repair(), plus a warning for each unmapped key. Those three libraries load on this page only. @chartkitdev/convert is unpublished.
      </p>
    </div>

    <div class="ck-split cvt-tool">
      <div class="ck-panel ck-panel--dark cvt-paste">
        <div class="ck-tabs ck-tabs--dark" role="tablist" aria-label="Source library">
          {
            page.samples.map((item) => (
              <button type="button" class:list={["ck-tab", item.id === starter.id && "is-on"]} data-sample={item.id} role="tab">
                {item.label}
              </button>
            ))
          }
          <span data-detected style="margin-left:auto;align-self:center;font-family:var(--mono);font-size:11px;color:#8b8d93">detected · {starter.label}</span>
        </div>
        <textarea id="convert-source" spellcheck="false" aria-label="Chart to convert">{starter.source}</textarea>
        <div class="ck-foot">
          <span data-paste-meta>{starter.source.split("\n").length} lines · runs in your browser, nothing is uploaded</span>
          <button type="button" class="cmp-load" data-load style="color:#d9dadd;border-color:#3a3b40">Load sample</button>
        </div>
      </div>
      <div class="ck-panel">
        <div class="ck-tabs" role="tablist" aria-label="Result">
          <button type="button" class="ck-tab is-on" data-view="chart">Chart</button>
          <button type="button" class="ck-tab" data-view="spec">Spec</button>
          <button type="button" class="ck-tab" data-view="warnings">Warnings <span class="ck-badge" data-warn-count>{starter.warnings.length}</span></button>
          <span data-state style="margin-left:auto;align-self:center;font-family:var(--mono);font-size:11px;color:#1a7f4b">● valid</span>
        </div>
        <div data-panel="chart" class="cvt-chart">
          <div data-convert-chart set:html={starter.svg}></div>
          <p class="cvt-alt" data-alt></p>
        </div>
        <pre class="cvt-spec" data-panel="spec" data-convert-spec hidden>{starter.spec ? JSON.stringify(starter.spec, null, 2) : ""}</pre>
        <div data-panel="warnings" data-convert-warnings hidden>
          {
            starter.warnings.length === 0 ? (
              <p class="cvt-alt">No warnings. Every key the converter read was mapped.</p>
            ) : (
              <ul class="cvt-warns">
                {starter.warnings.map((warning) => (
                  <li><code>{warning.code}</code> {warning.path} {warning.message}</li>
                ))}
              </ul>
            )
          }
        </div>
        <div class="ck-foot">
          <span data-summary></span>
          <span>
            <button type="button" class="ck-btn" data-copy>Copy spec</button>
            <a class="ck-link" data-play href="/playground">Open in Playground</a>
          </span>
        </div>
      </div>
    </div>

    <section class="ck-section" id="both">
      <div class="ck-head">
        <p class="ck-eye">Both</p>
        <h2 class="ck-h2">Same data, both renderers.</h2>
        <p class="ck-sub">The vendor library draws the paste. ChartKit draws the converted spec. Vendor code loads on this page only.</p>
      </div>
      <div class="ck-split cvt-side">
        <figure class="ck-panel">
          <div class="ck-bar ck-bar--light"><span data-original-label>original · {starter.label}</span><span>{starter.id}</span></div>
          <div class="cvt-original" data-original-host></div>
          <p class="cvt-caption" data-original-error hidden></p>
          <figcaption class="cvt-caption">Rendered by the vendor library from the paste.</figcaption>
        </figure>
        <figure class="ck-panel">
          <div class="ck-bar ck-bar--light"><span>chartkit · converted spec</span><span data-svg-size>static svg</span></div>
          <div class="cvt-kit" data-kit-host set:html={starter.svg}></div>
          <figcaption class="cvt-caption">Static SVG from the spec. No vendor runtime.</figcaption>
        </figure>
      </div>
    </section>

    <section class="ck-section cvt-end" id="coverage">
      <div class="ck-head">
        <p class="ck-eye">Coverage</p>
        <h2 class="ck-h2">What maps, what warns.</h2>
        <p class="ck-sub">These lists are what @chartkitdev/convert actually maps. A warning code is CK81xx, not a draft CV code.</p>
      </div>
      <div class="cvt-metrics">
        {
          guides.map((guide) => {
            const table = page.coverage[guide.id];
            if (!table) return null;
            return (
              <article class="ck-panel">
                <div class="ck-bar ck-bar--light">
                  <span>{guide.label}</span>
                  <span>{table.mapped.length} mapped · {table.unsupported.length} warn</span>
                </div>
                <div class="cvt-chips">
                  {table.mapped.map((item) => <span class="cvt-chip">{item}</span>)}
                  {table.unsupported.map((item) => <span class="cvt-chip is-warn">{item}</span>)}
                </div>
                <div class="ck-foot">
                  <a href={guide.href}>{guide.label} guide →</a>
                  <a href={`/compare/${guide.id}`}>ChartKit vs {guide.label}</a>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
    <script is:inline id="convert-samples" type="application/json" set:html={scriptJson(page.samples.map((item) => ({ id: item.id, label: item.label, source: item.source })))} />
  </div>
  <script>
    import "../scripts/convert-demo.ts";
  </script>
</Base>
