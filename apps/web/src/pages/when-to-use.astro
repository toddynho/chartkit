---
import "../styles/surfaces.css";
import Base from "../layouts/Base.astro";
import { loadWhenToUse } from "../lib/batch3";
import { scriptJson } from "../lib/spec-text";

const page = loadWhenToUse();
const description = "When to use ChartKit, when not to, and the round 13 numbers behind that choice.";
---

<Base title="When to use ChartKit" description={description} tone="light">
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={scriptJson(page.jsonLd)} />
  </Fragment>
  <div class="wrap surface prose">
    <h1>When to use ChartKit</h1>
    <p class="lede">
      Round 13 browser numbers, losses included. Bundle size and server render are the phase 4 matrices. They match <a href="/benchmarks.json">benchmarks.json</a>.
    </p>
    {
      page.faqs.map((item) => (
        <section>
          <h2>{item.question}</h2>
          <p>{item.answer}</p>
        </section>
      ))
    }
    <p>
      Pairwise pages: <a href="/compare/recharts">Recharts</a>, <a href="/compare/chartjs">Chart.js</a>,{" "}
      <a href="/compare/echarts">ECharts</a>, <a href="/compare/nivo">Nivo</a>.
    </p>
  </div>
</Base>
