---
import "../styles/v2.css";
import "../styles/ck.css";
import "../styles/cloud.css";
import Base from "../layouts/Base.astro";
import { HERO_TYPE_COUNT } from "../data/hero-catalog";
import { freeRenderLimit } from "../data/cloud-facts";
import { chartkitCloudUrl } from "../data/cloud-url";
import { chartPreview, paintSpec } from "../lib/chartkit";
import { cloudPresets, cloudSnippets, placeLines, renderUrl } from "../lib/cloud-page";

const origin = chartkitCloudUrl();
const perMinute = freeRenderLimit();
const typeCount = HERO_TYPE_COUNT;
const proDraft = true;
const initial = cloudPresets.bar;
const initialText = JSON.stringify(initial, null, 2);
const initialJson = JSON.stringify(initial);
const initialUrl = renderUrl(origin, initialJson, "svg");
const snippets = cloudSnippets(origin, initialJson, "svg", initial.a11y.alt);
const places = placeLines(origin, initialJson);
const first = snippets[0];
if (!first) throw new Error("Cloud snippets are empty");
for (const [name, spec] of Object.entries(cloudPresets)) {
  const result = paintSpec(spec);
  if (!result.ok || !result.svg.includes("<svg")) {
    throw new Error(`Cloud preset ${name} did not render: ${result.issues.map((issue) => issue.message).join("; ")}`);
  }
}
const preview = paintSpec(chartPreview(initial));
if (!preview.ok || !preview.svg.includes("<svg")) throw new Error("Cloud hero preview did not render");
const bars = [38, 52, 46, 68, 61, 84, 79, 100];

const headers = [
  {
    n: "1",
    key: "content-type",
    val: "image/svg+xml; charset=utf-8",
    title: "SVG or PNG",
    via: "format · w · h · scale · theme",
    body: "SVG unless format=png. Width and height go up to 4096. PNG scale is 1 to 4. theme and background are query params. There is no dpr param.",
  },
  {
    n: "2",
    key: "cache-control",
    val: "public, max-age=31536000, immutable",
    title: "Immutable by spec",
    via: "one year",
    body: "Same spec, same URL, cached for a year. Change one byte and the URL is a different image.",
  },
  {
    n: "3",
    key: "cf-cache-status",
    val: "HIT",
    title: "Edge cache",
    via: "repeat GET",
    body: "A second GET of this signups spec returned HIT. The first request was a miss and did not send cf-cache-status.",
  },
  {
    n: "4",
    key: "x-chartkit-cache",
    val: "edge",
    title: "Worker cache",
    via: "X-ChartKit-Cache",
    body: "The worker sets miss or hit for its own map, and edge when the Workers cache serves the GET.",
  },
  {
    n: "5",
    key: "x-chartkit-watermark",
    val: "1",
    title: "Mark on a free GET",
    via: "X-ChartKit-Watermark",
    body: "GET /render sets this to 1 and draws the chartkit.dev mark. A valid key on POST stores an unmarked chart at /c/<id>. The worker does not log spec bodies. Specs over 1,800 characters, and keyed renders, are stored.",
  },
  {
    n: "6",
    key: "x-chartkit-ok",
    val: "1",
    title: "The spec drew",
    via: "X-ChartKit-Ok",
    body: "1 when the chart was drawn. X-ChartKit-Errors lists CK codes when it was not. X-ChartKit-Repairs counts patches. This response had 0 repairs.",
  },
];

const description =
  "ChartKit Cloud returns SVG or PNG from a JSON spec. Free images include a chartkit.dev mark. Pro is not on sale yet.";
---

<Base tone="light" title="Cloud" description={description}>
  <div class="ck ck-wrap cloud-page" data-cloud data-origin={origin}>
    <section class="cloud-hero" id="try">
      <div class="cloud-copy">
        <p class="ck-eye">ChartKit Cloud</p>
        <h1 class="ck-h1">Post a spec.<br />Get the image.</h1>
        <p class="cloud-lead ck-lede">
          The same ChartSpec, rendered on our servers. Put the URL in an <code>&lt;img&gt;</code>, an email, a README or a PDF. No chart runtime anywhere.
        </p>
        <p class="cloud-help">Edit the spec on the right. The image and its URL update as you type, and that URL already works.</p>
        <div class="cloud-cta">
          <button type="button" class="ck-btn" data-copy="url" data-copy-label="long">Copy the image URL</button>
          <a class="ck-link" href="#pricing">Limits &amp; pricing</a>
        </div>
        <p class="cloud-fine">Free, no key. {perMinute} renders / min. Free images carry a small chartkit.dev mark.</p>
      </div>
      <div class="ck-panel cloud-card">
        <div class="cloud-panes">
          <div class="cloud-codepane">
            <div class="ck-bar cloud-bar">
              <span>spec.json</span>
              <span class="cloud-presets">
                <button type="button" class="cloud-chip is-on" data-preset="bar" aria-pressed="true">bar</button>
                <button type="button" class="cloud-chip" data-preset="line" aria-pressed="false">line</button>
                <button type="button" class="cloud-chip" data-preset="donut" aria-pressed="false">donut</button>
              </span>
            </div>
            <textarea data-spec spellcheck="false" aria-label="Chart spec JSON">{initialText}</textarea>
          </div>
          <div class="cloud-preview">
            <div class="ck-bar cloud-bar">
              <span class="cloud-status" data-status data-state="ok">200 OK · image/svg+xml</span>
              <span class="cloud-formats">
                <button type="button" class="cloud-chip is-on" data-format="svg" aria-pressed="true">svg</button>
                <button type="button" class="cloud-chip" data-format="png" aria-pressed="false">png</button>
              </span>
            </div>
            <div class="cloud-stage">
              <div class="cloud-stage__title" data-title>{initial.title}</div>
              <div class="cloud-stage__chart" data-chart set:html={preview.svg} />
              <div class="cloud-stage__mark">chartkit.dev</div>
            </div>
          </div>
        </div>
        <div class="cloud-url">
          <span class="cloud-url__verb">GET</span>
          <span class="cloud-url__value" data-url>{initialUrl}</span>
          <button type="button" class="cloud-pill" data-copy="url" data-copy-label="short">Copy</button>
        </div>
      </div>
    </section>

    <section class="ck-section cloud-section" id="send" aria-labelledby="send-title">
      <div class="ck-head">
        <p class="ck-eye">Send</p>
        <h2 class="ck-h2" id="send-title">One request, from anywhere.</h2>
        <p class="ck-sub">No SDK. GET returns the file. POST returns JSON with the SVG or base64 PNG, plus a url.</p>
      </div>
      <div class="ck-split">
        <div class="ck-panel ck-panel--dark cloud-dark">
          <div class="ck-bar cloud-bar">
            <span data-lang>request · {first.lang}</span>
            <button type="button" class="cloud-copyline" data-copy="snippet">copy</button>
          </div>
          <div class="cloud-tabs" role="tablist" aria-label="Request snippets">
            {snippets.map((tab) => (
              <button type="button" class:list={["ck-chip", "cloud-tab", tab.id === first.id && "is-on"]} role="tab" data-tab={tab.id} aria-selected={tab.id === first.id ? "true" : "false"}>{tab.label}</button>
            ))}
          </div>
          <pre class="ck-code"><code data-code>{first.code}</code></pre>
        </div>
        <div class="ck-panel cloud-light">
          <div class="ck-bar cloud-bar">
            <span class="cloud-status" data-status data-state="ok">200 OK · image/svg+xml</span>
            <span class="cloud-formats">
              <button type="button" class="cloud-chip is-on" data-format="svg" aria-pressed="true">svg</button>
              <button type="button" class="cloud-chip" data-format="png" aria-pressed="false">png</button>
            </span>
          </div>
          <div class="cloud-stage cloud-stage--room">
            <div class="cloud-stage__title" data-title>{initial.title}</div>
            <div class="cloud-stage__chart" data-chart set:html={preview.svg} />
            <div class="cloud-stage__mark">chartkit.dev</div>
          </div>
          <div class="ck-foot cloud-foot"><span data-note>{first.note}</span> <a href="/docs/cloud">Render reference →</a></div>
        </div>
      </div>
    </section>

    <section class="ck-section cloud-section" id="place" aria-labelledby="place-title">
      <div class="ck-head">
        <p class="ck-eye">Place</p>
        <h2 class="ck-h2" id="place-title">Where an image is enough.</h2>
        <p class="ck-sub">The same URL, dropped into four places that cannot run JavaScript. Nothing else changes.</p>
      </div>
      <div class="ck-split">
        <article class="ck-panel cloud-place">
          <div class="ck-bar cloud-bar"><span>Email</span><span>format=png · scale=2</span></div>
          <div class="cloud-place__copy">
            <h3>Charts in the inbox</h3>
            <p>Mail clients run no JavaScript. A PNG renders in every client, Outlook included.</p>
          </div>
          <div class="cloud-well">
            <div class="cloud-mock">
              <div class="mock-who"><span class="mock-avatar"></span><div><strong>Weekly metrics</strong><span>reports@acme.com · Mon 9:00</span></div></div>
              <p class="mock-body">Signups for the week are in the chart below.</p>
              <div class="mock-chart"><strong>Signups by week</strong><div class="mock-bars" style="--h:70px">{bars.map((value) => <span style={`height:${value}%`} />)}</div><div class="mock-mark">chartkit.dev</div></div>
              <span class="skel" style="width:70%"></span>
              <span class="skel" style="width:45%"></span>
            </div>
          </div>
          <div class="ck-foot cloud-foot cloud-foot--mono" data-place="email">{places.email}</div>
        </article>
        <article class="ck-panel cloud-place">
          <div class="ck-bar cloud-bar"><span>Docs</span><span>format=png</span></div>
          <div class="cloud-place__copy">
            <h3>README and wikis</h3>
            <p>Point the image at the render URL. Change the spec and the doc updates. No committed PNGs.</p>
          </div>
          <div class="cloud-well">
            <div class="cloud-mock">
              <div class="mock-meta"><strong style="color:#17181a">README.md</strong> <span>main</span></div>
              <div class="mock-h"># acme-metrics</div>
              <div class="mock-url">![signups]({origin}/render?spec=…&amp;format=png)</div>
              <div class="mock-chart"><strong>Signups by month</strong><div class="mock-bars" style="--h:64px">{bars.map((value) => <span style={`height:${value}%`} />)}</div><div class="mock-mark">chartkit.dev</div></div>
              <span class="skel" style="width:80%"></span>
            </div>
          </div>
          <div class="ck-foot cloud-foot cloud-foot--mono" data-place="docs">{places.docs}</div>
        </article>
        <article class="ck-panel cloud-place">
          <div class="ck-bar cloud-bar"><span>Agents</span><span>format=svg</span></div>
          <div class="cloud-place__copy">
            <h3>Agent artifacts</h3>
            <p>The agent writes the spec and hands back a URL. Nothing to render on its side.</p>
          </div>
          <div class="cloud-well">
            <div class="cloud-mock">
              <div class="mock-bubble">Chart last quarter’s signups by month.</div>
              <div class="mock-row">
                <span class="mock-bot"></span>
                <div class="mock-reply">
                  <div>Here it is.</div>
                  <div class="mock-chart"><strong>Signups by month</strong><div class="mock-bars" style="--h:60px">{bars.map((value) => <span style={`height:${value}%`} />)}</div><div class="mock-mark">chartkit.dev</div></div>
                  <div class="mock-file">signups-q3.svg</div>
                </div>
              </div>
            </div>
          </div>
          <div class="ck-foot cloud-foot cloud-foot--mono" data-place="agents">{places.agents}</div>
        </article>
        <article class="ck-panel cloud-place">
          <div class="ck-bar cloud-bar"><span>Reports</span><span>format=svg · w=1200</span></div>
          <div class="cloud-place__copy">
            <h3>Server-side PDFs</h3>
            <p>Your report builder fetches the SVG and drops it on the page. Vector, so it prints clean.</p>
          </div>
          <div class="cloud-well">
            <div class="cloud-mock">
              <div class="mock-kicker"><span>Q3 BOARD REPORT</span><span>p. 4 / 12</span></div>
              <strong>2. Growth</strong>
              <span class="skel" style="width:100%"></span>
              <span class="skel" style="width:92%"></span>
              <div class="mock-pair">
                <div class="mock-chart"><strong>Signups</strong><div class="mock-bars" style="--h:44px">{bars.map((value) => <span style={`height:${value}%`} />)}</div></div>
                <div class="mock-chart"><strong>Revenue</strong><div class="mock-bars" style="--h:44px">{bars.map((value) => <span style={`height:${value}%`} />)}</div></div>
              </div>
            </div>
          </div>
          <div class="ck-foot cloud-foot cloud-foot--mono" data-place="reports">{places.reports}</div>
        </article>
      </div>
    </section>

    <section class="ck-section cloud-section" id="trust" aria-labelledby="trust-title">
      <div class="ck-head">
        <p class="ck-eye">Trust</p>
        <h2 class="ck-h2" id="trust-title">Read the response headers.</h2>
        <p class="ck-sub">These are the headers from a repeat GET of the signups spec on cloud.chartkit.dev. The numbers match that response.</p>
      </div>
      <div class="ck-split cloud-trust">
        <div class="ck-panel ck-panel--dark cloud-dark cloud-sticky">
          <div class="ck-bar cloud-bar"><span>response · headers</span><span>GET /render</span></div>
          <div class="cloud-headers">
            <div><span class="dim">HTTP/2</span> <span class="ok">200</span></div>
            {headers.map((row) => (
              <div class="cloud-hline">
                <span class="cloud-badge">{row.n}</span>
                <span class="key">{row.key}</span>
                <span class="sep">:</span>
                <span>{row.val}</span>
              </div>
            ))}
            <div class="cloud-bytes">… 7,207 bytes of image/svg+xml</div>
          </div>
        </div>
        <div class="cloud-ann">
          {headers.map((row) => (
            <div class="cloud-ann__row">
              <span class="cloud-ann__n">{row.n}</span>
              <div>
                <div class="cloud-ann__top"><h3>{row.title}</h3><code class="cloud-ann__via">{row.via}</code></div>
                <p>{row.body}</p>
              </div>
            </div>
          ))}
          <div class="cloud-ann__end"></div>
        </div>
      </div>
      <p class="cloud-aside">
        This 200 does not include a rate-limit header. Over {perMinute} renders a minute from one IP, inside an isolate, the response is 429 with Retry-After, X-RateLimit-Limit, and X-RateLimit-Remaining: 0. The ceiling is the same with or without a key. There is no public status page.
      </p>
    </section>

    <section class="ck-section cloud-section" id="own" aria-labelledby="own-title">
      <div class="ck-head">
        <p class="ck-eye">Own</p>
        <h2 class="ck-h2" id="own-title">Same handler, your box.</h2>
        <p class="ck-sub">Cloud runs the MIT renderer that ships in the package. The local server is the same handler, so a GET still includes the mark.</p>
      </div>
      <div class="ck-split">
        <div class="ck-panel ck-panel--dark cloud-dark">
          <div class="ck-bar cloud-bar"><span>terminal</span><span>local</span></div>
          <div class="cloud-term">
            <div><span class="dim">$</span> npm run dev:node --workspace=@chartkitdev/cloud</div>
            <div class="dim">→ listening on <span class="key">http://127.0.0.1:8787</span></div>
            <div><span class="dim">$</span> curl -sG localhost:8787/render \</div>
            <div>&nbsp;&nbsp;--data-urlencode 'spec=…' \</div>
            <div>&nbsp;&nbsp;--data-urlencode format=svg \</div>
            <div>&nbsp;&nbsp;-o chart.svg</div>
          </div>
        </div>
        <div class="ck-panel cloud-light">
          <div class="ck-bar cloud-bar">
            <span class="cloud-status" data-status data-state="ok">200 OK · image/svg+xml</span>
            <span>127.0.0.1</span>
          </div>
          <div class="cloud-stage cloud-stage--room">
            <div class="cloud-stage__title" data-title>{initial.title}</div>
            <div class="cloud-stage__chart" data-chart set:html={preview.svg} />
            <div class="cloud-stage__mark">chartkit.dev · GET includes the mark</div>
          </div>
        </div>
      </div>
    </section>

    <section class="ck-section cloud-section cloud-section--pay" id="pricing" aria-labelledby="pay-title">
      <div class="ck-head">
        <p class="ck-eye">Pay</p>
        <h2 class="ck-h2" id="pay-title">Free to use. Pay to drop the mark.</h2>
        <p class="ck-sub">Same spec, same output. A key removes the chartkit.dev mark. The {perMinute}/min ceiling does not change.</p>
      </div>
      <div class="ck-split">
        <article class="cloud-plan">
          <div class="cloud-plan__top"><h3>Free</h3><div class="cloud-plan__meta">no key · no account</div></div>
          <ul>
            <li><span class="yes">✓</span>All {typeCount} chart types, SVG and PNG</li>
            <li><span class="yes">✓</span>{perMinute} renders / min per IP</li>
            <li><span class="yes">✓</span>Width and height up to 4096. PNG scale up to 4.</li>
            <li><span class="no">–</span><span class="dim">Small chartkit.dev mark, bottom-right</span></li>
          </ul>
          <a class="cloud-using" href="#try">You're already using it ↑</a>
        </article>
        <article class="cloud-plan cloud-plan--pro">
          <div class="cloud-plan__top">
            <h3>Pro</h3>
            {/* Placeholder. Todd has not decided $29/mo, 10,000 renders, $0.002, or a free first month. */}
            <div class="cloud-plan__meta">$29 / mo</div>
          </div>
          <ul>
            <li><span class="yes">✓</span>No mark</li>
            <li><span class="yes">✓</span>10,000 renders / month, then $0.002 each</li>
            <li><span class="yes">✓</span>Same {perMinute}/min ceiling with or without a key</li>
            <li><span class="yes">✓</span>A valid key stores an unmarked chart at /c/&lt;id&gt;</li>
          </ul>
          {proDraft ? (
            <>
              {/* TODO: no waitlist endpoint or address exists in the repo. Submit opens the visitor's mail client and does not store the address. */}
              <form class="cloud-wait" data-waitlist action="mailto:?subject=ChartKit%20Cloud%20Pro%20waitlist" method="post" enctype="text/plain">
                <input type="email" name="email" required placeholder="you@company.com" autocomplete="email" aria-label="Email" />
                <button type="submit">Join waitlist</button>
              </form>
              <p class="cloud-wait__fine">Launching with the price above. Waitlist gets the first month free. Nothing is stored here: Join opens your email app.</p>
            </>
          ) : null}
        </article>
      </div>
    </section>
  </div>
  <script>
    import { mountCloudPage } from "../scripts/cloud-hero";
    const root = document.querySelector<HTMLElement>("[data-cloud]");
    if (root) mountCloudPage(root);
  </script>
</Base>
