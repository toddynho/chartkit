---
import Base from "../layouts/Base.astro";
import Pricing from "../components/Pricing.astro";
import { highlight } from "../lib/highlight";
import { cloudCurl } from "../data/samples";

const description =
  "ChartKit Cloud returns SVG or PNG from a JSON spec. Free images include a watermark. Pro removes it. The dollar amounts are drafts.";
const curl = await highlight(cloudCurl, "bash");

const uses = [
  {
    title: "README / docs images",
    text: "A README or a docs page can point at the image. PNG for GitHub. SVG elsewhere.",
  },
  {
    title: "Agent artifacts",
    text: "An agent posts a spec and keeps the file. The artifact is an image, ready to attach.",
  },
  {
    title: "Server-side reports",
    text: "The server that builds the report asks for the image and drops it in. No chart package on that host.",
  },
  {
    title: "Anywhere an img is enough",
    text: "If the page can show an image, it can show the chart. The chart runtime stays off the client.",
  },
];
---

<Base tone="light" title="Cloud" description={description}>
  <div class="wrap">
    <section class="hero" aria-labelledby="cloud-page-title">
      <p class="kicker">Cloud</p>
      <h1 id="cloud-page-title">Post a spec. Get the image.</h1>
      <p class="lede">SVG or PNG back from one JSON spec. No renderer to host. Fast to put in an app.</p>
      <div class="actions">
        <a class="btn btn-primary" href="#uses">Use cases</a>
        <a class="btn btn-secondary" href="#pricing">Free and Pro</a>
      </div>
    </section>

    <section class="section" id="why" aria-labelledby="why-cloud">
      <h2 id="why-cloud">Why Cloud</h2>
      <p class="lede">POST the spec. The response is the chart. The app that already sends mail, writes the README, or builds the report can take that image.</p>
    </section>

    <section class="section" id="uses" aria-labelledby="uses-title">
      <h2 id="uses-title">Use cases</h2>
      <div class="use-grid">
        <article class="card use-card use-card--email">
          <p class="kicker">Email</p>
          <h3>Charts in the inbox</h3>
          <p>
            Render returns SVG or PNG, so the chart is an image. Email shows it. A JavaScript chart runtime does not run there.
          </p>
        </article>
        {
          uses.map((item) => (
            <article class="card use-card">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" id="fast" aria-labelledby="fast-title">
      <h2 id="fast-title">How fast</h2>
      <p class="lede">One request. The response is the image.</p>
      <figure class="code">
        <figcaption>shell</figcaption>
        <Fragment set:html={curl} />
      </figure>
      <p class="note">
        The API reference is <a href="https://chartkit.dev/docs/cloud">Cloud render</a>.
      </p>
    </section>

    <Pricing />
  </div>
</Base>
