---
import Base from "../layouts/Base.astro";
import Pricing from "../components/Pricing.astro";
import { cloudCurl } from "../data/samples";

const description =
  "ChartKit Cloud returns an SVG or PNG for a JSON spec. Marked renders need no key. Pricing numbers are not set.";
---

<Base title="Cloud" description={description}>
  <div class="wrap">
    <section class="hero" aria-labelledby="cloud-page-title">
      <p class="kicker">ChartKit Cloud</p>
      <h1 id="cloud-page-title">A chart as an image.</h1>
      <p class="lede">
        Any agent or app can request a render. Free images carry a small chartkit.dev mark. The open-source library
        never draws that mark. What Pro includes, and what the meter charges, is not decided.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#pricing">Pricing</a>
        <a class="btn btn-secondary" href="/docs/reference/try">Try the spec shell</a>
      </div>
    </section>

    <section class="section" aria-labelledby="render-title">
      <h2 id="render-title">Render</h2>
      <p>
        <code>GET /render</code> returns SVG or PNG, so it works as an <code>img</code> src. That URL has no API key.{' '}
        <code>POST /render</code> takes the JSON body and returns the image URL plus the repairs and warnings.{' '}
        <code>POST /charts</code> stores the spec and returns a short URL. <code>POST /validate</code> returns the CK
        codes, the JSON Patch, and the repaired spec.
      </p>
      <figure class="code">
        <figcaption>shell</figcaption>
        <pre><code>{cloudCurl}</code></pre>
      </figure>
      <p>
        GitHub READMEs display PNG. Add <code>format=png</code>. SVG is the default everywhere else. Add{' '}
        <code>theme=midnight</code>, <code>w</code>, <code>h</code>, and <code>scale</code> on the query string. A spec
        can be URL-encoded JSON or base64url.
      </p>
      <p class="note">
        The API reference and the live examples stay on <a href="https://chartkit.dev/docs/cloud">Cloud render</a> and{' '}
        <a href="https://chartkit.dev/cloud">the current Cloud page</a> until this shell replaces them. This app does
        not proxy the API.
      </p>
    </section>

    <Pricing />
  </div>
</Base>
