---
import "@fontsource/roboto/latin-400.css";
import "@fontsource/roboto/latin-500.css";
import "@fontsource/roboto/latin-700.css";
import "../../styles/dashboards.css";
import Base from "../../layouts/Base.astro";
import DashboardBoard from "../../components/DashboardBoard.astro";
import { loadBoard, loadIndex } from "../../lib/dashboards";

const cards = loadIndex().boards;
const boards = cards.map((card) => loadBoard(card.slug));
const description = `${cards.length} ChartKit layouts: ${cards.map((card) => card.title).join(", ")}.`;
---

<Base title="Dashboards" description={description} tone="light">
  <div class="wrap dash-index">
    <header class="hero">
      <p class="kicker">Dashboards</p>
      <h1>Dashboards</h1>
      <p class="lede">{cards.length} layouts. Hero and KPIs, tabs, a map, a cohort, a ranked list, an issue table.</p>
    </header>
    {boards.map((board) => <DashboardBoard board={board} embed />)}
  </div>
</Base>
