---
import "../styles/hero.css";
import "../styles/docs.css";
import "../styles/surfaces.css";
import Base from "../layouts/Base.astro";
import ChartMount from "../components/ChartMount.astro";
import HeroStage from "../components/HeroStage.astro";
import HomeStart from "../components/HomeStart.astro";
import { SITE } from "../data/site";
import { loadHomeStory } from "../lib/surfaces";

/** Swap this string to change the homepage headline. */
const heroTitle = "Pass a spec. ChartKit draws the chart.";
const heroLede =
  "ChartKit is a JavaScript library. Agents and developers pass a ChartSpec. They do not write the chart implementation.";
const story = loadHomeStory();
const leadChart = story.charts.find((chart) => chart.id === "initial");
const sideCharts = story.charts.filter((chart) => chart.id !== "initial");
---

<Base tone="light" title={heroTitle} description={heroLede || SITE.description}>
  <section class="home-hero" id="hero" aria-labelledby="home-title">
    <p class="home-hero__eyebrow">ChartKit v1</p>
    <h1 id="home-title">{heroTitle}</h1>
    <p class="home-hero__lede">{heroLede}</p>
    <div class="home-hero__actions">
      <a class="home-btn" href="/docs">
        Get started <span class="home-btn__chev" aria-hidden="true">›</span>
      </a>
      <a class="home-link" href="/cloud">Cloud</a>
    </div>
  </section>

  <HomeStart />

  <HeroStage />

  <section class="home-story" id="measured" aria-labelledby="story-title">
    <div class="home-story__intro">
      <h2 id="story-title">Measured.</h2>
      <p>
        {story.lede} <a href="/benchmarks">Benchmarks</a>.
      </p>
    </div>
    <div class="home-story__grid">
      {
        leadChart ? (
          <article class="home-story__card home-story__card--wide">
            <h3>{leadChart.title}</h3>
            <ChartMount spec={leadChart.spec} svg={leadChart.svg} alt={leadChart.alt} />
            <p>{leadChart.caption}</p>
          </article>
        ) : null
      }
      {
        sideCharts.map((chart) => (
          <article class="home-story__card">
            <h3>{chart.title}</h3>
            <ChartMount spec={chart.spec} svg={chart.svg} alt={chart.alt} />
            <p>{chart.caption}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="home-routes" aria-label="Product">
    <a class="home-route" href="/cloud">
      <h2>Cloud</h2>
      <p>
        Post a spec, get SVG or PNG. Email, docs, and reports use the image. Free includes a watermark. Pro removes it.
      </p>
      <span class="home-route__go">Open Cloud</span>
    </a>
    <a class="home-route" href="/dashboards">
      <h2>Dashboards</h2>
      <p>Ten layouts on one page. A payments home, analytics, traffic, issues, and the rest.</p>
      <span class="home-route__go">Open Dashboards</span>
    </a>
    <a class="home-route" href="/agents">
      <h2>Agents</h2>
      <p>JSON spec in, chart out. Validate and repair the safe mistakes without another model call.</p>
      <span class="home-route__go">For agents</span>
    </a>
    <a class="home-route" href="/gallery">
      <h2>Gallery</h2>
      <p>Every chart type, including maps. Open a card to edit the spec.</p>
      <span class="home-route__go">Browse the gallery</span>
    </a>
  </section>

  <section class="home-bands" aria-label="Highlights">
    <a class="home-band" href="/large">
      <h2>Large data</h2>
      <p>A million-point trace, sampled or on canvas, and a live stream.</p>
    </a>
    <a class="home-band" href="/interaction">
      <h2>Interaction</h2>
      <p>Overview, a shared cursor, and drilldown. Each one is a key on the spec.</p>
    </a>
    <a class="home-band" href="/layouts">
      <h2>Layout</h2>
      <p>Facets, concatenated views, breakpoints, and right-to-left text.</p>
    </a>
    <a class="home-band" href="/when-to-use">
      <h2>When to use</h2>
      <p>When ChartKit is the right library, and when it is not.</p>
    </a>
  </section>

  <section class="home-why" id="home-why" aria-labelledby="why-title">
    <div class="home-why__inner">
      <div class="home-why__intro">
        <h2 id="why-title">Why teams switch.</h2>
        <p>Agent-first charts. One JSON object. The comparison includes the losses. <a href="/features">Features</a>.</p>
      </div>
      <div class="home-why__rows">
        <article class="home-why__row">
          <h3>Agents get a chart.</h3>
          <p>
            An agent writes a JSON spec and gets a chart back. Validate and repair fix the safe mistakes without another
            model call. In one measured run, 42 of 42 were valid on the first try with the docs in the prompt.{' '}
            <code>repair()</code> lifted a no-docs run from 21/42 to 42/42. Round 6, 2026-10-16. Not re-run since.
          </p>
          <a class="home-more" href="/agents">Agents</a>
        </article>
        <article class="home-why__row">
          <h3>One object.</h3>
          <p>
            React, Vue, Svelte, vanilla JavaScript, and server SVG take the same JSON. Adapters do not add a second
            chart API.
          </p>
          <a class="home-more" href="/docs/concepts/adapters">Adapters</a>
        </article>
        <article class="home-why__row">
          <h3>Losses included.</h3>
          <p>
            The size-script line is {story.lineGzipBytes} bytes gzip, measured {story.sizeMeasured}. uPlot’s JavaScript
            is {story.uplotJsBytes} bytes. The stylesheet is {story.uplotCssBytes} bytes more, and the two sum to{" "}
            {story.uplotSumBytes}. First hover is slower than uPlot. The comparison table is the record.
          </p>
          <a class="home-more" href="/benchmarks">Benchmarks</a>
        </article>
      </div>
    </div>
  </section>
</Base>

<script>
  import "../scripts/mount-charts.ts";
</script>
