---
import "../styles/v2.css";
import Base from "../layouts/Base.astro";
import HomeBeyond from "../components/HomeBeyond.astro";
import HomeHero from "../components/HomeHero.astro";
import HomePaint from "../components/HomePaint.astro";
import HomeStart from "../components/HomeStart.astro";
import HomeTokens from "../components/HomeTokens.astro";
import HowItWorks from "../components/HowItWorks.astro";
import { SITE } from "../data/site";

const title = "One spec. Every framework. Built for agents.";
const lede =
  "Write a JSON ChartSpec once. Render it in React, Vue, Svelte, Astro, vanilla JS, or on the server. Agents write the spec; they never write the chart.";
---

<Base tone="light" title={title} description={lede || SITE.description}>
  <div class="v2">
    <HomeHero />
    <HowItWorks />
    <HomeTokens />
    <HomePaint />
  </div>
  <HomeStart />
  <div class="v2">
    <HomeBeyond />
  </div>
</Base>
