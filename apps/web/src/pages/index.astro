---
import "../styles/v2.css";
import Base from "../layouts/Base.astro";
import HomeBeyond from "../components/HomeBeyond.astro";
import HomeHero from "../components/HomeHero.astro";
import HomeRepair from "../components/HomeRepair.astro";
import HomeServer from "../components/HomeServer.astro";
import HomeStart from "../components/HomeStart.astro";
import HomeTokens from "../components/HomeTokens.astro";
import HowItWorks from "../components/HowItWorks.astro";
import { SITE } from "../data/site";

const title = "Charts an agent can write and a server can render";
const lede = "One JSON spec, validated and repaired locally, drawn as SVG in any framework or none.";
---

<Base tone="light" title={title} description={lede || SITE.description}>
  <div class="v2">
    <HomeHero />
  </div>
  <div class="home-sheet">
    <div class="v2">
      <HomeServer />
      <HomeTokens />
      <HomeRepair />
      <HowItWorks />
    </div>
  </div>
  <HomeStart />
  <div class="v2">
    <HomeBeyond />
  </div>
</Base>
