---
import "@fontsource/roboto/latin-400.css";
import "@fontsource/roboto/latin-500.css";
import "@fontsource/roboto/latin-700.css";
import "../styles/dashboards.css";
import Base from "../layouts/Base.astro";
import { loadIndex } from "../lib/dashboards";

const { boards } = loadIndex();
const description =
  "ChartKit dashboards. Each chart is a JSON spec. ChartKit is not affiliated with the products the boards are styled after.";
---

<Base title="Dashboard" description={description} tone="light">
  <div class="wrap">
    <header class="hero">
      <p class="kicker">Dashboard</p>
      <h1>Dashboard</h1>
      <p class="lede">
        Ten boards styled after familiar dashboards. Each chart is a JSON spec. Colour, grid, and series come from
        theme.tokens. The page CSS styles the shell. Fonts are Inter or Roboto. ChartKit is not affiliated with those
        products.
      </p>
    </header>
    <div class="board-index">
      {
        boards.map((board) => (
          <a class:list={["card", "board-card", board.defaultTheme === "midnight" && "board-card--night"]} href={`/dashboards/${board.slug}`}>
            <p class="kicker">{board.defaultTheme === "midnight" ? "Dark first" : "Soft first"}</p>
            <h2>{board.title}</h2>
            <p>{board.lede}</p>
            <div class="ck-frame cover-frame" role="img" aria-label={board.coverAlt} set:html={board.coverSvg} />
          </a>
        ))
      }
    </div>
  </div>
</Base>
