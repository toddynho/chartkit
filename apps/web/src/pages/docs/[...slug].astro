---
import DocArticle from "../../components/DocArticle.astro";
import ResponseRail from "../../components/ResponseRail.astro";
import { articleHref, articleSpec, docArticles, type DocArticle as Article } from "../../data/docs-catalog";
import Docs from "../../layouts/Docs.astro";

export function getStaticPaths() {
  return docArticles.flatMap((article) => {
    if (!article.slug || article.slug === "mcp") return [];
    const paths = [article.slug, ...article.aliases];
    return paths.map((slug) => ({
      params: { slug },
      props: { article, here: `/docs/${slug}` },
    }));
  });
}

interface Props {
  article: Article;
  here: string;
}

const { article, here } = Astro.props;
---

<Docs title={article.title} description={article.description} lede={article.lede} href={articleHref(article)}>
  <DocArticle article={article} here={here} />
  <ResponseRail slot="rail" spec={articleSpec} />
</Docs>
