---
import ResponseRail from "../../../components/ResponseRail.astro";
import SpecEditor from "../../../components/SpecEditor.astro";
import { articleChips, articleSpec } from "../../../data/docs-catalog";
import Docs from "../../../layouts/Docs.astro";

const description = "Editable ChartKit spec. The response rail validates and renders it with @chartkitdev/core.";
---

<Docs
  title="Playground"
  description={description}
  lede="Edit a spec, or switch Line, Bar, and Donut. The response rail validates and renders that JSON."
  href="/docs/reference/try"
>
  <p>
    This is the same editor as the chart pages.{' '}
    <code>validate()</code>
    {' '}and{' '}
    <code>render()</code>
    {' '}run from{' '}
    <code>@chartkitdev/core</code>
    {' '}in this page. Invalid specs show CK codes and no chart. Cloud is not called.
  </p>
  <SpecEditor spec={articleSpec} chips={articleChips} hint="Options sit beside the JSON — the response is on the right" />
  <ResponseRail slot="rail" spec={articleSpec} />
</Docs>
