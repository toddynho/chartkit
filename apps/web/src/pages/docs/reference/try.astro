---
import ResponseRail from "../../../components/ResponseRail.astro";
import SpecEditor from "../../../components/SpecEditor.astro";
import { articleChips, articleSpec } from "../../../data/docs-catalog";
import Docs from "../../../layouts/Docs.astro";

const description = "Editable ChartKit spec, chips beside the JSON, and an illustrative response rail.";
---

<Docs
  title="Playground"
  description={description}
  lede="Edit a spec, or switch Line, Bar, and Donut. The response rail draws from that JSON."
  href="/docs/reference/try"
>
  <p>
    This is the same editor as the rest of the docs. The rail does not call <code>@chartkitdev/core</code> or Cloud, and
    it does not run <code>validate()</code>.
  </p>
  <SpecEditor spec={articleSpec} chips={articleChips} hint="Options sit beside the JSON — the response is on the right" />
  <ResponseRail slot="rail" spec={articleSpec} />
</Docs>
