---
import PageNav from "../../components/PageNav.astro";
import QuickStart from "../../components/QuickStart.astro";
import { articleBySlug } from "../../data/docs-catalog";
import Docs from "../../layouts/Docs.astro";

const article = articleBySlug("");
if (!article) throw new Error("Docs overview is missing from the catalog.");
---

<Docs title={article.title} description={article.description} lede={article.lede} href="/docs">
  <QuickStart />
  <section class="qs-next">
    <h2>Next steps</h2>
    <ul>
      <li><a href="/docs/concepts/spec">Concepts</a>. The spec, data, and encoding.</li>
      <li><a href="/docs/validate">Validate</a>. Check a spec, then repair it.</li>
      <li><a href="/docs/theming">Theming</a>. Theme, tokens, and presets.</li>
      <li><a href="/gallery">Gallery</a>. Every chart type.</li>
      <li><a href="/playground">Playground</a>. Edit a spec and render it.</li>
    </ul>
  </section>
  <PageNav href="/docs" />
</Docs>
