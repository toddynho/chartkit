---
import DocArticle from "../../components/DocArticle.astro";
import ResponseRail from "../../components/ResponseRail.astro";
import { articleBySlug, articleChips, articleSpec } from "../../data/docs-catalog";
import Docs from "../../layouts/Docs.astro";

const article = articleBySlug("");
if (!article) throw new Error("Docs overview is missing from the catalog.");
---

<Docs title={article.title} description={article.description} lede={article.lede} href="/docs">
  <ol class="start-path">
    <li><a href="/docs/install">Install</a> — core, then the adapter for your framework.</li>
    <li><a href="/playground">First chart</a> — edit a spec and render it.</li>
    <li><a href="/gallery">Pick a type</a> — the gallery is the catalog of chart types.</li>
    <li><a href="/docs/theming">Customize</a> — theme, tokens, and presets.</li>
    <li><a href="/docs/validate">Ship</a> — validate, repair, and hand the spec to an agent.</li>
  </ol>
  <DocArticle article={article} here="/docs" />
  <ResponseRail slot="rail" spec={articleSpec} chips={articleChips} />
</Docs>
