---
import { chartTypes } from "../../../data/chart-types";
import { chartDocs } from "../../../data/docs-catalog";
import Docs from "../../../layouts/Docs.astro";

const families = ["Core", "Statistical", "Planning"] as const;
const inNav = new Set(chartDocs.map((chart) => chart.type));
const library = chartTypes.filter((chart) => !inNav.has(chart.type));
const description = "ChartKit chart types. Core, Statistical, and Planning are in the left nav. Other production URLs stay reachable here.";
---

<Docs
  title="Chart types"
  description={description}
  lede="Each type has an extensionless page at /docs/charts/<type>. The left nav lists Core, Statistical, and Planning. Types that are on chartkit.dev and outside that series stay in Library."
  href="/docs/charts"
>
  {
    families.map((family) => (
      <section>
        <h2>{family}</h2>
        <ul class="type-list">
          {chartDocs
            .filter((chart) => chart.family === family)
            .map((chart) => (
              <li>
                <a href={`/docs/charts/${chart.type}`}>
                  <strong>{chart.label}</strong>
                  <span>{chart.lede}</span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
  <section>
    <h2>Library</h2>
    <p>These production URLs are real pages. They are not a fourth group in the left nav.</p>
    <ul class="type-list">
      {
        library.map((chart) => (
          <li>
            <a href={`/docs/charts/${chart.type}`}>
              <strong>{chart.title}</strong>
              <span>{chart.summary}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
  <section id="maps">
    <h2>Maps</h2>
    <p>
      Choropleth and point maps are painted with <code>@chartkitdev/geo</code>. They are not core schema types. Open one in
      the gallery to edit the spec. There is no tile layer.
    </p>
    <ul class="type-list">
      <li>
        <a href="/gallery#map-world">
          <strong>World choropleth</strong>
          <span>Renewable share of electricity.</span>
        </a>
      </li>
      <li>
        <a href="/gallery#map-us">
          <strong>United States</strong>
          <span>Population change, 2020–2023.</span>
        </a>
      </li>
      <li>
        <a href="/gallery#map-cities">
          <strong>Cities</strong>
          <span>Largest urban areas.</span>
        </a>
      </li>
    </ul>
  </section>
</Docs>
