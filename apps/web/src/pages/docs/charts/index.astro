---
import { chartByType, chartTypes } from "../../../data/chart-types";
import { chartDocs, chartPage } from "../../../data/docs-catalog";
import { galleryTileSvg } from "../../../data/hero-slides";
import { loadMaps } from "../../../lib/batch3";
import Docs from "../../../layouts/Docs.astro";

const families = ["Core", "Statistical", "Planning"] as const;
const inCatalog = new Set(chartDocs.map((chart) => chart.type));
const maps = loadMaps();

function tile(type: string, title: string) {
  const svg = galleryTileSvg(type);
  if (!svg.includes("<svg") || svg.includes("ck-chart-error")) {
    throw new Error(`Chart types could not paint ${type}`);
  }
  const summary = chartByType(type)?.summary ?? chartPage(type).lede;
  return { id: type, title, summary, svg, href: `/docs/charts/${type}` };
}

const groups = [
  ...families.map((family) => ({
    id: family.toLowerCase(),
    family,
    note: "",
    charts: chartDocs.filter((chart) => chart.family === family).map((chart) => tile(chart.type, chart.label)),
  })),
  {
    id: "library",
    family: "Library",
    note: "These production URLs are real pages. They are not a fourth group in the left nav.",
    charts: chartTypes.filter((chart) => !inCatalog.has(chart.type)).map((chart) => tile(chart.type, chart.title)),
  },
  {
    id: "maps",
    family: "Maps",
    note: "Choropleth and point maps are painted with @chartkitdev/geo. They are not core schema types, and there is no tile layer.",
    charts: [
      {
        id: "map-world",
        title: "World choropleth",
        summary: "Renewable share of electricity.",
        svg: maps.world.svg,
        href: "/gallery#map-world",
      },
      {
        id: "map-us",
        title: "United States",
        summary: "Population change, 2020–2023.",
        svg: maps.us.svg,
        href: "/gallery#map-us",
      },
      {
        id: "map-cities",
        title: "Cities",
        summary: "Largest urban areas.",
        svg: maps.cities.svg,
        href: "/gallery#map-cities",
      },
    ],
  },
];

const count = groups.reduce((total, group) => total + group.charts.length, 0);
const description = `${count} ChartKit chart types, with a preview of each. Core, Statistical, and Planning stay in the left nav.`;
---

<Docs
  title="Chart types"
  description={description}
  lede="Each type has an extensionless page under /docs/charts/. The left nav lists Core, Statistical, and Planning. Other production URLs stay under Library."
  href="/docs/charts"
>
  {
    groups.map((group) => (
      <section class="gallery-family" id={group.id} aria-labelledby={`docs-charts-${group.id}`}>
        <h2 id={`docs-charts-${group.id}`}>
          {group.family}
          <span> · {group.charts.length}</span>
        </h2>
        {group.note ? <p class="gallery-note">{group.note}</p> : null}
        <div class="gallery-grid">
          {group.charts.map((chart) => (
            <a class="card" href={chart.href}>
              <span class="gallery-chart" aria-hidden="true" set:html={chart.svg} />
              <h3>{chart.title}</h3>
              <p>{chart.summary}</p>
            </a>
          ))}
        </div>
      </section>
    ))
  }
</Docs>
