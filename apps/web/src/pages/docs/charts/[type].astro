---
import ChartDoc from "../../../components/ChartDoc.astro";
import ResponseRail from "../../../components/ResponseRail.astro";
import { chartTypes } from "../../../data/chart-types";
import { chartDocs, chartPage, chipsForChart, specForChart } from "../../../data/docs-catalog";
import Docs from "../../../layouts/Docs.astro";

export function getStaticPaths() {
  const types = [...new Set([...chartTypes.map((chart) => chart.type), ...chartDocs.map((chart) => chart.type)])];
  return types.map((type) => ({ params: { type } }));
}

const chart = chartPage(Astro.params.type ?? "");
const spec = specForChart(chart);
const href = `/docs/charts/${chart.type}`;
---

<Docs title={chart.title} description={chart.description} lede={chart.lede} href={href}>
  <ChartDoc chart={chart} />
  <ResponseRail slot="rail" spec={spec} chips={chipsForChart(chart.type)} />
</Docs>
