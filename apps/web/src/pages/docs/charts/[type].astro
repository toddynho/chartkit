---
import BarGuide from "../../../components/BarGuide.astro";
import ChartDoc from "../../../components/ChartDoc.astro";
import ComboGuide from "../../../components/ComboGuide.astro";
import DonutGuide from "../../../components/DonutGuide.astro";
import FunnelGuide from "../../../components/FunnelGuide.astro";
import LineGuide from "../../../components/LineGuide.astro";
import PieGuide from "../../../components/PieGuide.astro";
import RadialBarGuide from "../../../components/RadialBarGuide.astro";
import ResponseRail from "../../../components/ResponseRail.astro";
import RoseGuide from "../../../components/RoseGuide.astro";
import ScatterGuide from "../../../components/ScatterGuide.astro";
import StackedAreaGuide from "../../../components/StackedAreaGuide.astro";
import SunburstGuide from "../../../components/SunburstGuide.astro";
import TeachChart from "../../../components/TeachChart.astro";
import TreemapGuide from "../../../components/TreemapGuide.astro";
import { chartPage, chartPageTypes, chipsForChart, specForChart } from "../../../data/docs-catalog";
import { teachModule, teachModules } from "../../../data/teach/registry";
import Docs from "../../../layouts/Docs.astro";

const guided = new Set([
  "donut",
  "pie",
  "line",
  "bar",
  "scatter",
  "combo",
  "stacked-area",
  "funnel",
  "treemap",
  "sunburst",
  "rose",
  "radial-bar",
]);
for (const key of Object.keys(teachModules)) {
  if (!guided.has(key)) throw new Error(`Add a guide for the ${key} teach module in this page.`);
}

export function getStaticPaths() {
  return chartPageTypes.map((type) => ({ params: { type } }));
}

const typeName = Astro.params.type ?? "";
const module = teachModule(typeName);
const chart = chartPage(typeName);
const spec = specForChart(chart);
const href = `/docs/charts/${chart.type}`;
const geoCopy: Record<string, { title: string; lede: string }> = {
  choropleth: {
    title: "Choropleth",
    lede: "A shaded map from @chartkitdev/geo. No tile layer, and no pan or zoom.",
  },
  "map-points": {
    title: "Map points",
    lede: "Points on a map from @chartkitdev/geo. No tile layer, and no pan or zoom.",
  },
};
const geo = geoCopy[chart.type];
const title = geo?.title ?? chart.title;
const lede = geo?.lede ?? chart.lede;
---

{
  module ? (
    <TeachChart module={module}>
      {module.type === "donut" ? <DonutGuide /> : null}
      {module.type === "pie" ? <PieGuide /> : null}
      {module.type === "line" ? <LineGuide /> : null}
      {module.type === "bar" ? <BarGuide /> : null}
      {module.type === "scatter" ? <ScatterGuide /> : null}
      {module.type === "combo" ? <ComboGuide /> : null}
      {module.type === "stacked-area" ? <StackedAreaGuide /> : null}
      {module.type === "funnel" ? <FunnelGuide /> : null}
      {module.type === "treemap" ? <TreemapGuide /> : null}
      {module.type === "sunburst" ? <SunburstGuide /> : null}
      {module.type === "rose" ? <RoseGuide /> : null}
      {module.type === "radial-bar" ? <RadialBarGuide /> : null}
    </TeachChart>
  ) : (
    <Docs title={title} description={lede} lede={lede} href={href}>
      <ChartDoc chart={chart} />
      {geo ? null : <ResponseRail slot="rail" spec={spec} chips={chipsForChart(chart.type)} />}
    </Docs>
  )
}
