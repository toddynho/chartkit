---
import AreaRangeGuide from "../../../components/AreaRangeGuide.astro";
import BarGuide from "../../../components/BarGuide.astro";
import BoxplotGuide from "../../../components/BoxplotGuide.astro";
import BarListGuide from "../../../components/BarListGuide.astro";
import BarRangeGuide from "../../../components/BarRangeGuide.astro";
import CandlestickGuide from "../../../components/CandlestickGuide.astro";
import ChartDoc from "../../../components/ChartDoc.astro";
import ChoroplethGuide from "../../../components/ChoroplethGuide.astro";
import ComboGuide from "../../../components/ComboGuide.astro";
import DensityGuide from "../../../components/DensityGuide.astro";
import DonutGuide from "../../../components/DonutGuide.astro";
import ErrorbarGuide from "../../../components/ErrorbarGuide.astro";
import FunnelGuide from "../../../components/FunnelGuide.astro";
import GanttGuide from "../../../components/GanttGuide.astro";
import HeatmapGuide from "../../../components/HeatmapGuide.astro";
import HistogramGuide from "../../../components/HistogramGuide.astro";
import JourneyGuide from "../../../components/JourneyGuide.astro";
import LineGuide from "../../../components/LineGuide.astro";
import MapPointsGuide from "../../../components/MapPointsGuide.astro";
import MiniAreaGuide from "../../../components/MiniAreaGuide.astro";
import PieGuide from "../../../components/PieGuide.astro";
import QuadrantGuide from "../../../components/QuadrantGuide.astro";
import RadarGuide from "../../../components/RadarGuide.astro";
import RadialBarGuide from "../../../components/RadialBarGuide.astro";
import ResponseRail from "../../../components/ResponseRail.astro";
import RoseGuide from "../../../components/RoseGuide.astro";
import SankeyGuide from "../../../components/SankeyGuide.astro";
import ScatterGuide from "../../../components/ScatterGuide.astro";
import SparklineGuide from "../../../components/SparklineGuide.astro";
import SpikeGuide from "../../../components/SpikeGuide.astro";
import StackedAreaGuide from "../../../components/StackedAreaGuide.astro";
import StreamgraphGuide from "../../../components/StreamgraphGuide.astro";
import StripGuide from "../../../components/StripGuide.astro";
import SunburstGuide from "../../../components/SunburstGuide.astro";
import TeachChart from "../../../components/TeachChart.astro";
import TimelineGuide from "../../../components/TimelineGuide.astro";
import TreeGuide from "../../../components/TreeGuide.astro";
import TreemapGuide from "../../../components/TreemapGuide.astro";
import VennGuide from "../../../components/VennGuide.astro";
import WaterfallGuide from "../../../components/WaterfallGuide.astro";
import GaugeGuide from "../../../components/GaugeGuide.astro";
import KpiGuide from "../../../components/KpiGuide.astro";
import ProgressRingGuide from "../../../components/ProgressRingGuide.astro";
import BulletGuide from "../../../components/BulletGuide.astro";
import { chartPage, chartPageTypes, chipsForChart, specForChart } from "../../../data/docs-catalog";
import { teachModule, teachModules } from "../../../data/teach/registry";
import Docs from "../../../layouts/Docs.astro";

const guided = new Set([
  "donut",
  "pie",
  "line",
  "bar",
  "scatter",
  "combo",
  "stacked-area",
  "funnel",
  "treemap",
  "sunburst",
  "rose",
  "radial-bar",
  "sankey",
  "waterfall",
  "tree",
  "streamgraph",
  "gantt",
  "timeline",
  "quadrant",
  "venn",
  "journey",
  "area-range",
  "bar-range",
  "errorbar",
  "sparkline",
  "mini-area",
  "spike",
  "bar-list",
  "heatmap",
  "radar",
  "candlestick",
  "gauge",
  "kpi",
  "progress-ring",
  "bullet",
  "choropleth",
  "map-points",
  "histogram",
  "density",
  "boxplot",
  "strip",
]);
for (const key of Object.keys(teachModules)) {
  if (!guided.has(key)) throw new Error(`Add a guide for the ${key} teach module in this page.`);
}

export function getStaticPaths() {
  return chartPageTypes.map((type) => ({ params: { type } }));
}

const typeName = Astro.params.type ?? "";
const module = teachModule(typeName);
const chart = chartPage(typeName);
const spec = specForChart(chart);
const href = `/docs/charts/${chart.type}`;
const geoCopy: Record<string, { title: string; lede: string }> = {
  choropleth: {
    title: "Choropleth",
    lede: "A shaded map from @chartkitdev/geo. No tile layer, and no pan or zoom.",
  },
  "map-points": {
    title: "Map points",
    lede: "Points on a map from @chartkitdev/geo. No tile layer, and no pan or zoom.",
  },
};
const geo = geoCopy[chart.type];
const title = geo?.title ?? chart.title;
const lede = geo?.lede ?? chart.lede;
---

{
  module ? (
    <TeachChart module={module}>
      {module.type === "donut" ? <DonutGuide /> : null}
      {module.type === "pie" ? <PieGuide /> : null}
      {module.type === "line" ? <LineGuide /> : null}
      {module.type === "bar" ? <BarGuide /> : null}
      {module.type === "scatter" ? <ScatterGuide /> : null}
      {module.type === "combo" ? <ComboGuide /> : null}
      {module.type === "stacked-area" ? <StackedAreaGuide /> : null}
      {module.type === "funnel" ? <FunnelGuide /> : null}
      {module.type === "treemap" ? <TreemapGuide /> : null}
      {module.type === "sunburst" ? <SunburstGuide /> : null}
      {module.type === "rose" ? <RoseGuide /> : null}
      {module.type === "radial-bar" ? <RadialBarGuide /> : null}
      {module.type === "sankey" ? <SankeyGuide /> : null}
      {module.type === "waterfall" ? <WaterfallGuide /> : null}
      {module.type === "tree" ? <TreeGuide /> : null}
      {module.type === "streamgraph" ? <StreamgraphGuide /> : null}
      {module.type === "gantt" ? <GanttGuide /> : null}
      {module.type === "timeline" ? <TimelineGuide /> : null}
      {module.type === "quadrant" ? <QuadrantGuide /> : null}
      {module.type === "venn" ? <VennGuide /> : null}
      {module.type === "journey" ? <JourneyGuide /> : null}
      {module.type === "area-range" ? <AreaRangeGuide /> : null}
      {module.type === "bar-range" ? <BarRangeGuide /> : null}
      {module.type === "errorbar" ? <ErrorbarGuide /> : null}
      {module.type === "sparkline" ? <SparklineGuide /> : null}
      {module.type === "mini-area" ? <MiniAreaGuide /> : null}
      {module.type === "spike" ? <SpikeGuide /> : null}
      {module.type === "bar-list" ? <BarListGuide /> : null}
      {module.type === "heatmap" ? <HeatmapGuide /> : null}
      {module.type === "radar" ? <RadarGuide /> : null}
      {module.type === "candlestick" ? <CandlestickGuide /> : null}
      {module.type === "gauge" ? <GaugeGuide /> : null}
      {module.type === "kpi" ? <KpiGuide /> : null}
      {module.type === "progress-ring" ? <ProgressRingGuide /> : null}
      {module.type === "bullet" ? <BulletGuide /> : null}
      {module.type === "choropleth" ? <ChoroplethGuide /> : null}
      {module.type === "map-points" ? <MapPointsGuide /> : null}
      {module.type === "histogram" ? <HistogramGuide /> : null}
      {module.type === "density" ? <DensityGuide /> : null}
      {module.type === "boxplot" ? <BoxplotGuide /> : null}
      {module.type === "strip" ? <StripGuide /> : null}
    </TeachChart>
  ) : (
    <Docs title={title} description={lede} lede={lede} href={href}>
      <ChartDoc chart={chart} />
      {geo ? null : <ResponseRail slot="rail" spec={spec} chips={chipsForChart(chart.type)} />}
    </Docs>
  )
}
