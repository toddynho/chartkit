---
import "../../../styles/surfaces.css";
import DocsPage from "../../../components/DocsPage.astro";

const description = "A million-point canvas line and a live Float64Array stream. Axes stay SVG.";
const modes = [
  { id: "svg", label: "SVG + sampling" },
  { id: "canvas", label: "Canvas" },
  { id: "none", label: "Sampling none" },
];
---

<DocsPage
  title="Large data"
  description={description}
  href="/docs/concepts/large-data"
  lede="The same sensor trace as SVG with sampling, as canvas marks, or with sampling left off. Axes stay SVG."
>
  <div class="mode-toggle" role="group" aria-label="Renderer">
    {
      modes.map((item) => (
        <button
          type="button"
          class={item.id === "canvas" ? "btn btn-primary" : "btn btn-secondary"}
          aria-pressed={item.id === "canvas" ? "true" : "false"}
          data-large-mode={item.id}
        >
          {item.label}
        </button>
      ))
    }
  </div>
  <section class="section">
    <h2>One million points</h2>
    <p>
      A sensor trace with a slow cycle, a drift, noise, spikes, and short gaps. LTTB and minmax keep the spikes.
      Sampling none draws every point.
    </p>
    <div class="ck-frame" data-large-host></div>
    <p class="meta" data-large-readout>Building one million points…</p>
  </section>
  <section class="section">
    <h2>Streaming append</h2>
    <p>
      Each tick appends 24 points and keeps the last 100,000. Columns stay <code>Float64Array</code>s.
    </p>
    <div class="ck-frame" data-stream-canvas></div>
    <p class="meta" data-stream-canvas-readout>Starting the stream…</p>
  </section>
</DocsPage>

<script>
  import "../../../scripts/large-demo.ts";
</script>
