---
import "../styles/playground.css";
import Base from "../layouts/Base.astro";
import { loadExample, loadExamplesIndex } from "../lib/surfaces";
import { scriptJson } from "../lib/spec-text";

const data = loadExamplesIndex();
const examples = data.examples.map((card) => {
  const file = loadExample(card.slug);
  return { slug: file.slug, title: file.title, type: file.type, svg: file.svg, spec: file.spec };
});
if (!examples.length) throw new Error("Playground has no examples.");
const description = "Edit a ChartKit spec in the playground. Options, JSON, and data stay in sync, and the preview renders with ChartKit.";
---

<Base title="Playground" description={description} tone="light">
  <div class="play" id="play"></div>
  <script id="play-data" type="application/json" is:inline set:html={scriptJson({ examples })} />
  <script>
    import { mountPlayground } from "../scripts/playground";

    const root = document.querySelector<HTMLElement>("#play");
    const raw = document.querySelector<HTMLScriptElement>("#play-data")?.textContent;
    if (root && raw) mountPlayground(root, JSON.parse(raw) as { examples: { slug: string; title: string; type: string; svg: string; spec: Record<string, unknown> }[] });
  </script>
</Base>
