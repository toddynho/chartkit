---
import "../styles/surfaces.css";
import Base from "../layouts/Base.astro";
import LiveSpec from "../components/LiveSpec.astro";
import { loadExample, loadExamplesIndex, loadPlayground } from "../lib/surfaces";

const data = loadExamplesIndex();
const files = data.examples.map((example) => loadExample(example.slug));
const starter = files[0];
if (!starter) throw new Error("Playground has no examples.");
const { themes } = loadPlayground();
const exampleSpecs = Object.fromEntries(files.map((file) => [file.slug, file.spec]));
const description = "Edit a ChartKit spec and preview it. Every option for the chart type is in the panel. Validate, repair, share, and export SVG or PNG.";
---

<Base title="Playground" description={description} tone="light">
  <div class="surface example-play">
    <header class="hero wrap">
      <p class="kicker">Playground</p>
      <h1>Playground</h1>
      <p class="lede">
        The spec, the preview, and the options use the width of the window. Search the panel or open a section; the common options are listed first. Validate, repair, share, and SVG or PNG export use
        <code>@chartkitdev/core</code>, and maps use <code>@chartkitdev/geo</code>. Chart types are listed in the
        <a href="/gallery">gallery</a>. Worked examples sit on each <a href="/docs">chart’s docs page</a>.
      </p>
    </header>
    <LiveSpec
      spec={starter.spec}
      svg={starter.svg}
      mode="full"
      themes={themes}
      examples={data.examples}
      exampleSpecs={exampleSpecs}
      activeSlug={starter.slug}
    />
  </div>
</Base>
