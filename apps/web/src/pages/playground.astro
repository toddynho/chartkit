---
import "../styles/surfaces.css";
import Base from "../layouts/Base.astro";
import LiveSpec from "../components/LiveSpec.astro";
import { loadPlayground } from "../lib/surfaces";

const playground = loadPlayground();
const description = "Edit a ChartKit spec, validate it, repair it, and export SVG or PNG.";
---

<Base title="Playground" description={description} tone="light">
  <div class="wrap surface">
    <header class="hero">
      <p class="kicker">Playground</p>
      <h1>Playground</h1>
      <p class="lede">
        Edit the spec. The preview renders with <code>@chartkitdev/core</code>. Validate and Repair call the same
        functions an agent would. Share puts the spec in the URL hash. A preset theme opts out of the page colors.
      </p>
    </header>
    <LiveSpec spec={playground.spec} svg={playground.svg} mode="full" themes={playground.themes} />
  </div>
</Base>
