---
import "../../styles/surfaces.css";
import Base from "../../layouts/Base.astro";
import { loadFeatureIndex } from "../../lib/surfaces";

const data = loadFeatureIndex();
const byCategory = new Map<string, typeof data.features>();
for (const feature of data.features) {
  const list = byCategory.get(feature.category) ?? [];
  list.push(feature);
  byCategory.set(feature.category, list);
}
const gzip = data.chartkit.bundleGzip as {
  minimalLine?: number | null;
  source?: string;
  commit?: string;
  measured?: string;
  method?: string;
  note?: string;
} | null;
const description =
  "263 charting features across ChartKit and 20 other libraries, with status, verification, and source for every cell.";
---

<Base title="Features" description={description} tone="light">
  <div class="wrap surface">
    <header class="hero">
      <p class="kicker">Features</p>
      <h1>Feature matrix</h1>
      <p class="lede">
        {data.features.length} features in {data.taxonomy.length} categories, scored for ChartKit and{" "}
        {data.libraries.length - 1} other libraries. Every cell has a status, a verification level, and a source.
        Unknown stays unknown.
      </p>
    </header>
    <p>
      Machine-readable copy: <a href="/features.json">features.json</a> ({data.schemaVersion}, generated {data.generated}
      ). Each feature also has a <a href="/features/axis.title.md">Markdown</a> twin for agents. ChartKit on this file is{" "}
      {data.chartkit.version}, rechecked {data.chartkitRechecked}.
    </p>
    <ul class="counts">
      <li><b>{data.coverage.strong}</b> strong</li>
      <li><b>{data.coverage.weak}</b> weak</li>
      <li><b>{data.coverage.absence}</b> absence-checked none</li>
      <li><b>{data.coverage.unknown}</b> unknown</li>
    </ul>
    {
      data.taxonomy.map((category) => (
        <section id={category.id}>
          <h2>{category.label}</h2>
          <p>{category.desc}</p>
          <ul class="feature-list">
            {(byCategory.get(category.id) ?? []).map((feature) => (
              <li>
                <a href={`/features/${feature.id}`}>{feature.label}</a>
                <span class={`badge badge-${feature.badge}`}>{feature.badge}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
    <section id="method">
      <h2>Method</h2>
      <p>
        Other libraries were checked on {data.dateChecked} against the shipped TypeScript types or, for Plotly, the plot
        schema. That is not a render test. A typed option can be incomplete, which favours those libraries when you
        compare. ChartKit is held to a runtime probe: the status is native only when changing the option changes the
        SVG. ChartKit was rechecked on {data.chartkitRechecked} against main <code>{data.chartkitCommit}</code>. Axis
        titles, ticks, rotation, side, nice, reverse, padding, description, and legend values draw through{" "}
        <code>createRenderer([line])</code>. <code>mark.labels</code> on line, stacked-area, and scatter warns CK3012
        and is not drawn. Bar and donut still draw labels.
      </p>
      <p>
        Statuses are native, partial, plugin, manual, none, and unknown. Verification <code>dts-path</code>,{" "}
        <code>schema-path</code>, <code>dts-index</code>, <code>runtime-probe</code>, and <code>source-review</code>{" "}
        are strong. <code>dts-absence</code> is a moderate check that a none claim did not match an identifier.{" "}
        <code>dts-grep</code>, <code>dts-mechanism</code>, <code>npm</code>, and <code>doc-cited</code> are weak.{" "}
        <code>conflict</code> and <code>unverified</code> are unknown. Counts are the coverage block in{" "}
        <a href="/features.json">features.json</a>.
      </p>
      <p>{data.synonymsNote}</p>
      <p>
        Source files are in <code>catalog/data/matrix/</code>. <code>npm run matrix:refresh</code> rewrites this data.
        Steps are in <code>catalog/data/matrix/README.md</code>.
      </p>
      {
        gzip?.minimalLine != null ? (
          <p>
            ChartKit line gzip in <a href="/features.json">features.json</a> is {gzip.minimalLine.toLocaleString("en-US")}{" "}
            bytes from {gzip.source}, commit <code>{gzip.commit}</code>, measured {gzip.measured}. {gzip.method}{" "}
            {gzip.note} Libraries the bench remeasured store that run on <code>bundleGzip</code>. The rest keep the
            matrix extract and say so in <code>bundleGzip.measured</code>.
          </p>
        ) : null
      }
      <h3>Not scored</h3>
      <ul>
        {data.notScored.map((item) => (
          <li>
            <strong>{item.name}</strong> — {item.reason}
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
