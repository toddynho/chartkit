{
  "shell": "Page CSS owns the page grid, cards, and tabs. The JSON spec owns colour, grid, axes, marks, and legends.",
  "closed": [
    {
      "key": "mark.track",
      "values": [
        "bar",
        "row"
      ],
      "effect": "On bar-list, row is a full-height wash behind the label. bar is the short rounded bar."
    },
    {
      "key": "axes.x.title",
      "values": [
        ""
      ],
      "also": [
        "axes.y.title",
        "axes.y2.title"
      ],
      "effect": "An empty string is kept and is not drawn. Omitting the title still copies the series name onto the axis."
    },
    {
      "key": "headline.label",
      "also": [
        "headline.value",
        "headline.compare",
        "headline.delta",
        "headline.tone"
      ],
      "effect": "Draws a label, a value, a comparison figure, and a delta pill. tone is positive, negative, or neutral."
    },
    {
      "key": "mark.partial",
      "values": [
        "dashed",
        "dotted"
      ],
      "effect": "Dashes the last segment."
    },
    {
      "key": "mark.partialOpacity",
      "effect": "Paints the last segment's area at its own opacity. The earlier area keeps mark.fillOpacity."
    },
    {
      "key": "theme.tokens.surface",
      "values": [
        "transparent"
      ],
      "also": [
        "theme.tokens.background",
        "theme.tokens.grid"
      ],
      "effect": "theme.tokens accepts the keyword transparent. Scorecards set surface and grid to transparent so the shell card is the only card."
    },
    {
      "key": "axes.y.format",
      "values": [
        "duration-hm"
      ],
      "also": [
        "axes.x.format",
        "axes.y2.format",
        "encoding.y.format",
        "encoding.y[].format"
      ],
      "effect": "duration-hm prints 2m 24s for 144000."
    },
    {
      "key": "encoding.color.range",
      "effect": "Two or more #rrggbb stops. A choropleth uses them as a sequential ramp. A heatmap uses them as a continuous ramp. A one-stop or non-hex range is ignored. The default choropleth ramp stays green."
    },
    {
      "key": "mark.nodata",
      "values": [
        "fill"
      ],
      "effect": "Choropleth fill paints missing countries with mark.land and does not hatch them."
    },
    {
      "key": "mark.land",
      "also": [
        "mark.water"
      ],
      "effect": "Choropleth land and water accept #rrggbb."
    },
    {
      "key": "encoding.y[].fillOpacity",
      "effect": "A y series fillOpacity overrides mark.fillOpacity for that series."
    },
    {
      "key": "theme.tokens.fontFamily",
      "effect": "Written as --ck-font-family on the chart."
    },
    {
      "key": "theme.tokens.fontSize",
      "effect": "Sets tick and axis-title size."
    },
    {
      "key": "theme.mode",
      "values": [
        "dark",
        "light",
        "auto"
      ],
      "effect": "dark starts from the midnight colour base. light on the midnight preset starts from the soft colour base. Geometry stays on the named preset."
    },
    {
      "key": "tooltip.background",
      "also": [
        "tooltip.radius",
        "tooltip.shadow",
        "tooltip.crosshairColor"
      ],
      "effect": "Recorded on the chart and read by the tooltip card."
    },
    {
      "key": "axes.x.ticks",
      "values": [
        "ends"
      ],
      "also": [
        "axes.y.ticks",
        "axes.y2.ticks"
      ],
      "effect": "ends labels only the first and last tick. Gross volume sets axes.x.ticks to ends."
    },
    {
      "key": "legend.position",
      "values": [
        "bottom"
      ],
      "effect": "On a choropleth, bottom draws a horizontal ramp."
    },
    {
      "key": "mark.stackGap",
      "effect": "Pixel gap between stacked segments on bar, stacked-area, and combo."
    },
    {
      "key": "mark.radiusEnds",
      "values": [
        "all",
        "outer"
      ],
      "effect": "all rounds every corner of a bar. outer rounds the end away from the baseline."
    }
  ],
