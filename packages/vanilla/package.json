{
  "name": "@chartkitdev/vanilla",
  "version": "0.5.0",
  "description": "Mount a ChartKit JSON spec into an element. No framework. The core line chart is 12,171 B gzip. Evidence: https://chartkit.dev/benchmarks",
  "keywords": ["chart", "svg", "vanilla", "chartkit"],
  "author": "Todd Garland",
  "homepage": "https://chartkit.dev",
  "bugs": {
    "url": "https://github.com/toddynho/chartkit/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@chartkitdev/core": "*"
  },
  "devDependencies": {
    "jsdom": "^27.0.1",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toddynho/chartkit",
    "directory": "packages/vanilla"
  },
  "publishConfig": {
    "access": "public"
  }
}
