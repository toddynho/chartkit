exports[`render SVG > draws a bar chart 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="240" viewBox="0 0 640 240" role="img" aria-label="Signups peaked in February at 180, after 100 in January." class="ck-chart" data-ck-type="bar" data-ck-id="ck17ux6xf" style="font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Signups by month</title><desc>Signups peaked in February at 180, after 100 in January.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><text x="68" y="22" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="15" font-weight="650" font-family="var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif)">Signups by month</text><defs><clipPath id="ck17ux6xf1nzwles"><rect x="68" y="34" width="556" height="174" /></clipPath><linearGradient id="ck17ux6xf-g0" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84ff)))" stop-opacity="var(--ck-area-opacity, 0.22)" /><stop offset="62%" stop-color="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84ff)))" stop-opacity="calc(var(--ck-area-opacity, 0.22) * 0.35)" /><stop offset="100%" stop-color="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84ff)))" stop-opacity="0" /></linearGradient></defs><line x1="68" y1="208" x2="624" y2="208" stroke="var(--ck-grid, light-dark(rgb(0 0 0 / 0.05), rgb(245 245 247 / 0.07)))" /><line x1="68" y1="164.5" x2="624" y2="164.5" stroke="var(--ck-grid, light-dark(rgb(0 0 0 / 0.05), rgb(245 245 247 / 0.07)))" /><line x1="68" y1="121" x2="624" y2="121" stroke="var(--ck-grid, light-dark(rgb(0 0 0 / 0.05), rgb(245 245 247 / 0.07)))" /><line x1="68" y1="77.5" x2="624" y2="77.5" stroke="var(--ck-grid, light-dark(rgb(0 0 0 / 0.05), rgb(245 245 247 / 0.07)))" /><line x1="68" y1="34" x2="624" y2="34" stroke="var(--ck-grid, light-dark(rgb(0 0 0 / 0.05), rgb(245 245 247 / 0.07)))" /><g clip-path="url(#ck17ux6xf1nzwles)"><