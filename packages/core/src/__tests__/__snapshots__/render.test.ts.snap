exports[`remaining chart renderers > draws gauge 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="180" viewBox="0 0 240 180" role="img" aria-label="Capacity is 72 out of 100, below the target of 80." class="ck-chart" data-ck-type="gauge" data-ck-renderer="gauge" data-ck-id="ckzqbxxc" style="font-family:var(--ck-font-family, inherit);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Capacity is 72 out of 100, below the target of 80.</title><desc>Capacity is 72 out of 100, below the target of 80.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><path data-ck-mark="gauge-track" aria-label="72" data-ck-target="80" d="M 77.33 147.09 A 60.35 60.35 0 1 1 162.67 147.09" fill="none" stroke="var(--ck-track, light-dark(#6e6e73, #98989d))" stroke-width="18.12" stroke-linecap="butt" /><path data-ck-mark="gauge-band" d="M 87.59 136.82 A 45.84 45.84 0 0 1 120 58.57" fill="none" stroke="var(--ck-negative, light-dark(#be123c, #ff453a))" stroke-width="2.9" stroke-linecap="butt" stroke-opacity="0.55" aria-label="Low 0–50"><title>Low 0–50</title></path><path data-ck-mark="gauge-band" d="M 120 58.57 A 45.84 45.84 0 0 1 152.41 136.82" fill="none" stroke="var(--ck-positive, light-dark(#15803d, #30d158))" stroke-width="2.9" stroke-linecap="butt" stroke-opacity="0.55" aria-label="OK 50–100"><title>OK 50–100</title></path><path data-ck-mark="gauge-value" d="M 77.33 147.09 A 60.35 60.35 0 1 1 171.95 73.69" fill="none" stroke="var(--ck-positive, light-dark(#15803d, #30d158))" stroke-width="18.12" stroke-linecap="butt" /><line data-ck-mark="gauge-tick" x1="69.5" y1="154.91" x2="64.55" y2="159.86" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" /><text data-ck-mark="gauge-tick-label" x="56.07" y="168.34" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">0</text><line data-ck-mark="gauge-tick" x1="54.02" y1="77.08" x2="47.56" y2="74.41" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" /><text data-ck-mark="gauge-tick-label" x="36.47" y="69.81" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">25</text><line data-ck-mark="gauge-tick" x1="120" y1="33" x2="120" y2="26" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" /><text data-ck-mark="gauge-tick-label" x="120" y="14" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">50</text><line data-ck-mark="gauge-tick" x1="185.98" y1="77.08" x2="192.44" y2="74.41" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" /><text data-ck-mark="gauge-tick-label" x="203.53" y="69.81" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">75</text><line data-ck-mark="gauge-tick" x1="170.5" y1="154.91" x2="175.45" y2="159.86" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" /><text data-ck-mark="gauge-tick-label" x="183.93" y="168.34" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">100</text><line data-ck-mark="gauge-needle" x1="120" y1="104.41" x2="164.15" y2="78.3" stroke="var(--ck-positive, light-dark(#15803d, #30d158))" stroke-width="2.17" stroke-linecap="round" /><circle data-ck-mark="gauge-hub" aria-label="72" cx="120" cy="104.41" r="4.5" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke="var(--ck-positive, light-dark(#15803d, #30d158))" stroke-width="2" /><text data-ck-mark="gauge-readout" aria-label="72" x="120" y="91.14" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-positive, light-dark(#15803d, #30d158))" font-size="24" font-weight="650">72</text><text data-ck-mark="gauge-caption" x="12