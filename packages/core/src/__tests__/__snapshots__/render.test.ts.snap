exports[`remaining chart renderers > draws kpi 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="148" viewBox="0 0 280 148" role="img" aria-label="Revenue is 125,000, up 12.5 percent versus the previous period." class="ck-chart" data-ck-type="kpi" data-ck-renderer="kpi" data-ck-id="ck1li4iya" style="font-family:var(--ck-font-family, inherit);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Revenue is 125,000, up 12.5 percent versus the previous period.</title><desc>Revenue is 125,000, up 12.5 percent versus the previous period.</desc><rect x="0.5" y="0.5" width="279" height="147" rx="12" fill="var(--ck-surface, light-dark(#ffffff, #2c2c2e))" stroke="var(--ck-grid, light-dark(rgba(0, 0, 0, 0.09), rgba(245, 245, 247, 0.12)))" /><text x="20" y="32" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="13" font-weight="500">Revenue</text><text data-ck-mark="kpi" aria-label="125K" x="20" y="64" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="28" font-weight="700">125K</text><text x="96" y="62" fill="var(--ck-positive, light-dark(#15803d, #30d158))" font-size="14" font-weight="600">↗ +12.5%</text><path d="M 20 123.67 L 68 113 L 116 129 L 164 102.33 L 212 81 L 260 86.33 L 260 132 L 20 132 Z" fill="var(--ck-series-1, var(--chart-1, light-dark(#2f6fe4, #4a8ff0)))" fill-opacity="var(--ck-area-opacity, 0.22)" stroke="none" /><path data-ck-mark="spark" d="M 20 123.67 L 68 113 L 116 129 L 164 102.33 L 212 81 L 260 86.33" fill="none" stroke="var(--ck-line-1, light-dark(#2f6fe4, #4a8ff0))" stroke-width="var(--ck-line-width, 2)" stroke-linejoin="round" stroke-linecap="round" /><rect data-ck-mark="kpi" aria-label="125K" x="0" y="0" width="280" height="148" fill="transparent" /></svg>"`;

exports[`remaining chart renderers > draws progress-ring 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="160" viewBox="0 0 160 160" role="img" aria-label="Uptime is 99.2 percent." class="ck-chart" data-ck-type="progress-ring" data-ck-renderer="progress-ring" data-ck-id="ck11dxjra" style="font-family:var(--ck-font-family, inherit);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Uptime is 99.2 percent.</title><desc>Uptime is 99.2 percent.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><path d="M 80 12 A 68 68 0 1 1 80 148 A 68 68 0 1 1 80 12" fill="none" stroke="var(--ck-track, light-dark(rgba(0, 0, 0, 0.10), rgba(245, 245, 247, 0.16)))" stroke-width="8" stroke-linecap="round" /><path data-ck-mark="progress" aria-label="99.2%" d="M 80 12 A 68 68 0 1 1 76.58 12.09" fill="none" stroke="var(--ck-series-1, var(--chart-1, light-dark(#2f6fe4, #4a8ff0)))" stroke-width="8" stroke-linecap="round" /><text data-ck-mark="progress" aria-label="99.2%" x="80" y="78" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="28.56" font-weight="700">99.2%</text><text x="80" y="105.84" text-anchor="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11">Uptime</text></svg>"`;

