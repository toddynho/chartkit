exports[`render SVG > draws a stacked area 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="240" viewBox="0 0 640 240" role="img" aria-label="Pro accounts grew faster than free accounts from January to March." class="ck-chart" data-ck-type="stacked-area" data-ck-id="ckz4tb1v" style="font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Pro accounts grew faster than free accounts from January to March.</title><desc>Pro accounts grew faster than free accounts from January to March.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><rect x="68" y="8" width="10" height="10" rx="2" fill="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84ff)))" /><text x="84" y="17" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="12" font-family="var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif)">Free</text><rect x="120.4" y="8" width="10" height="10" rx="2" fill="var(--ck-series-2, var(--chart-2, light-dark(#34c759, #30d158)))" /><text x="136.4" y="17" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="12" font-family="var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif)">Pro</text><defs><clipPath id="ckz4tb1vyorl7m"><rect x="68" y="44" width="556" height="164" /></clipPath><linearGradient id="ckz4tb1v-g0" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84ff)))" stop-opacity="var(--ck-area-opacity, 0.22)" /><stop offset="62%" stop-color="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84ff)))" stop-opacity="calc(var(--ck-area-opacity, 0.22) * 0.35)" /><stop offset="100%" stop-color="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84ff)))" stop-opacity="0" /></linearGradient><linearGradient id="ckz4tb1v-g1" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--ck-series-2, var(--chart-2, light-dark(#34c759, #30d158)))" stop-opacity="var