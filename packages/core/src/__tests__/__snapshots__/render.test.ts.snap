exports[`remaining chart renderers > draws a grid heatmap 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="280" viewBox="0 0 640 280" role="img" aria-label="Monday at 10 is the busiest hour." class="ck-chart" data-ck-type="heatmap" data-ck-renderer="heatmap" data-ck-id="ck125619f" style="font-variant-numeric:tabular-nums"><title>Load</title><desc>Monday at 10 is the busiest hour.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><text x="16" y="20" text-anchor="start" fill="var(--ck-text, light-dark(#0f172a, #f8fafc))" font-size="14" font-weight="600" font-family="var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif)">Load</text><text x="40" y="92" text-anchor="end" fill="var(--ck-muted, light-dark(#64748b, #94a3b8))" font-size="11" font-weight="400" font-family="var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif)">Mon</text><text x="40" y="196" text-anchor="end" fill="var(--ck-muted, light-dark(#64748b, #94a3b8))" font-size="11" font-weight="400" font-family="var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif)">Tue</text><text x="192" y="268" text-anchor="middle" fill="var(--ck-muted, light-dark(#64748b, #94a3b8))" font-size="11" font-weight="400" font-family="var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif)">9</text><text x="480" y="268" text-anchor="middle" fill="var(--ck-muted, light-dark(#64748b, #94a3b8))" font-size="11" font-weight="400" font-family="var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif)">10</text><rect x="69.6" y="43.8" width="244.8" height="88.4" rx="4" fill="var(--ck-series-1, var(--chart-1, light-dark(#0f766e, #2dd4bf)))" fill-opacity="0.35" aria-label="9, Mon: 1"><title>9, Mon: 1</title></rect><rect x="69.6" y="147.8" width="244.8" height="88.4" rx="4" fill="var(--ck-series-1, var(--chart-1, light-dark(#0f766e, #2dd4bf)))" fill-opacity="0.78" aria-lab