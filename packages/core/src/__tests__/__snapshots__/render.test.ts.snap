exports[`remaining chart renderers > draws a grid heatmap 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="280" viewBox="0 0 640 280" role="img" aria-label="Monday at 10 is the busiest hour." class="ck-chart" data-ck-type="heatmap" data-ck-renderer="heatmap" data-ck-id="ck125619f" style="font-family:var(--ck-font-family, inherit);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Load</title><desc>Monday at 10 is the busiest hour.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><defs><pattern id="ck125619fe4drbtn" width="6" height="6" patternUnits="userSpaceOnUse"><rect width="6" height="6" fill="var(--ck-background, light-dark(#f5f5f7, #2c2c2e))" /><path d="M0 6 L6 0" stroke="var(--ck-axis, light-dark(rgba(0, 0, 0, 0.2), rgba(245, 245, 247, 0.24)))" stroke-width="0.8" /></pattern></defs><text x="48" y="22" text-anchor="start" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="15" font-weight="650">Load</text><text x="40" y="104" text-anchor="end" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="400">Mon</text><text x="40" y="188" text-anchor="end" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="400">Tue</text><text x="192" y="52" text-anchor="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="400">9</text><text x="480" y="52" text-anchor="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="400">10</text><rect x="69.6" y="64.3" width="244.8" height="71.4" rx="4" fill="light-dark(#87909d, #346886)" fill-opacity="1" data-ck-mark="cell" aria-label="9, Mon: 1"><title>9, Mon: 1</title></rect><rect x="69.6" y="148.3" width="244.8" height="71.4" rx="4" fill="light-dark(#2f6fe4, #38bdf8)" fill-opacity="1" data-ck-mark="cell" aria-label="9, Tue: 3"><title>9, Tue: 3</title></rect><rect x="357.6" y="64.3" width="244.8" height="71.4" rx="4" fill="light-dark(#2f6fe4, #e0f2fe)" fill-opacity="1" data-ck-mark="cell" aria-label="10, Mon: 5"><title>10, Mon: 5</title></rect><rect x="357.6" y="148.3" width="244.8" height="71.4" rx="4" fill="light-dark(#5b80c1, #3693bf)" fill-opacity="1" data-ck-mark="cell" aria-label="10, Tue: 2"><title>10, Tue: 2</title></rect><g data-ck-scale="sequential"><defs><linearGradient id="cks1lvzio8" x1="0" y1="0" x2="1" y2="0"><stop offset="0%" stop-color="light-dark(#87909d, #346886)" /><stop offset="50%" stop-color="light-dark(#2f6fe4, #38bdf8)" /><stop offset="100%" stop-color="light-dark(#2f6fe4, #e0f2fe)" /></linearGradient></defs><text x="48" y="245" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="650" data-ck-scale-title="load">load</text><rect x="48" y="250" width="148" height="8" rx="2" fill="url(#cks1lvzio8)" data-ck-scale="gradient" /><text x="48" y="274" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11">1</text><text x="196" y="274" text-anchor="end" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11">5</text></g></svg>"`;

exports[`remaining chart renderers > draws candlestick 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="320" viewBox="0 0 640 320" role="img" aria-label="The price closed higher on both January 1 and January 2." class="ck-chart" data-ck-type="candlestick" data-ck-renderer="candlestick" data-ck-id="ckmbcgi4" style="font-family:var(--ck-font-family, inherit);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>The price closed higher on both January 1 and January 2.</title><desc>The price closed higher on both January 1 and January 2.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><line x1="56" y1="228" x2="628" y2="228" stroke="var(--ck-grid, light-dark(rgba(0, 0, 0, 0.09), rgba(245, 245, 247, 0.12)))" /><line x1="56" y1="192" x2="628" y2="192" stroke="var(--ck-grid, light-dark(rgba(0, 0, 0, 0.09), rgba(245, 245, 247, 0.12)))" /><line x1="56" y1="156" x2="628" y2="156" stroke="var(--ck-grid, light-dark(rgba(0, 0, 0, 0.09), rgba(245, 245, 247, 0.12)))" /><line x1="56" y1="120" x2="628" y2="120" stroke="var(--ck-grid, light-dark(rgba(0, 0, 0, 0.09), rgba(245, 245, 247, 0.12)))" /><line x1="56" y1="84" x2="628" y2="84" stroke="var(--ck-grid, light-dark(rgba(0, 0, 0, 0.09), rgba(245, 245, 247, 0.12)))" /><line x1="56" y1="48" x2="628" y2="48" stroke="var(--ck-grid, light-dark(rgba(0, 0, 0, 0.09), rgba(245, 245, 247, 0.12)))" /><line x1="56" y1="12" x2="628" y2="12" stroke="var(--ck-grid, light-dark(rgba(0, 0, 0, 0.09), rgba(245, 245, 247, 0.12)))" /><g aria-label="2026-01-01 open 10 high 12 low 9 close 11"><title>2026-01-01 open 10 high 12 low 9 close 11</title><line x1="199" y1="84" x2="199" y2="192" stroke="var(--ck-positive, light-dark(#15803d, #30d158))" stroke-width="1" /><rect data-ck-mark="candle" x="98.9" y="120" width="200.2" height="36" fill="var(--ck-positive, light-dark(#15803d, #30d158))" /><rect data-ck-mark="volume" x="98.9" y="236" width="200.2" height="56" fill="var(--ck-positive, l