exports[`remaining chart renderers > draws gauge 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="180" viewBox="0 0 240 180" role="img" aria-label="Capacity is 72 out of 100, below the target of 80." class="ck-chart" data-ck-type="gauge" data-ck-renderer="gauge" data-ck-id="ckzqbxxc" style="font-family:var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Capacity is 72 out of 100, below the target of 80.</title><desc>Capacity is 72 out of 100, below the target of 80.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><path data-ck-mark="gauge-track" data-ck-target="80" d="M 77.33 147.09 A 60.35 60.35 0 1 1 162.67 147.09" fill="none" stroke="var(--ck-track, light-dark(rgba(0, 0, 0, 0.10), rgba(245, 245, 247, 0.16)))" stroke-width="18.12" stroke-linecap="butt" /><path data-ck-mark="gauge-band" d="M 87.59 136.82 A 45.84 45.84 0 0 1 120 58.57" fill="none" stroke="var(--ck-negative, light-dark(#be123c, #ff453a))" stroke-width="2.9" stroke-linecap="butt" stroke-opacity="0.55" aria-label="Low 0–50"><title>Low 0–50</title></path><path data-ck-mark="gauge-band" d="M 120 58.57 A 45.84 45.84 0 0 1 152.41 136.82" fill="none" stroke="var(--ck-positive, light-dark(#15803d, #30d158))" stroke-width="2.9" stroke-linecap="butt" stroke-opacity="0.55" aria-label="OK 50–100"><title>OK 50–100</title></path><path data-ck-mark="gauge-value" d="M 77.33 147.09 A 60.35 60.35 0 1 1 171.95 73.69" fill="none" stroke="var(--ck-positive, light-dark(#15803d, #30d158))" stroke-width="18.12" stroke-linecap="butt" /><line data-ck-mark="gauge-tick" x1="69.5" y1="154.91" x2="64.55" y2="159.86" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" /><text data-ck-mark="gauge-tick-label" x="56.07" y="168.34" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500