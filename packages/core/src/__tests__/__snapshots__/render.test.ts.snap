exports[`remaining chart renderers > draws donut 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="280" viewBox="0 0 420 280" role="img" aria-label="Search is the largest traffic source at 42 percent of sessions." class="ck-chart" data-ck-type="donut" data-ck-renderer="donut" data-ck-id="ckgy2ngg" style="font-family:var(--ck-font-family, inherit);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Search is the largest traffic source at 42 percent of sessions.</title><desc>Search is the largest traffic source at 42 percent of sessions.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><path d="M 140.13 16.02 A 122 122 0 0 1 201.13 242.4 L 175.88 200.64 A 73.2 73.2 0 0 0 139.28 64.81 Z" fill="var(--ck-series-1, var(--chart-1, light-dark(#2f6fe4, #4a8ff0)))" fill-rule="evenodd" data-ck-mark="slice" data-ck-name="Search" data-ck-i="0" data-ck-key="s:Search" data-ck-value="42" aria-label="Search: 42 (42%)"><title>Search: 42 (42%)</title></path><path d="M 197.44 244.54 A 122 122 0 0 1 23.8 180.92 L 69.48 163.75 A 73.2 73.2 0 0 0 173.67 201.92 Z" fill="var(--ck-series-2, var(--chart-2, light-dark(#e2622a, #e06a35)))" fill-rule="evenodd" data-ck-mark="slice" data-ck-name="Direct" data-ck-i="1" data-ck-key="s:Direct" data-ck-value="28" aria-label="Direct: 28 (28%)"><title>Direct: 28 (28%)</title></path><path d="M 22.37 176.91 A 122 122 0 0 1 51.37 52.1 L 86.02 86.46 A 73.2 73.2 0 0 0 68.62 161.35 Z" fill="var(--ck-series-3, var(--chart-3, light-dark(#0f9d83, #1aa37e)))" fill-rule="evenodd" data-ck-mark="slice" data-ck-name="Social" data-ck-i="2" data-ck-key="s:Social" data-ck-value="18" aria-label="Social: 18 (18%)"><title>Social: 18 (18%)</title></path><path d="M 54.42 49.12 A 122 122 0 0 1 135.87 16.02 L 136.72 64.81 A 73.2 73.2 0 0 0 87.85 84.67 Z" fill="var(--ck-series-4, var(--chart-4, light-dark(#b7791f, #c08318)))" fill-rule="evenodd" data-ck-mark="slice" data-ck-name="Email" data-ck-i="3" data-ck-