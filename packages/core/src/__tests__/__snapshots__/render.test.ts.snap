exports[`render SVG > draws a bar chart 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="240" viewBox="0 0 640 240" role="img" aria-label="Signups peaked in February at 180, after 100 in January." class="ck-chart" data-ck-type="bar" data-ck-id="ck17ux6xf"><title>Signups by month</title><desc>Signups peaked in February at 180, after 100 in January.</desc><rect width="100%" height="100%" fill="var(--ck-background, #0c0c0c)" /><text x="52" y="20" fill="var(--ck-text, #ffffff)" font-size="14" font-weight="600" font-family="var(--ck-font-family, ui-sans-serif)">Signups by month</text><defs><clipPath id="ck17ux6xf-clip"><rect x="52" y="34" width="572" height="174" /></clipPath><linearGradient id="ck17ux6xf-g0" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--ck-series-1, #22c55e)" stop-opacity="0.28" /><stop offset="100%" stop-color="var(--ck-series-1, #22c55e)" stop-opacity="0" /></linearGradient></defs><line x1="52" y1="208" x2="624" y2="208" stroke="var(--ck-grid, #1f1f1f)" stroke-dasharray="3 3" /><line x1="52" y1="164.5" x2="624" y2="164.5" stroke="var(--ck-grid, #1f1f1f)" stroke-dasharray="3 3" /><line x1="52" y1="121" x2="624" y2="121" stroke="var(--ck-grid, #1f1f1f)" stroke-dasharray="3 3" /><line x1="52" y1="77.5" x2="624" y2="77.5" stroke="var(--ck-grid, #1f1f1f)" stroke-dasharray="3 3" /><line x1="52" y1="34" x2="624" y2="34" stroke="var(--ck-grid, #1f1f1f)" stroke-dasharray="3 3" /><g clip-path="url(#ck17ux6xf-clip)"><rect x="80.6" y="121" width="132.47" height="87" rx="3" fill="var(--ck-series-1, #22c55e)" /><rect x="271.27" y="51.4" width="132.47" height="156.6" rx="3" fill="var(--ck-series-1, #22c55e)" /><rect x="461.93" y="77.5" width="132.47" height="130.5" rx="3" fill="var(--ck-series-1, #22c55e)" /></g><text x="46" y="212" text-anchor="end" fill="var(--ck-muted, #8a8a8a)" font-size="11" font-family="var(--ck-font-family, ui-sans-serif)">0</text><text x="46" y="168.5" text-anchor="end" fill="var(--ck-muted, #8a8a8a)" fo