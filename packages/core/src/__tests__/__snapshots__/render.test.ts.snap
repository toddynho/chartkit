exports[`render SVG > draws an area chart 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="640" height="240" viewBox="0 0 640 240" role="img" aria-label="Revenue dipped in March after February, then reached 70 in April." class="ck-chart" data-ck-type="line" data-ck-id="ckt1os5i" style="font-family:var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Revenue</title><desc>Revenue dipped in March after February, then reached 70 in April.</desc><rect width="100%" height="100%" fill="var(--ck-background, #0c0c0c)" /><text x="52" y="22" fill="var(--ck-text, #ffffff)" font-size="15" font-weight="650">Revenue</text><defs><clipPath id="ckt1os5i11rbpgr"><rect x="52" y="34" width="572" height="174" /></clipPath><linearGradient id="ckt1os5i-g0" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--ck-series-1, var(--chart-1, #22c55e))" stop-opacity="var(--ck-area-opacity, 0.28)" /><stop offset="62%" stop-color="var(--ck-series-1, var(--chart-1, #22c55e))" stop-opacity="calc(var(--ck-area-opacity, 0.28) * 0.35)" /><stop offset="100%" stop-color="var(--ck-series-1, var(--chart-1, #22c55e))" stop-opacity="0" /></linearGradient></defs><line x1="52" y1="208" x2="624" y2="208" stroke="var(--ck-grid, #1f1f1f)" /><line x1="52" y1="164.5" x2="624" y2="164.5" stroke="var(--ck-grid, #1f1f1f)" /><line x1="52" y1="121" x2="624" y2="121" stroke="var(--ck-grid, #1f1f1f)" /><line x1="52" y1="77.5" x2="624" y2="77.5" stroke="var(--ck-grid, #1f1f1f)" /><line x1="52" y1="34" x2="624" y2="34" stroke="var(--ck-grid, #1f1f1f)" /><g clip-path="url(#ckt1os5i11rbpgr)"><path d="M 123.5 142.75 C 171.17 128.25, 218.83 99.25, 266.5 99.25 C 314.17 99.25, 361.83 121, 409.5 121 C 457.17 121, 504.83 77.5, 552.5 55.75 L 552.5 208 L 123.5 208 Z" fill="url(#ckt1os5i-g0)" fill-opacity="1" stroke="none" /><path d="M 123.5 142.75 C 171.17 128.25, 218.83 99.25, 266.5 99.25 C 314.17 99.25, 361.83 121, 409.5 121 C 457.17 121, 504.83 77.5, 552.5 55.75" fill="none" stroke="var(--ck-line-1, #22c55e)" stroke-linejoin="round" stroke-linecap="round" stroke-width="var(--ck-line-width, 2)" /></g><text x="46" y="212" text-anchor="end" fill="var(--ck-muted, #8a8a8a)" font-size="11">0</text><text x="46" y="168.5" text-anchor="end" fill="var(--ck-muted, #8a8a8a)" font-size="11">20</text><text x="46" y="125" text-anchor="end" fill="var(--ck-muted, #8a8a8a)" font-size="11">40</text><text x="46" y="81.5" text-anchor="end" fill="var(--ck-muted, #8a8a8a)" font-size="11">60</text><text x="46" y="38" text-anchor="end" fill="var(--ck-muted, #8a8a8a)" font-size="11">80</text><text x="123.5" y="224" text-anchor="middle" fill="var(--ck-muted, #8a8a8a)" font-size="11">Jan</text><text x="266.5" y="224" text-anchor="middle" fill="var(--ck-muted, #8a8a8a)" font-size="11">Feb</text><text x="409.5" y="224" text-anchor="middle" fill="var(--ck-muted, #8a8a8a)" font-size="11">Mar</text><text x="552.5" y="224" text-anchor="middle" fill="var(--ck-muted, #8a8a8a)" font-size="11">Apr</text></svg>"`;
