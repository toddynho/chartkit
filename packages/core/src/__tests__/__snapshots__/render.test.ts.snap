exports[`render SVG > draws an area chart 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="640" height="240" viewBox="0 0 640 240" role="img" aria-label="Revenue dipped in March after February, then reached 70 in April." class="ck-chart" data-ck-type="line" data-ck-id="ckt1os5i" style="font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Revenue</title><desc>Revenue dipped in March after February, then reached 70 in April.</desc><rect width="100%" height="100%" fill="var(--ck-background, #0c0c0c)" /><text x="52" y="22" fill="var(--ck-text, #ffffff)" font-size="15" font-weight="650" font-family="var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif)">Revenue</text><defs><clipPath id="ckt1os5i11rbpgr"><rect x="52" y="34" width="572" height="174" /></clipPath><linearGradient id="ckt1os5i-g0" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="var(--ck-series-1, var(--chart-1, #22c55e))" stop-opacity="var(--ck-area-opacity, 0.28)" /><stop offset="62%" stop-color="var(--ck-series-1, var(--chart-1, #22c55e))" stop-opacity="calc(var(--ck-area-opacity, 0.28) * 0.35)" /><stop offset="100%" stop-color="var(--ck-series-1, var(--chart-1, #22c55e))" stop-opacity="0" /></linearGradient></defs><line x1="52" y1="208" x2="624" y2="208" stroke="var(--ck-grid, #1f1f1f)" /><line x1="52" y1="164.5" x2="624" y2="164.5" stroke="var(--ck-grid, #1f1f1f)" /><line x1="52" y1="121" x2="624" y2="121" stroke="var(--ck-grid, #1f1f1f)" /><line x1="52" y1="77.5" x2="624" y2="77.5" stroke="var(--ck-grid, #1f1f1f)" /><line x1="52" y1="34" x2="624" y2="34" stroke="var(--ck-grid, #1f1f1f)" /><g clip-path="url(#ckt1os5i11rbpgr)"><path d="M 123.5 142.75 C 171.17 128.25, 218.83 99.25, 266.5 99.25 C 314.17 99.25, 361.83 121, 409.5 121 C 457.17 121, 504.83 77.5, 552.5 55.75 L 552.5 208 C 504.83 208, 457.17 208, 409.5 208 C 361.83 208, 314.17 208, 266.5 208 C 218.83 208, 171.17 208, 123.5 208 Z" fill="url(#ckt1os5i-g0)" fill-opacity="1" stroke="none" /><