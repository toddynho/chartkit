exports[`reference examples, light and dark > 28-journey.json auto 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="632" viewBox="0 0 760 632" role="img" aria-label="Checkout is smooth until payment. Creating an account scores 2, and a declined card scores 1 before confirmation recovers." class="ck-chart" data-ck-type="journey" data-ck-renderer="journey" data-ck-id="ck1ej2vsg" style="font-family:var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Checkout</title><desc>Checkout is smooth until payment. Creating an account scores 2, and a declined card scores 1 before confirmation recovers.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><text x="16" y="22" text-anchor="start" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="15" font-weight="650">Checkout</text><g  data-ck-mark="actor" aria-label="Support"><title>Support</title><rect x="656" y="40" width="76" height="18" rx="9" fill="var(--ck-series-3, var(--chart-3, light-dark(#ff9500, #ff9f0a)))" fill-opacity="0.16" stroke="var(--ck-series-3, var(--chart-3, light-dark(#ff9500, #ff9f0a)))" /><circle cx="666" cy="49" r="3" fill="var(--ck-series-3, var(--chart-3, light-dark(#ff9500, #ff9f0a)))" /><text x="674" y="53" text-anchor="start" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="11" font-weight="500">Support</text></g><g  data-ck-mark="actor" aria-label="Payments"><title>Payments</title><rect x="565" y="40" width="83" height="18" rx="9" fill="var(--ck-series-2, var(--chart-2, light-dark(#34c759, #30d158)))" fill-opacity="0.16" stroke="var(--ck-series-2, var(--chart-2, light-dark(#34c759, #30d158)))" /><circle cx="575" cy="49" r="3" fill="var(--ck-series-2, var(--chart-2, light-dark(#34c759, #30d158)))" /><text x="583" y="53" text-anchor="start" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="11" font-weight="500">Payment