exports[`reference examples, light and dark > 25-timeline.json auto 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="264" viewBox="0 0 760 264" role="img" aria-label="Northstar was founded in 2014, raised a Series A and a Series B, and opened the platform era in 2024." class="ck-chart" data-ck-type="timeline" data-ck-renderer="timeline" data-ck-id="ckpktvqs" style="font-family:var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Northstar, 2014 to 2026</title><desc>Northstar was founded in 2014, raised a Series A and a Series B, and opened the platform era in 2024.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><text x="16" y="22" text-anchor="start" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="15" font-weight="650">Northstar, 2014 to 2026</text><rect x="156.63" y="48" width="183.1" height="26" rx="8" fill="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84ff)))" fill-opacity="0.16" stroke="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84ff)))" data-ck-mark="period" aria-label="Series A: Mar 1–Aug 1"><title>Series A: Mar 1–Aug 1</title></rect><text x="248.18" y="65" text-anchor="middle" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="12" font-weight="600">Series A</text><rect x="344.28" y="48" width="174.15" height="26" rx="8" fill="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84ff)))" fill-opacity="0.16" stroke="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84ff)))" data-ck-mark="period" aria-label="Remote years: Sep 1–Dec 1"><title>Remote years: Sep 1–Dec 1</title></rect><text x="431.35" y="65" text-anchor="middle" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="12" font-weight="600">Remote years</text><rect x="578.58" y="48" width="127.35" height="26" rx="8" fill="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84f