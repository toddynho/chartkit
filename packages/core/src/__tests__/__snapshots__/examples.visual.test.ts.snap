exports[`reference examples, light and dark > 24-gantt.json auto 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="412" viewBox="0 0 760 412" role="img" aria-label="The Northstar launch is in build. The web app is critical, beta is 6 April, and general availability is 17 April." class="ck-chart" data-ck-type="gantt" data-ck-renderer="gantt" data-ck-id="ck1dbktzx" style="font-family:var(--ck-font-family, inherit);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Northstar launch</title><desc>The Northstar launch is in build. The web app is critical, beta is 6 April, and general availability is 17 April.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><text x="16" y="22" text-anchor="start" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="15" font-weight="650">Northstar launch</text><rect x="567.2" y="12" width="8" height="8" rx="2" fill="var(--ck-positive, light-dark(#15803d, #30d158))" /><text x="579.2" y="20" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">Done</text><rect x="615.6" y="12" width="8" height="8" rx="2" fill="var(--ck-accent, light-dark(#007aff, #0a84ff))" /><text x="627.6" y="20" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">Active</text><rect x="677.2" y="12" width="8" height="8" rx="2" fill="var(--ck-negative, light-dark(#be123c, #ff453a))" /><text x="689.2" y="20" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">Critical</text><text x="16" y="66" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="650">Plan</text><rect x="256" y="56" width="484" height="110" rx="8" fill="var(--ck-track, light-dark(rgba(0, 0, 0, 0.10), rgba(245, 245, 247, 0.16)))" fill-opacity="0.45" /><text x="16" y="182" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="650">Build</text><rect x="256" y="172" width="484" height="110" rx="8" fill="var(--ck-track, light-dark(rgba(0, 0, 0, 0.10), rgba(245, 245, 247, 0.16)))" fill-opacity="0.45" /><text x="16" y="298" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="650">Launch</text><rect x="256" y="288" width="484" height="78" rx="8" fill="var(--ck-track, light-dark(rgba(0, 0, 0, 0.10), rgba(245, 245, 247, 0.16)))" fill-opacity="0.45" /><path d="M 374.51 88 H 386.51 V 104 H 325.59 V 120 H 337.59" fill="none" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round" data-ck-mark="dependency" aria-label="Write the spec → Design the UI"><title>Write the spec → Design the UI</title></path><path d="M 374.51 88 H 388.35 V 152 H 402.2" fill="none" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round" data-ck-mark="dependency" aria-label="Write the spec → Review the copy"><title>Write the spec → Review the copy</title></path><path d="M 374.51 88 H 388.35 V 204 H 402.2" fill="none" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round" data-ck-mark="dependency" aria-label="Write the spec → Build the API"><title>Write the spec → Build the API</title></path><path d="M 439.12 120 H 452.96 V 236 H 466.8" fill="none" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round" data-ck-mark="dependency" aria-label="Design the UI → Build the web app"><title>Design the UI → Build the web app</title></path><path d="M 568.33 204 H 580.33 V 236 H 519.41 V 268 H 531.41" fill="none" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round" data-ck-mark="dependency" aria-label="Build the API