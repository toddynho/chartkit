exports[`reference examples, light and dark > 04-donut.json auto 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="280" viewBox="0 0 420 280" role="img" aria-label="Search is the largest traffic source at 42 percent of sessions." class="ck-chart" data-ck-type="donut" data-ck-renderer="donut" data-ck-id="ckgy2ngg" style="font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Search is the largest traffic source at 42 percent of sessions.</title><desc>Search is the largest traffic source at 42 percent of sessions.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><path d="M 211.36 20.01 A 78 78 0 0 1 250.36 164.75 L 234.22 138.05 A 46.8 46.8 0 0 0 210.82 51.21 Z" fill="var(--ck-series-1, var(--chart-1, light-dark(#007aff, #0a84ff)))" fill-rule="evenodd" aria-label="Search: 42 (42%)"><title>Search: 42 (42%)</title></path><path d="M 248.01 166.11 A 78 78 0 0 1 136.99 125.44 L 166.19 114.47 A 46.8 46.8 0 0 0 232.8 138.87 Z" fill="var(--ck-series-2, var(--chart-2, light-dark(#34c759, #30d158)))" fill-rule="evenodd" aria-label="Direct: 28 (28%)"><title>Direct: 28 (28%)</title></path><path d="M 136.07 122.88 A 78 78 0 0 1 154.62 43.08 L 176.77 65.05 A 46.8 46.8 0 0 0 165.64 112.93 Z" fill="var(--ck-series-3, var(--chart-3, light-dark(#ff9500, #ff9f0a)))" fill-rule="evenodd" aria-label="Social: 18 (18%)"><title>Social: 18 (18%)</title></path><path d="M 156.57 41.18 A 78 78 0 0 1 208.64 20.01 L 209.18 51.21 A 46.8 46.8 0 0 0 177.94 63.91 Z" fill="var(--ck-series-4, var(--chart-4, light-dark(#af52de, #bf5af2)))" fill-rule="evenodd" aria-label="Email: 12 (12%)"><title>Email: 12 (12%)</title></path><text x="210" y="99" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="20" font-weight="700" font-family="var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif)" aria-label="Total 100">100</text><rect x="8" y="192" width="10" height="