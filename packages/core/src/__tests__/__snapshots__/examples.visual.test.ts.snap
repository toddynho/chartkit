exports[`reference examples, light and dark > 26-quadrant.json auto 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="520" viewBox="0 0 680 520" role="img" aria-label="SSO is a quick win. The checkout rewrite is a big bet. PDF export is high effort and low impact." class="ck-chart" data-ck-type="quadrant" data-ck-renderer="quadrant" data-ck-id="ck1mz56sy" style="font-family:var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Where the quarter goes</title><desc>SSO is a quick win. The checkout rewrite is a big bet. PDF export is high effort and low impact.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><text x="16" y="22" text-anchor="start" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="15" font-weight="650">Where the quarter goes</text><text x="16" y="40" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="12" font-weight="400">Effort against impact</text><rect x="116" y="72" width="268" height="200" fill="var(--ck-positive, light-dark(#15803d, #30d158))" fill-opacity="0.14" data-ck-mark="quadrant" aria-label="Quick wins"><title>Quick wins</title></rect><rect x="384" y="72" width="268" height="200" fill="var(--ck-accent, light-dark(#007aff, #0a84ff))" fill-opacity="0.14" data-ck-mark="quadrant" aria-label="Big bets"><title>Big bets</title></rect><rect x="116" y="272" width="268" height="200" fill="var(--ck-track, light-dark(rgba(0, 0, 0, 0.10), rgba(245, 245, 247, 0.16)))" fill-opacity="0.14" data-ck-mark="quadrant" aria-label="Fill-ins"><title>Fill-ins</title></rect><rect x="384" y="272" width="268" height="200" fill="var(--ck-negative, light-dark(#be123c, #ff453a))" fill-opacity="0.14" data-ck-mark="quadrant" aria-label="Thankless"><title>Thankless</title></rect><text x="130" y="94" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="