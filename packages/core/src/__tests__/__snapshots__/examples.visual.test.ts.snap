exports[`reference examples, light and dark > 24-gantt.json auto 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="412" viewBox="0 0 760 412" role="img" aria-label="The Northstar launch is in build. The web app is critical, beta is 6 April, and general availability is 17 April." class="ck-chart" data-ck-type="gantt" data-ck-renderer="gantt" data-ck-id="ck1dbktzx" style="font-family:var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif);font-variant-numeric:tabular-nums;font-feature-settings:'tnum'"><title>Northstar launch</title><desc>The Northstar launch is in build. The web app is critical, beta is 6 April, and general availability is 17 April.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><text x="16" y="22" text-anchor="start" fill="var(--ck-text, light-dark(#1d1d1f, #f5f5f7))" font-size="15" font-weight="650">Northstar launch</text><rect x="510" y="16" width="8" height="8" rx="2" fill="var(--ck-positive, light-dark(#15803d, #30d158))" /><text x="522" y="24" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">Done</text><rect x="588" y="16" width="8" height="8" rx="2" fill="var(--ck-accent, light-dark(#007aff, #0a84ff))" /><text x="600" y="24" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">Active</text><rect x="666" y="16" width="8" height="8" rx="2" fill="var(--ck-negative, light-dark(#be123c, #ff453a))" /><text x="678" y="24" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">Critical</text><text x="16" y="66" text-anchor="start" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="650">Plan</text><rect x="256" y="56" width="484" height="110" rx="8" fill="var(--ck-track, light-dark(rgba(0, 0, 0, 0.10), rgba(245, 245, 247, 0.16)))" fill-opacity="0.45" /><text x="16" y="182" text-anchor="sta