ge-tick" x1="54.02" y1="77.08" x2="47.56" y2="74.41" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" /><text data-ck-mark="gauge-tick-label" x="36.47" y="69.81" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">25</text><line data-ck-mark="gauge-tick" x1="120" y1="33" x2="120" y2="26" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" /><text data-ck-mark="gauge-tick-label" x="120" y="14" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">50</text><line data-ck-mark="gauge-tick" x1="185.98" y1="77.08" x2="192.44" y2="74.41" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" /><text data-ck-mark="gauge-tick-label" x="203.53" y="69.81" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">75</text><line data-ck-mark="gauge-tick" x1="170.5" y1="154.91" x2="175.45" y2="159.86" stroke="var(--ck-muted, light-dark(#6e6e73, #98989d))" stroke-width="1.25" /><text data-ck-mark="gauge-tick-label" x="183.93" y="168.34" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-muted, light-dark(#6e6e73, #98989d))" font-size="11" font-weight="500">100</text><line data-ck-mark="gauge-needle" x1="120" y1="104.41" x2="164.15" y2="78.3" stroke="var(--ck-positive, light-dark(#15803d, #30d158))" stroke-width="2.17" stroke-linecap="round" /><circle data-ck-mark="gauge-hub" cx="120" cy="104.41" r="4.5" fill="var(--ck-surface, light-dark(#ffffff, #2c2c2e))" stroke="var(--ck-positive, light-dark(#15803d, #30d158))" stroke-width="2" /><text data-ck-mark="gauge-readout" x="120" y="133.41" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-positive, light-dark(#15803d, #30d158))" font-size="29" font-weight="650">72</text><text data-ck-mark="gauge-caption" x="1