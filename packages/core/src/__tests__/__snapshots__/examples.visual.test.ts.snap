exports[`reference examples, light and dark > 09-gauge.json auto 1`] = `"<svg xmlns="http://www.w3.org/2000/svg" width="100%" height="180" viewBox="0 0 240 180" role="img" aria-label="Capacity is 72 out of 100, below the target of 80." class="ck-chart" data-ck-type="gauge" data-ck-renderer="gauge" data-ck-id="ckzqbxxc" style="font-variant-numeric:tabular-nums"><title>Capacity is 72 out of 100, below the target of 80.</title><desc>Capacity is 72 out of 100, below the target of 80.</desc><rect width="100%" height="100%" fill="var(--ck-background, transparent)" /><path d="M 74.18 150.22 A 64.8 64.8 0 1 1 165.82 150.22" fill="none" stroke="var(--ck-grid, light-dark(rgb(15 23 42 / 0.08), rgb(248 250 252 / 0.12)))" stroke-width="14" stroke-linecap="round" /><path d="M 74.18 150.22 A 64.8 64.8 0 0 1 120 39.6" fill="none" stroke="var(--ck-negative, light-dark(#be123c, #fb7185))" stroke-width="14" stroke-linecap="butt" stroke-opacity="0.35" aria-label="Low 0–50"><title>Low 0–50</title></path><path d="M 120 39.6 A 64.8 64.8 0 0 1 165.82 150.22" fill="none" stroke="var(--ck-positive, light-dark(#047857, #34d399))" stroke-width="14" stroke-linecap="butt" stroke-opacity="0.35" aria-label="OK 50–100"><title>OK 50–100</title></path><path d="M 74.18 150.22 A 64.8 64.8 0 1 1 175.78 71.41" fill="none" stroke="var(--ck-positive, light-dark(#047857, #34d399))" stroke-width="14" stroke-linecap="round" /><line x1="81.96" y1="142.44" x2="67.82" y2="156.58" stroke="var(--ck-muted, light-dark(#64748b, #94a3b8))" stroke-width="1.5" /><text x="59.33" y="168.07" text-anchor="middle" dominant-baseline="middle" fill="var(--ck-muted, light-dark(#64748b, #94a3b8))" font-size="10" font-weight="400" font-family="var(--ck-font-family, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif)">0</text><line x1="70.3" y1="83.81" x2="51.82" y2="76.16" stroke="var(--ck-muted, light-dark(#64748b, #94a3b8))" stroke-width="1.5" /><text x="40.73" y="74.57" text-anchor="middle" dominant-baseline="middle" fill