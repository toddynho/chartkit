{
  "name": "@chartkitdev/core",
  "version": "0.5.0",
  "description": "JSON-spec SVG charts, zero dependencies. Line chart 14,858 B gzip, 0.85 ms server render. validate() and repair() for agents (no-docs 20/42, then 42/42). Update wins 6 of 12 vs uPlot. Losses included: https://chartkit.dev/benchmarks",
  "author": "Todd Garland",
  "homepage": "https://chartkit.dev",
  "bugs": {
    "url": "https://github.com/toddynho/chartkit/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/all.js",
    "./dist/all.cjs",
    "./dist/themes/*.js",
    "./dist/themes/*.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./all": {
      "import": {
        "types": "./dist/all.d.ts",
        "default": "./dist/all.js"
      },
      "require": {
        "types": "./dist/all.d.cts",
        "default": "./dist/all.cjs"
      }
    },
    "./validate": {
      "import": {
        "types": "./dist/validate.d.ts",
        "default": "./dist/validate.js"
      },
      "require": {
        "types": "./dist/validate.d.cts",
        "default": "./dist/validate.cjs"
      }
    },
    "./interact": {
      "import": {
        "types": "./dist/interact.d.ts",
        "default": "./dist/interact.js"
      },
      "require": {
        "types": "./dist/interact.d.cts",
        "default": "./dist/interact.cjs"
      }
    },
    "./charts/*": {
      "import": {
        "types": "./dist/charts/*.d.ts",
        "default": "./dist/charts/*.js"
      },
      "require": {
        "types": "./dist/charts/*.d.cts",
        "default": "./dist/charts/*.cjs"
      }
    },
    "./themes/*": {
      "import": {
        "types": "./dist/themes/*.d.ts",
        "default": "./dist/themes/*.js"
      },
      "require": {
        "types": "./dist/themes/*.d.cts",
        "default": "./dist/themes/*.cjs"
      }
    },
    "./schema.json": "./schema/chartkit.schema.json"
  },
  "files": [
    "dist",
    "schema/chartkit.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate:types": "node scripts/generate-types.mjs",
    "strip:schema": "node scripts/strip-schema.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "chartkit",
    "charts",
    "chart",
    "svg",
    "json",
    "json-schema",
    "validation",
    "visualization",
    "react",
    "vue",
    "svelte",
    "ssr",
    "benchmark",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/toddynho/chartkit",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
