    "@mui/system": "9.5.0",
    "@mui/x-charts": "9.15.0",
    "@nivo/bar": "0.99.0",
    "@nivo/boxplot": "0.99.0",
    "@nivo/bullet": "0.99.0",
    "@nivo/funnel": "0.99.0",
    "@nivo/heatmap": "0.99.0",
    "@nivo/line": "0.99.0",
    "@nivo/pie": "0.99.0",
    "@nivo/radar": "0.99.0",
    "@nivo/radial-bar": "0.99.0",
